{
  "name": "kiosk-finder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "update-data": "node scripts/build-data.ts",
    "mock-data": "node scripts/mock-data.ts",
    "fetch-parking": "node --env-file-if-exists=.env scripts/fetch-parking.ts",
    "fetch-rent": "node --env-file-if-exists=.env scripts/fetch-rent.ts",
    "mock-rent": "node scripts/mock-rent.ts",
    "check-data": "node scripts/check-data.ts",
    "test": "node --test scripts/test/*.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.23",
    "@types/leaflet.markercluster": "1.5.6"
  }
}
