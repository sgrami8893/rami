# Cloudflare Pages 보안 헤더 (정적 사이트 전체)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # 다른 사이트가 우리 파일(글꼴·스크립트 등)을 직접 끌어다 쓰는 것(핫링크)을 브라우저 단에서 막는다
  Cross-Origin-Resource-Policy: same-origin
  # CSP 1차: 애드센스·구글 스크립트를 막지 않도록 script-src/connect-src 는 잠그지 않고, 안전한 지시어만 건다.
  # 애드센스 승인 후 광고가 안정되면 nonce 기반 strict CSP 를 Report-Only 로 먼저 시험한다.
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

# 빌드 산출물(파일명에 해시)은 오래 캐시
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 정식 도메인 연결 후 *.pages.dev 사본이 검색에 중복 노출되지 않게 막는다(정식 도메인에는 적용되지 않음)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# 공유 미리보기 이미지·아이콘: 메신저 앱이 다른 출처에서 직접 불러올 수 있게 허용(same-origin이면 미리보기가 빈 칸일 수 있음)
/og*.png
  ! Cross-Origin-Resource-Policy
  ! X-Robots-Tag
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
/og/*
  ! Cross-Origin-Resource-Policy
  ! X-Robots-Tag
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
/favicon.svg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
