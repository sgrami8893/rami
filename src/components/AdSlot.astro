---
// 광고 자리. 애드센스 client·slot id가 설정되기 전에는 아무것도 렌더하지 않는다(빈 자리·점선 박스 없음).
// 설정 후에는 최소 높이를 확보해 레이아웃 이동(CLS)을 막는다. 필터·길찾기 버튼 바로 옆에는 두지 않는다.
// variant: 'infeed' 목록 카드 사이, 'side' PC 사이드바 세로형(300×600 이하, 스티키), 기본은 본문 반응형.
import { ADSENSE } from '../config.ts';
interface Props { name: 'A' | 'B' | 'C' | 'side'; variant?: 'default' | 'infeed' | 'side'; class?: string }
const { name: slot, variant = 'default', class: cls = '' } = Astro.props;
const id = ADSENSE.slots[slot];
const show = Boolean(ADSENSE.client && id);
const box = variant === 'side' ? 'w-[300px] min-h-[600px] max-h-[600px] overflow-hidden' : variant === 'infeed' ? 'min-h-[140px] rounded-[20px] bg-card p-3' : 'my-6 min-h-[280px] sm:min-h-[250px]';
---
{show && (
  <aside class={`${box} ${cls}`} aria-label="광고" data-ad-slot-name={slot}>
    <p class="mb-1 text-[11px] text-ink-3">광고</p>
    <ins class="adsbygoogle block" data-ad-client={ADSENSE.client} data-ad-slot={id}
      {...(variant === 'infeed' ? { 'data-ad-format': 'fluid', 'data-ad-layout-key': '' } : variant === 'side' ? { style: 'display:inline-block;width:300px;height:600px' } : { 'data-ad-format': 'auto', 'data-full-width-responsive': 'true' })}></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
