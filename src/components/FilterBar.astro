---
import Icon from './Icon.astro';
// Markup only; behaviour lives in src/scripts/filters.ts. Without JS the full list stays visible.
interface Props { dongs: string[]; subGu: string[] }
const { dongs, subGu } = Astro.props;
const chips = [
  ['open', '지금 운영시간 내'], ['24h', '24시간'], ['weekend', '주말·공휴일'], ['registry', '등기부등본'], ['family', '가족관계증명서'],
];
const sel = 'h-9 min-w-0 rounded-xl bg-bg px-3 text-[14px] text-ink-2';
---
<!-- 결과 내 검색: 기기명·상세위치·주소·동·일반구, 띄어쓰기 무시, 칩·구·동 필터와 AND -->
  <div class="mt-4 flex h-11 items-center gap-2 rounded-xl bg-bg px-3.5 focus-within:ring-2 focus-within:ring-inset focus-within:ring-brand">
    <Icon name="search" size={18} class="text-ink-3" />
    <label for="f-q" class="sr-only">이 지역 결과 안에서 검색</label>
    <input id="f-q" type="search" maxlength="40" autocomplete="off" placeholder="기기명·동·건물 이름으로 찾기" class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none focus-visible:outline-none placeholder:text-ink-3 [&::-webkit-search-cancel-button]:hidden" />
    <button type="button" id="f-q-clear" class="-mr-1.5 flex h-8 w-8 items-center justify-center rounded-lg text-ink-3 hover:text-ink" aria-label="검색어 지우기" hidden><Icon name="x" size={18} /></button>
  </div>
<div id="filters" class="sticky top-14 z-20 -mx-5 bg-card/95 px-5 pb-2 pt-2.5 backdrop-blur lg:mx-0 lg:px-0">
  <div class="scrollbar-none -mx-5 flex gap-2 overflow-x-auto px-5 lg:mx-0 lg:px-0" role="group" aria-label="조건 필터">
    {chips.map(([key, label]) => (
      <button type="button" data-chip={key} aria-pressed="false"
        class="chip flex h-9 shrink-0 items-center whitespace-nowrap rounded-xl bg-bg px-3 text-[14px] font-medium text-ink-2 aria-pressed:bg-ink aria-pressed:text-white">
        {key === 'open' && <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-ok"></span>}{label}
      </button>
    ))}
  </div>
  <!-- 구·동 선택과 결과 수(현재 시각 기준)를 한 줄에: 좁으면 결과 수만 다음 줄로 내려간다 -->
  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
  {(subGu.length > 0 || dongs.length > 1) && (
    <div class="flex items-center gap-2">
      {subGu.length > 0 && (
        <select id="f-subgu" class={sel} aria-label="구 선택">
          <option value="">구 전체</option>
          {subGu.map((g) => <option value={g}>{g}</option>)}
        </select>
      )}
      {dongs.length > 1 && (
        <select id="f-dong" class={sel} aria-label="동 선택">
          <option value="">동 전체</option>
          {dongs.map((d) => <option value={d}>{d}</option>)}
        </select>
      )}
    </div>
  )}
  <p id="f-count" class="text-cap text-ink-3" aria-live="polite"></p>
  </div>
  <p id="f-note" class="mt-1 text-cap text-ink-3" hidden>등기부등본·가족관계증명서는 기기 운영시간과 달리 평일 낮에만 발급되는 곳이 있어요.</p>
</div>
