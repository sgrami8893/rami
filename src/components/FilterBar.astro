---
// Markup only; behaviour lives in src/scripts/filters.ts. Without JS the full list stays visible.
interface Props { dongs: string[]; subGu: string[] }
const { dongs, subGu } = Astro.props;
const chips = [
  ['open', '지금 운영 중'], ['24h', '24시간'], ['weekend', '주말·공휴일'], ['registry', '등기부등본'], ['family', '가족관계증명서'],
];
const sel = 'h-9 min-w-0 rounded-xl bg-card px-3 text-[14px] text-ink-2';
---
<div id="filters" class="sticky top-14 z-20 -mx-4 bg-bg/95 px-4 pb-2 pt-3 backdrop-blur">
  <div class="scrollbar-none -mx-4 flex gap-2 overflow-x-auto px-4" role="group" aria-label="조건 필터">
    {chips.map(([key, label]) => (
      <button type="button" data-chip={key} aria-pressed="false"
        class="chip flex h-9 shrink-0 items-center whitespace-nowrap rounded-full bg-card px-3.5 text-[14px] font-medium text-ink-2 aria-pressed:bg-brand aria-pressed:text-white">
        {key === 'open' && <span class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-ok"></span>}{label}
      </button>
    ))}
  </div>
  {(subGu.length > 0 || dongs.length > 1) && (
    <div class="mt-2 flex items-center gap-2">
      {subGu.length > 0 && (
        <select id="f-subgu" class={sel} aria-label="구 선택">
          <option value="">구 전체</option>
          {subGu.map((g) => <option value={g}>{g}</option>)}
        </select>
      )}
      {dongs.length > 1 && (
        <select id="f-dong" class={sel} aria-label="동 선택">
          <option value="">동 전체</option>
          {dongs.map((d) => <option value={d}>{d}</option>)}
        </select>
      )}
    </div>
  )}
  <p id="f-count" class="mt-2 text-cap text-ink-3" aria-live="polite"></p>
</div>
