---
import type { RegionStats } from '../lib/data.ts';
interface Props { st: RegionStats }
const { st } = Astro.props;
const cards = [
  ['전체', st.total, ''], ['24시간', st.is24h, '24h'], ['주말·공휴일', st.openWeekend, 'weekend'], ['등기부', st.docs.registry ?? 0, 'registry'],
] as const;
---
<!-- 누르면 아래 필터 칩과 같이 켜지고 꺼진다(filters.ts). '전체'는 필터 초기화. -->
<div class="mt-4 grid grid-cols-4 divide-x divide-line rounded-2xl bg-bg py-3" role="group" aria-label="조건별 개수 (누르면 필터)">
  {cards.map(([label, n, chip]) => (
    <button type="button" data-stat-chip={chip} aria-pressed={chip ? 'false' : 'true'} class="group px-1 py-1 text-center">
      <span class="block text-[length:calc(21px*var(--fs,1))] font-bold leading-tight text-ink group-hover:text-brand group-aria-pressed:text-brand">{n}</span>
      <span class="mx-auto block w-fit border-b-2 border-transparent text-cap text-ink-3 group-aria-pressed:border-brand group-aria-pressed:font-semibold group-aria-pressed:text-brand">{label}</span>
    </button>
  ))}
</div>
