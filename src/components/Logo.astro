---
// 동네콕콕 심볼: 높이가 다른 두 건물(동네) + 동네를 콕 짚는 점. 자체 제작 단색 기하 도형(지도 핀·태극 색 미사용).
interface Props { size?: number; class?: string }
const { size = 24, class: cls = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={`shrink-0 ${cls}`}>
  <rect width="24" height="24" rx="7" fill="currentColor" />
  <rect x="5" y="10" width="6" height="9" rx="1.5" fill="#fff" />
  <rect x="13" y="6" width="6" height="13" rx="1.5" fill="#fff" fill-opacity=".72" />
  <circle cx="8" cy="6.5" r="2" fill="#fff" />
</svg>
