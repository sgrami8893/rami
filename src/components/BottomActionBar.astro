---
// 하단 고정 바는 높이 52px가 고정이라 글자 크기 선택(--fs)과 무관하게 고정 크기(18/13px)로 둔다(크게 해도 버튼 밖으로 넘치지 않게).
// 상세 페이지 하단 고정 바(모바일 전용, 공통): 지도 앱 링크(텍스트만, 타사 로고 없음) + 주소 복사.
// 쓰는 곳: <BottomActionBar slot="bottom" ... /> 무인민원발급기 상세, 주차장 상세. 복사 동작은 scripts/copy.ts(initCopy).
import Icon from './Icon.astro';
import { kakaoTo, kakaoSearch, naverSearch } from '../lib/format.ts';
interface Props { name: string; address: string; lat: number | null; lng: number | null; label?: string }
const { name, address, lat, lng, label = '길찾기·주소 복사' } = Astro.props;
const byCoords = lat !== null && lng !== null;
const kakao = byCoords ? kakaoTo(name, lat!, lng!) : kakaoSearch(address);
---
<!-- 푸터 뒤에 바 높이만큼 여백: 마지막 내용이 바에 가려지지 않게 -->
<div aria-hidden="true" class="h-[calc(96px+env(safe-area-inset-bottom))] lg:hidden"></div>
<div role="region" aria-label={label} class="fixed inset-x-0 bottom-0 z-30 bg-card/95 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] backdrop-blur lg:hidden">
  <div class="mx-auto flex max-w-2xl gap-2 px-5 pt-3 pb-[calc(12px+env(safe-area-inset-bottom))]">
    <a href={kakao} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-[1.3] items-center justify-center rounded-2xl bg-brand text-[18px] font-bold text-white hover:brightness-95">
      {byCoords ? '카카오맵 길찾기' : '카카오맵에서 보기'}
    </a>
    <a href={naverSearch(address, name)} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-1 items-center justify-center rounded-2xl bg-bg text-[18px] font-bold text-ink-2 hover:brightness-[0.97]">
      네이버 지도
    </a>
    <button type="button" data-copy={address} class="flex h-[52px] w-[52px] shrink-0 flex-col items-center justify-center gap-0.5 rounded-2xl bg-bg text-ink-2 hover:text-brand" aria-label="주소 복사">
      <Icon name="copy" size={18} /><span class="text-[13px] font-semibold">주소 복사</span>
    </button>
  </div>
</div>
