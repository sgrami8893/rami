---
// 전월세 비교 목록 줄 하나(2026-11-26 v2): 색 칸 · 이름(링크) · 보조 한 줄 · 지금 보는 값(빌라/오피스텔 × 전세/월세, CSS로 하나만 보임).
import Icon from '../Icon.astro';
import { modeVals, modeText, modeNum, modeColor, MODES } from '../../lib/rent-view.ts';
import type { RentArea } from '../../../scripts/lib/rent.ts';
interface Props { a: RentArea; name: string; href: string | null; sub?: string }
const { a, name, href, sub } = Astro.props;
const x = modeVals(a);
const KIND_NOTE: Record<string, string> = { vj: '빌라 전세', vw: '빌라 월세', oj: '오피스텔 전세', ow: '오피스텔 월세' };
---
<div class="v-row" data-row data-n={a.n} data-nm={name} data-vvj={modeNum('vj', x)} data-vvw={modeNum('vw', x)} data-voj={modeNum('oj', x)} data-vow={modeNum('ow', x)} data-key={a.dong ?? a.sigungu}>
  <span class="sw-wrap" aria-hidden="true">{MODES.map((m) => <span class={`sw rm-${m}`} style={`background:${modeColor(m, x)}`}></span>)}</span>
  <div class="t">
    {href ? <a class="n" href={href}>{name}</a> : <span class="n">{name}</span>}
    <span class="s">{sub ?? `거래 ${a.n.toLocaleString('ko-KR')}건`}</span>
  </div>
  <div class="val">
    {MODES.map((m) => { const t = modeText(m, x); return <span class={`rm-${m}`}>{t ?? <span class="text-[length:calc(15px*var(--fs,1))] font-semibold text-ink-3">거래 적음</span>}<span class="sr-only"> {KIND_NOTE[m]} 중위</span></span>; })}
  </div>
  {href && <Icon name="chevron-right" size={18} class="chev" />}
</div>
