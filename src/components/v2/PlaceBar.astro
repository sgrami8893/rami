---
// ① 위치 줄(2026-11-26 v2): 빵부스러기 겸 '유일한 지역 선택기'. 단계마다 누르면 같은 단계 지역 목록이 펼쳐진다(details, JS 없이 동작).
// 예: 서울 ▾ › 마포구 ▾ › 망원동 ▾. 목록 맨 위 '…전체'는 한 단계 위 화면.
import Icon from '../Icon.astro';
export type PlaceItem = { label: string; href: string; meta?: string };
export type PlaceLevel = { label: string; items: PlaceItem[]; all?: PlaceItem; current?: string };
interface Props { levels: PlaceLevel[]; label?: string }
const { levels, label = '지역 고르기' } = Astro.props;
---
<nav class="v-place" aria-label={label}>
  {levels.map((lv, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">›</span>}
      <details class="v-pick">
        <summary aria-label={`${lv.label}, 다른 지역 고르기`}>{lv.label}<Icon name="chevron-down" size={16} /></summary>
        <div class="pop">
          {lv.all && <a href={lv.all.href} class="all">{lv.all.label}</a>}
          {lv.items.map((it) => <a href={it.href} aria-current={it.label === (lv.current ?? lv.label) ? 'page' : undefined}>{it.label}{it.meta && <small>{it.meta}</small>}</a>)}
        </div>
      </details>
    </>
  ))}
</nav>
<script>
  // 한 번에 하나만 펼치고, 바깥을 누르거나 Esc면 닫는다
  document.addEventListener('click', (e) => {
    const inside = (e.target as Element).closest('.v-pick');
    document.querySelectorAll<HTMLDetailsElement>('.v-pick[open]').forEach((d) => { if (d !== inside) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const d = document.querySelector<HTMLDetailsElement>('.v-pick[open]');
    if (d) { d.open = false; d.querySelector('summary')?.focus(); }
  });
</script>
