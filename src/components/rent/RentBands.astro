---
// 면적별 중위값 표(v2): 유형(.rt-v/.rt-o) × 전세/월세(.rk-j/.rk-w) 중 지금 보는 것만. 거래 K_MIN건 이상인 면적대만.
import { AREA_BANDS, K_MIN, type RentArea } from '../../../scripts/lib/rent.ts';
import { amt } from '../../lib/rent-view.ts';
interface Props { a: RentArea }
const { a } = Astro.props;
const T = [['v', 'villa', '빌라'], ['o', 'officetel', '오피스텔']] as const;
const label = (key: string, fb: string) => AREA_BANDS.find((x) => x.key === key)?.label ?? fb;
---
{T.map(([k, key, nm]) => { const s = a.byType[key]; return (
  <div class={`rt-${k}`}>
    {s && s.bands.length ? (
      <table class="v-tbl">
        <caption class="sr-only">{nm} 전용면적별 중위값</caption>
        <thead><tr><th scope="col">전용면적</th><th scope="col" class="r"><span class="rk-j">전세 중위</span><span class="rk-w">월세 중위(보증금/월)</span></th><th scope="col" class="r">건수</th></tr></thead>
        <tbody>{s.bands.map((b) => (
          <tr><th scope="row">{label(b.key, b.label)}</th>
            <td class="r b num"><span class="rk-j">{b.jeonseMedian !== null ? amt(b.jeonseMedian) : '-'}</span><span class="rk-w">{b.wolseMonthlyMedian !== null ? `${amt(b.wolseDepositMedian)}/${b.wolseMonthlyMedian}만` : '-'}</span></td>
            <td class="r m num">{b.n}건{b.n < 30 ? ' · 적음' : ''}</td></tr>
        ))}</tbody>
      </table>
    ) : <p>{nm} 면적별 값이 없어요.</p>}
    <p class="mt-2 text-[length:calc(13px*var(--fs,1))] text-ink-3">거래 {K_MIN}건 이상인 면적대만 보여 줘요. 20㎡ 이하는 원룸, 20~40㎡는 1.5룸·투룸이 많아요(방 개수는 원천 자료에 없어요).</p>
  </div>
); })}
