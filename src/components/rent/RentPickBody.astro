---
// 전월세 지도에서 고른 동(또는 시·군·구) 요약의 틀. 내용은 rent-map.ts가 textContent로 채운다.
// PC는 왼쪽 패널(RentPick), 모바일은 지도 위 카드(RentMap)에 같은 틀을 쓴다.
interface Props { empty?: boolean }
const { empty = false } = Astro.props;
---
{empty && <p class="rp-empty text-cap text-ink-2">지도에서 동네를 누르면 빌라·오피스텔 전세·월세 중위값이 여기에 나와요. 색이 진할수록 값이 높아요.</p>}
<div class="rp-body" hidden>
  <p class="rp-badge pr-10 text-cap font-semibold text-brand"></p>
  <p class="rp-name pr-10 text-h2 font-bold leading-snug text-ink"></p>
  <p class="rp-meta mt-0.5 text-cap text-ink-3"></p>
  <table class="mt-3 w-full text-left text-cap tabular-nums">
    <caption class="sr-only">유형별 최근 12개월 중위값</caption>
    <thead class="text-ink-3"><tr><th scope="col" class="py-1 font-medium">유형</th><th scope="col" class="py-1 font-medium">전세</th><th scope="col" class="py-1 font-medium">월세 (보증금 / 월)</th></tr></thead>
    <tbody class="rp-rows text-ink [&_th]:py-1.5 [&_th]:pr-2 [&_th]:font-semibold [&_td]:py-1.5 [&_td]:pr-2 [&_tr]:border-t [&_tr]:border-line"></tbody>
  </table>
  <a class="rp-link mt-3 flex min-h-11 items-center justify-center rounded-xl bg-brand px-4 text-[length:calc(16px*var(--fs,1))] font-semibold text-white hover:brightness-95"></a>
</div>
