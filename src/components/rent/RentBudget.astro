---
// '내 예산으로 갈 수 있는 동네' v2(2026-11-26 'UX 처음부터'). /rent/ 첫 화면의 [내 예산으로 찾기] 갈래.
// - 짧은 입력(전세/월세 · 유형 · 보증금 · 월세) 바로 아래에 결과 목록. 기본 정렬은 '예산에 가까운 순'(사용자 결정 2026-11-26),
//   '여유 큰 순'·'거래 많은 순'은 선택. 지역 칩(전체·서울·경기·인천).
// - 상태는 주소(?b=…)에 남겨 동 상세로 갔다가 뒤로 와도 그대로(rent-budget-core.ts). 지도는 'rent:budget'으로 시·군·구를 예산 안 동네 수로 칠한다.
// 법적 선: 실거래 '중위값'과 예산의 단순 비교만. 위험·안전·추천 표현, 매물·계약 가능 단정 없음. 광고 자리 없음.
import { RENT_RULE } from '../../lib/rent.ts';
const NOTE = '최근 12개월 실거래 중위값과 비교한 참고용이에요. 실제 매물·계약 가능 여부와 다를 수 있어요.';
const fld = 'v-input num w-full pr-14';
---
<section id="rent-budget" class="mt-4" aria-labelledby="rb-h" hidden>
  <h2 id="rb-h" class="sr-only">내 예산으로 갈 수 있는 동네</h2>
  <form class="rb-form grid gap-3" onsubmit="return false">
    <div class="flex flex-wrap gap-2">
      <fieldset class="v-seg"><legend class="sr-only">전세·월세</legend>
        <label><input type="radio" name="rb-kind" value="j" checked class="sr-only" />전세</label>
        <label><input type="radio" name="rb-kind" value="w" class="sr-only" />월세</label>
      </fieldset>
      <fieldset class="v-seg"><legend class="sr-only">주택 유형</legend>
        <label><input type="radio" name="rb-type" value="a" checked class="sr-only" />전체</label>
        <label><input type="radio" name="rb-type" value="v" class="sr-only" />빌라</label>
        <label><input type="radio" name="rb-type" value="o" class="sr-only" />오피스텔</label>
      </fieldset>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label for="rb-dep" class="rb-dep-label text-cap font-semibold text-ink-2">전세 보증금 상한</label>
        <div class="relative mt-1">
          <input id="rb-dep" name="dep" type="number" inputmode="numeric" min="0" max="300000" step="500" value="20000" aria-describedby="rb-dep-won" class={fld} />
          <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-cap text-ink-3" aria-hidden="true">만 원</span>
        </div>
        <p id="rb-dep-won" class="num mt-1 text-cap text-ink-3">2억 원</p>
        <div class="rb-qs mt-2 flex flex-wrap gap-1.5" role="group" aria-label="보증금 빠르게 고르기">
          {[[5000, '5천'], [10000, '1억'], [15000, '1.5억'], [20000, '2억'], [30000, '3억']].map(([v, t]) => <button type="button" class="v-chip rb-q" data-k="j" data-set={`dep:${v}`}>{t}</button>)}
          {[[500, '500만'], [1000, '1천'], [2000, '2천'], [3000, '3천'], [5000, '5천']].map(([v, t]) => <button type="button" class="v-chip rb-q" data-k="w" data-set={`dep:${v}`} hidden>{t}</button>)}
        </div>
      </div>
      <div class="rb-mon" hidden>
        <label for="rb-mon" class="text-cap font-semibold text-ink-2">월세 상한</label>
        <div class="relative mt-1">
          <input id="rb-mon" name="mon" type="number" inputmode="numeric" min="0" max="1000" step="5" value="60" aria-describedby="rb-mon-won" class={fld} />
          <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-cap text-ink-3" aria-hidden="true">만 원</span>
        </div>
        <p id="rb-mon-won" class="num mt-1 text-cap text-ink-3">월 60만 원</p>
        <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="월세 빠르게 고르기">
          {[40, 50, 60, 70, 80, 100].map((v) => <button type="button" class="v-chip rb-q" data-set={`mon:${v}`}>{v}만</button>)}
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-2" role="group" aria-label="지역">
      <button type="button" class="v-chip" data-rb-region="" aria-pressed="true">전체</button>
      <button type="button" class="v-chip" data-rb-region="seoul" aria-pressed="false">서울</button>
      <button type="button" class="v-chip" data-rb-region="gyeonggi" aria-pressed="false">경기</button>
      <button type="button" class="v-chip" data-rb-region="incheon" aria-pressed="false">인천</button>
    </div>
  </form>

  <div class="v-listhead mt-4">
    <span class="v-count">조건에 맞는 동네 <b class="rb-count num">-</b></span>
    <label class="v-sort"><span class="sr-only">정렬</span>
      <select class="rb-sort">
        <option value="near">예산에 가까운 순</option>
        <option value="room">여유 큰 순</option>
        <option value="n">거래 많은 순</option>
      </select>
    </label>
  </div>
  <p class="rb-loading py-4 text-cap text-ink-3">동네 목록 불러오는 중</p>
  <div class="rb-list v-list" aria-labelledby="rb-h"></div>
  <p class="rb-empty py-4 text-body text-ink-2" hidden>조건에 맞는 동네가 없어요. 금액을 올리거나 유형·지역을 넓혀 보세요.</p>
  <button type="button" class="rb-more v-more" hidden>더 보기</button>
  <p class="mt-3 text-cap text-ink-3">{NOTE} 거래가 {RENT_RULE.INDEX_MIN}건 미만인 동네는 빼고 셌어요.</p>
</section>

<script>
  import { onPage, noteUrl } from '../../scripts/soft-nav.ts';
  import { announce } from '../../scripts/copy.ts';
  import { DEFAULT, DEFAULT_W_DEP, MAX_DEP, MAX_MON, parse, query, judge, loadIndex, setBudget, roomStep, ROOM_COLORS, short, won, typeName, type Budget, type Index, type Verdict } from '../../scripts/rent-budget-core.ts';

  const PAGE = 20;
  type Ok = Extract<Verdict, { s: 'ok' }>;
  onPage(() => {
    const root = document.getElementById('rent-budget');
    const entry = document.querySelector<HTMLElement>('[data-entry]');
    if (!root || !entry || root.dataset.ready) { if (!root) setBudget(null); return; }
    root.dataset.ready = '1';
    entry.hidden = false; // JS가 있을 때만 두 갈래 전환을 보여 준다
    const regions = document.querySelector<HTMLElement>('[data-rent-regions]');
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const radios = (name: string) => [...root.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
    const val = (name: string) => radios(name).find((r) => r.checked)?.value ?? '';
    const setRadio = (name: string, v: string) => radios(name).forEach((r) => { r.checked = r.value === v; });
    const dep = $<HTMLInputElement>('#rb-dep'), mon = $<HTMLInputElement>('#rb-mon'), sortSel = $<HTMLSelectElement>('.rb-sort');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-rb-region]')];
    const region = () => chips.find((c) => c.getAttribute('aria-pressed') === 'true')?.dataset.rbRegion ?? '';

    const init = parse(location.search);
    const q0 = new URLSearchParams(location.search);
    let b: Budget = init ?? { ...DEFAULT };
    const deps = { j: b.kind === 'j' ? b.dep : DEFAULT.dep, w: b.kind === 'w' ? b.dep : DEFAULT_W_DEP };
    let on = Boolean(init);
    let shown = PAGE;
    setRadio('rb-kind', b.kind); setRadio('rb-type', b.type);
    sortSel.value = ['room', 'n'].includes(q0.get('s') ?? '') ? q0.get('s')! : 'near';
    const r0 = ['seoul', 'gyeonggi', 'incheon'].includes(q0.get('r') ?? '') ? q0.get('r')! : '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.rbRegion === r0)));
    dep.value = String(b.dep); mon.value = String(b.mon);

    let index: Index | null = null;
    const num = (el: HTMLInputElement, hi: number) => Math.max(0, Math.min(hi, Math.round(Number(el.value) || 0)));
    const sync = () => {
      const kind = val('rb-kind') as Budget['kind'];
      b = { kind, dep: num(dep, MAX_DEP), mon: num(mon, MAX_MON), type: val('rb-type') as Budget['type'] };
      $<HTMLElement>('.rb-mon').hidden = kind !== 'w';
      $('.rb-dep-label').textContent = kind === 'j' ? '전세 보증금 상한' : '월세 보증금 상한';
      $('#rb-dep-won').textContent = won(b.dep);
      $('#rb-mon-won').textContent = `월 ${b.mon.toLocaleString('ko-KR')}만 원`;
      root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((q) => {
        if (q.dataset.k) q.hidden = q.dataset.k !== kind;
        const [f, v] = q.dataset.set!.split(':');
        q.setAttribute('aria-pressed', String((f === 'dep' ? b.dep : b.mon) === Number(v)));
      });
    };
    const writeUrl = () => {
      const s = sortSel.value;
      const url = on ? `${location.pathname}${query(b, { r: region() || null, s: s === 'near' ? null : s })}` : location.pathname;
      if (url !== location.pathname + location.search) { history.replaceState(history.state, '', url); noteUrl(); }
    };

    // ---- 목록(v-row 모양) ----
    const list = $<HTMLElement>('.rb-list');
    const el = (tag: string, cls: string, text?: string) => { const e = document.createElement(tag); e.className = cls; if (text !== undefined) e.textContent = text; return e; };
    const valueText = (v: Ok) => (b.kind === 'j' ? short(v.d) : `${short(v.d)}/${v.w}만`);
    const diffText = (v: Ok) => (v.diff <= 0 ? '예산과 같아요' : b.kind === 'j' ? `${short(v.diff)} 남아요` : `월 ${v.diff}만 남아요`);
    let lastCount = -1, timer = 0;
    const render = () => {
      if (!index || !on) return;
      const r = region();
      const rows = index.d.filter((d) => !r || d.f.startsWith(`${r}__`))
        .map((d) => ({ d, v: judge(d, index!.low, b) }))
        .filter((x): x is { d: typeof x.d; v: Ok } => x.v.s === 'ok');
      const s = sortSel.value;
      if (s === 'n') rows.sort((x, y) => y.d.n - x.d.n);
      else if (s === 'room') rows.sort((x, y) => y.v.room - x.v.room || y.d.n - x.d.n);
      else rows.sort((x, y) => x.v.room - y.v.room || y.d.n - x.d.n);
      $('.rb-count').textContent = `${rows.length.toLocaleString('ko-KR')}곳`;
      list.replaceChildren(...rows.slice(0, shown).map(({ d, v }) => {
        const [sd, nm, sh] = index!.sgg[d.f] ?? ['', '', null];
        const row = el('div', 'v-row'); row.dataset.key = d.f;
        const sw = el('span', 'sw'); sw.setAttribute('aria-hidden', 'true'); sw.style.background = ROOM_COLORS[roomStep(v.room)];
        const t = el('div', 't');
        const a = el('a', 'n', d.k.split(' ').pop()!) as HTMLAnchorElement; a.href = d.h ?? sh ?? '/rent/';
        t.append(a, el('span', 's', `${sd} ${nm}${d.k.includes(' ') ? ` ${d.k.split(' ')[0]}` : ''} · ${typeName(v.t)} · 거래 ${d.n.toLocaleString('ko-KR')}건`));
        const val2 = el('div', 'val', valueText(v));
        val2.append(el('small', '', diffText(v)));
        row.append(sw, t, val2);
        return row;
      }));
      $<HTMLElement>('.rb-empty').hidden = rows.length > 0;
      const more = $<HTMLButtonElement>('.rb-more');
      more.hidden = rows.length <= shown;
      more.textContent = `${Math.min(PAGE, rows.length - shown)}곳 더 보기 (남은 ${rows.length - shown}곳)`;
      if (rows.length !== lastCount) {
        lastCount = rows.length;
        clearTimeout(timer);
        timer = window.setTimeout(() => announce(`조건에 맞는 동네 ${rows.length}곳이에요.`), 600);
      }
    };

    const entryBtns = [...entry.querySelectorAll<HTMLButtonElement>('[data-entry-v]')];
    const apply = (resetPage = true) => {
      sync();
      if (resetPage) shown = PAGE;
      root.hidden = !on;
      if (regions) regions.hidden = on;
      entryBtns.forEach((x) => x.setAttribute('aria-pressed', String((x.dataset.entryV === 'budget') === on)));
      writeUrl();
      setBudget(on ? b : null);
      if (on && !index) {
        loadIndex().then((x) => { index = x; $<HTMLElement>('.rb-loading').hidden = true; render(); })
          .catch(() => { $('.rb-loading').textContent = '동네 목록을 불러오지 못했어요. 잠시 뒤 다시 시도해 주세요.'; });
      }
      render();
    };

    entryBtns.forEach((x) => x.addEventListener('click', () => {
      const next = x.dataset.entryV === 'budget';
      if (next === on) return;
      on = next; apply();
      announce(on ? '내 예산으로 찾기로 바꿨어요. 지도는 시·군·구마다 예산 안 동네 수로 칠해요.' : '지역으로 보기로 바꿨어요.');
    }));
    radios('rb-kind').forEach((r) => r.addEventListener('change', () => {
      const k = val('rb-kind') as Budget['kind'];
      deps[k === 'j' ? 'w' : 'j'] = num(dep, MAX_DEP);
      dep.value = String(deps[k]);
      apply();
    }));
    radios('rb-type').forEach((r) => r.addEventListener('change', () => apply()));
    sortSel.addEventListener('change', () => apply());
    chips.forEach((c) => c.addEventListener('click', () => { chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c))); apply(); }));
    let inputTimer = 0;
    for (const x of [dep, mon]) x.addEventListener('input', () => { sync(); clearTimeout(inputTimer); inputTimer = window.setTimeout(() => apply(), 250); });
    root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((q) => q.addEventListener('click', () => {
      const [f, v] = q.dataset.set!.split(':');
      (f === 'dep' ? dep : mon).value = v;
      apply();
      announce(f === 'dep' ? `보증금 상한 ${won(Number(v))}` : `월세 상한 월 ${v}만 원`);
    }));
    $('.rb-more').addEventListener('click', () => { shown += PAGE; render(); (list.children[shown - PAGE] as HTMLElement | undefined)?.querySelector('a')?.focus(); });
    apply();
  });
</script>
