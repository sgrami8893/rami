---
// 한 지역(시·군·구 또는 법정동)의 유형별 전월세 실거래 요약. 사실 지표(건수·최저·중위·최고·면적대)만 보여 주고 판정 표현은 쓰지 않는다.
// 표시하지 않는 것: 지번·건물명·층·계약일(일). 통계 한 칸은 K_MIN건 이상일 때만.
import { HOUSE_LABEL, K_MIN, RENT_RULE, AREA_BANDS, manwon, bandText, type RentArea, type HouseType } from '../../../scripts/lib/rent.ts';
interface Props { a: RentArea; place: string; level?: 2 | 3 }
const { a, place } = Astro.props;
const types = (['villa', 'officetel'] as HouseType[]).filter((t) => a.byType[t]);
const bandLine = (b: ReturnType<typeof bandText>) => (b ? `${b.label} ${b.text}` : `거래 ${RENT_RULE.RANGE_MIN}건 미만이라 범위는 생략해요`);
const man = (v: number) => `${v}만 원`;
// 면적대 이름은 저장 파일이 아니라 코드 기준(짧은 라벨), 표 안 금액은 '원'을 빼서 375px에서 한 줄로
const bandLabel = (key: string, fallback: string) => AREA_BANDS.find((x) => x.key === key)?.label ?? fallback;
const short = (v: number | null) => (v === null ? '-' : manwon(v).replace(/ 원$/, ''));
const qLabel = (q: string) => `${q.slice(2, 4)}년 ${q.slice(6)}분기`;
---
{types.map((t) => { const s = a.byType[t]!; const id = `sum-${t}`; return (
  <section aria-labelledby={id} class="mt-6">
    <h2 id={id} class="text-h2 font-bold text-ink">{place} {HOUSE_LABEL[t]} 전월세 <span class="text-body font-medium text-ink-3">{s.n}건</span></h2>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      <div class="rounded-2xl bg-bg px-4 py-4">
        <p class="text-cap text-ink-3">전세 보증금 중위값 <span class="text-ink-3">({s.jeonse?.n ?? 0}건)</span></p>
        <p class="mt-0.5 text-[length:calc(24px*var(--fs,1))] font-bold text-ink">{s.jeonse ? manwon(s.jeonse.median) : '-'}</p>
        <p class="mt-1 text-cap text-ink-2">{bandLine(bandText(s.jeonse, manwon))}</p>
      </div>
      <div class="rounded-2xl bg-bg px-4 py-4">
        <p class="text-cap text-ink-3">월세 중위값 <span class="text-ink-3">({s.wolse?.n ?? 0}건)</span></p>
        <p class="mt-0.5 text-[length:calc(24px*var(--fs,1))] font-bold text-ink">{s.wolse?.deposit && s.wolse.monthly ? `${manwon(s.wolse.deposit.median)} / ${s.wolse.monthly.median}만 원` : '-'}</p>
        <p class="mt-1 text-cap text-ink-2">보증금 / 월세 · 월세 {bandLine(bandText(s.wolse?.monthly ?? null, man))}</p>
      </div>
    </div>
    {s.bands.length > 0 && (
      <div class="mt-3 overflow-x-auto">
        <table class="w-full min-w-[320px] text-[length:calc(16px*var(--fs,1))]">
          <caption class="py-2 text-left text-cap text-ink-3">전용면적별 중위값, 단위 만 원 (거래 {K_MIN}건 이상인 면적대만)</caption>
          <thead><tr class="border-b border-line text-cap text-ink-3"><th scope="col" class="py-2 text-left font-medium">전용면적</th><th scope="col" class="py-2 text-right font-medium">건수</th><th scope="col" class="py-2 text-right font-medium">전세</th><th scope="col" class="py-2 text-right font-medium">월세(보증금/월)</th></tr></thead>
          <tbody>
            {s.bands.map((b) => (
              <tr class="border-b border-line">
                <th scope="row" class="whitespace-nowrap py-2.5 pr-2 text-left font-semibold text-ink-2">{bandLabel(b.key, b.label)}</th>
                <td class="py-2.5 pl-2 text-right text-ink-2">{b.n}</td>
                <td class="whitespace-nowrap py-2.5 pl-2 text-right text-ink">{short(b.jeonseMedian)}</td>
                <td class="whitespace-nowrap py-2.5 pl-2 text-right text-ink">{b.wolseMonthlyMedian !== null ? `${short(b.wolseDepositMedian)} / ${b.wolseMonthlyMedian}` : '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-1 text-cap text-ink-3">참고: 20㎡ 이하는 원룸, 20~40㎡는 1.5룸·투룸, 40~60㎡는 투룸·쓰리룸이 많아요(방 개수는 원천 자료에 없어요).</p>
      </div>
    )}
    <details class="mt-2">
      <summary class="inline-flex min-h-11 cursor-pointer items-center text-cap font-semibold text-brand">분기별 거래 흐름 보기</summary>
      <table class="mt-1 w-full text-[length:calc(16px*var(--fs,1))]">
        <caption class="sr-only">{place} {HOUSE_LABEL[t]} 분기별 거래 건수와 중위값</caption>
        <thead><tr class="border-b border-line text-cap text-ink-3"><th scope="col" class="py-2 text-left font-medium">분기</th><th scope="col" class="py-2 text-right font-medium">건수</th><th scope="col" class="py-2 text-right font-medium">전세 중위</th><th scope="col" class="py-2 text-right font-medium">월세 중위</th></tr></thead>
        <tbody>{s.quarters.map((x) => <tr class="border-b border-line"><th scope="row" class="py-2.5 text-left font-semibold text-ink-2">{qLabel(x.q)}</th><td class="py-2.5 text-right text-ink-2">{x.n}</td><td class="py-2.5 text-right text-ink">{x.jeonseMedian !== null ? manwon(x.jeonseMedian) : '-'}</td><td class="py-2.5 text-right text-ink">{x.wolseMonthlyMedian !== null ? `${x.wolseMonthlyMedian}만 원` : '-'}</td></tr>)}</tbody>
      </table>
    </details>
    <p class="mt-2 text-cap text-ink-2">신규 계약 {s.newCount}건 · 갱신 계약 {s.renewCount}건{s.usedRightCount ? ` (계약갱신요구권 사용 ${s.usedRightCount}건)` : ''}{s.buildYearMedian ? ` · 건축년도 중위 ${s.buildYearMedian}년` : ''}</p>
  </section>
); })}
