---
// PC(1024px+) 왼쪽 패널의 '지도에서 고른 동네' 요약 칸. 지도가 있을 때만 보인다(JS가 hidden을 푼다). 모바일은 지도 위 카드를 쓴다.
import RentPickBody from './RentPickBody.astro';
import { MAP } from '../../config.ts';
import { HAS_PAGES } from '../../lib/rent.ts';
interface Props { class?: string }
const { class: cls = 'mt-4' } = Astro.props;
---
{MAP.enabled && HAS_PAGES && (
  <section id="rent-pick" hidden aria-label="지도에서 고른 동네" aria-live="polite" class={`hidden scroll-mt-20 rounded-2xl border border-line bg-card p-4 lg:block ${cls}`}>
    <RentPickBody empty />
  </section>
)}
