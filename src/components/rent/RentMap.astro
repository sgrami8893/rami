---
// 전월세 단계구분도 지도 패널(2026-11-26). BaseLayout의 'map' 슬롯에 넣는다: <RentMap slot="map" focus={{ sido, slug, dong }} />
// 배치·모바일 전체 화면·닫기는 주차장 지도(MapPanel)와 같은 #map-pane 규칙을 쓴다(map-panel.ts). 그리기는 rent-map.ts.
// 바깥 요청은 배경지도 타일뿐(VWorld, 저장·캐시 없음). 경계·통계는 우리 정적 JSON(/geo/rent/).
import { MAP } from '../../config.ts';
import { HAS_PAGES, periodText } from '../../lib/rent.ts';
import Icon from '../Icon.astro';
import RentPickBody from './RentPickBody.astro';
import RegionChips from '../RegionChips.astro';
import MapTools from '../MapTools.astro';
import { HAS_BUILDINGS } from '../../lib/rent-buildings.ts';
interface Props { focus?: { sido?: string; slug?: string; dong?: string | null } }
const { focus = {} } = Astro.props;
const show = MAP.enabled && HAS_PAGES;
const cfg = { url: MAP.url, attribution: MAP.attribution, maxZoom: MAP.maxZoom };
---
{show && (
  <section id="map-pane" class="map-pane" aria-label="전월세 시세 지도" data-label="전월세 시세 지도">
    <div class="map-bar flex h-14 shrink-0 items-center gap-2 border-b border-line bg-card px-3 lg:hidden">
      <h2 class="min-w-0 flex-1 truncate pl-1 text-body font-bold text-ink">전월세 시세 지도</h2>
      <button type="button" data-map-close class="flex h-11 shrink-0 items-center gap-1 rounded-xl bg-bg px-3 text-[length:calc(16px*var(--fs,1))] font-semibold text-ink">
        <Icon name="list" size={18} />목록으로
      </button>
    </div>
    <div class="relative min-h-0 flex-1">
      <div class="map-canvas rent-map absolute inset-0" data-kind="rent" data-src="/geo/rent/" data-bsrc={HAS_BUILDINGS ? '/geo/rent-b/' : undefined} data-cfg={JSON.stringify(cfg)} data-focus={JSON.stringify({ ...focus, dong: focus.dong ?? undefined })}>
        <p class="map-loading flex h-full items-center justify-center text-cap text-ink-3">지도 불러오는 중</p>
      </div>
      <!-- 지도 도구 v3(2026-11-26 사용자 '투박하다'): 한 줄 떠 있는 도구 막대. 지역은 이동 경로 칩 + 목록 팝업, 유형·전월세는 가벼운 분할 버튼 -->
      <div class="rm-toolbar pointer-events-none absolute left-3 right-[68px] top-3 z-[1000] flex flex-wrap items-start gap-2" hidden>
        <MapTools current="rent" sido={focus.sido} sgg={focus.slug} />
        <RegionChips />
        <div class="map-float pointer-events-auto flex items-center gap-1 p-1">
          <fieldset class="rm-seg"><legend class="sr-only">주택 유형</legend>
            <label><input type="radio" name="rm-type" value="v" checked class="sr-only" />빌라</label>
            <label><input type="radio" name="rm-type" value="o" class="sr-only" />오피스텔</label>
          </fieldset>
          <fieldset class="rm-seg"><legend class="sr-only">전세·월세</legend>
            <label><input type="radio" name="rm-kind" value="j" checked class="sr-only" />전세</label>
            <label><input type="radio" name="rm-kind" value="w" class="sr-only" />월세</label>
          </fieldset>
        </div>
      </div>
      <div class="rm-legend map-float absolute bottom-7 left-3 z-[999] w-[min(300px,calc(100%-24px))] px-3.5 pb-2.5 pt-3" hidden>
        <p class="rm-legend-title text-[length:calc(13px*var(--fs,1))] font-semibold text-ink"></p>
        <div class="rm-legend-bar mt-1.5 flex h-3 gap-[2px] overflow-hidden rounded-full [&>span]:flex-1" aria-hidden="true"></div>
        <div class="rm-legend-ticks relative mt-1 h-4 text-[12px] tabular-nums text-ink-2 [&>span]:absolute [&>span]:-translate-x-1/2" aria-hidden="true"></div>
        <p class="mt-1 flex items-center gap-1.5 text-[12px] text-ink-2"><span class="inline-block size-2.5 rounded-sm bg-[#D5D9DE] ring-1 ring-black/10" aria-hidden="true"></span>회색: 거래 적음 · {periodText()}</p>
        <p class="rm-legend-sr sr-only"></p>
      </div>
      <div class="rm-card map-float absolute inset-x-3 bottom-7 z-[1001] max-h-[min(72%,600px)] overflow-y-auto overscroll-contain p-4 lg:inset-x-auto lg:left-3 lg:w-[360px]" role="region" aria-label="고른 동네 요약" tabindex="-1" hidden>
        <button type="button" class="rp-close absolute right-2 top-2 flex size-11 items-center justify-center rounded-full text-ink-3 hover:bg-bg" aria-label="요약 닫기"><Icon name="x" size={20} /></button>
        <RentPickBody />
      </div>
    </div>
    <p class="map-note shrink-0 border-t border-line bg-card px-4 py-2 text-[length:calc(14px*var(--fs,1))] text-ink-3">
      최근 12개월 실거래 중위값{HAS_BUILDINGS && ' · 건물 위치: 행정안전부 주소정보'} · 경계: 행정안전부 도로명주소 법정동 경계{MAP.name && <> · 배경지도 {MAP.policyUrl ? <a href={MAP.policyUrl} class="underline" target="_blank" rel="noopener noreferrer">{MAP.name}</a> : MAP.name} 오픈플랫폼 이용</>}
    </p>
  </section>
)}

<script>
  import { initMapPanels } from '../../scripts/map-panel.ts';
  initMapPanels();
</script>
