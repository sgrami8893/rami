---
// 전월세 단계구분도 지도 칸 v2(2026-11-26 'UX 처음부터'). BaseLayout의 'map' 슬롯: <RentMap slot="map" focus={{ sido, slug, dong }} />
// 지도 위에는 확대·축소, 범례, 출처만 둔다(도구 전환·지역 선택·유형 전환은 머리말과 왼쪽 패널 한 곳씩).
// 모바일: '지도' 알약으로 전체 화면을 열고, 동을 고르면 아래 요약 카드 1장 + '자세히 보기'. PC: 동·시군구를 누르면 그 페이지로.
// 바깥 요청은 배경지도 타일뿐(VWorld, 저장·캐시 없음). 경계·통계는 우리 정적 JSON(/geo/rent/).
import { MAP } from '../../config.ts';
import { HAS_PAGES, periodText } from '../../lib/rent.ts';
import Icon from '../Icon.astro';
import RentPickBody from './RentPickBody.astro';
import { HAS_BUILDINGS } from '../../lib/rent-buildings.ts';
interface Props { focus?: { sido?: string; slug?: string; dong?: string | null }; title?: string }
const { focus = {}, title = '전월세 시세 지도' } = Astro.props;
const show = MAP.enabled && HAS_PAGES;
const cfg = { url: MAP.url, attribution: MAP.attribution, maxZoom: MAP.maxZoom };
---
{show && (
  <section id="map-pane" class="map-pane" aria-label={title} data-label={title}>
    <div class="map-bar flex h-14 shrink-0 items-center gap-1 border-b border-line bg-card px-2 lg:hidden">
      <button type="button" data-map-close class="v-hbtn" aria-label="지도 닫고 목록으로"><Icon name="chevron-left" size={24} /></button>
      <h2 class="min-w-0 flex-1 truncate text-body font-bold text-ink">{title}</h2>
    </div>
    <div class="relative min-h-0 flex-1">
      <div class="map-canvas rent-map absolute inset-0" data-kind="rent" data-src="/geo/rent/" data-bsrc={HAS_BUILDINGS ? '/geo/rent-b/' : undefined} data-cfg={JSON.stringify(cfg)} data-focus={JSON.stringify({ ...focus, dong: focus.dong ?? undefined })}>
        <p class="map-loading flex h-full items-center justify-center text-cap text-ink-3">지도 불러오는 중</p>
      </div>
      <div class="rm-legend map-float absolute bottom-7 left-3 z-[999] w-[min(280px,calc(100%-24px))] px-3.5 pb-2.5 pt-3 max-lg:bottom-auto max-lg:top-3" hidden>
        <p class="rm-legend-title text-[length:calc(13px*var(--fs,1))] font-semibold text-ink"></p>
        <div class="rm-legend-bar mt-1.5 flex h-2.5 gap-[2px] overflow-hidden rounded-full [&>span]:flex-1" aria-hidden="true"></div>
        <div class="rm-legend-ticks relative mt-1 h-4 text-[12px] tabular-nums text-ink-2 [&>span]:absolute [&>span]:-translate-x-1/2" aria-hidden="true"></div>
        <p class="mt-1 flex items-center gap-1.5 text-[12px] text-ink-2"><span class="inline-block size-2.5 shrink-0 rounded-sm bg-[#D5D9DE] ring-1 ring-black/10" aria-hidden="true"></span><span class="rm-legend-note" data-default={`회색: 거래 적음 · ${periodText()}`}>회색: 거래 적음 · {periodText()}</span></p>
        <p class="rm-legend-sr sr-only"></p>
      </div>
      <div class="rm-card map-float absolute inset-x-3 bottom-[84px] z-[1001] max-h-[min(60%,520px)] overflow-y-auto overscroll-contain p-4 lg:bottom-7 lg:inset-x-auto lg:left-3 lg:w-[360px]" role="region" aria-label="고른 동네 요약" tabindex="-1" hidden>
        <button type="button" class="rp-close absolute right-2 top-2 flex size-11 items-center justify-center rounded-full text-ink-3 hover:bg-bg" aria-label="요약 닫기"><Icon name="x" size={20} /></button>
        <RentPickBody />
      </div>
      <button type="button" data-map-close class="v-pill lg:!hidden" style="z-index:1002" aria-hidden="true" tabindex="-1"><Icon name="list" size={20} />목록</button>
    </div>
    <p class="map-note shrink-0 border-t border-line bg-card px-4 py-1.5 text-[length:calc(13px*var(--fs,1))] text-ink-3">
      최근 12개월 실거래 중위값{HAS_BUILDINGS && ' · 건물 위치: 행정안전부 주소정보'} · 경계: 행정안전부 도로명주소 법정동 경계{MAP.name && <> · 배경지도 {MAP.policyUrl ? <a href={MAP.policyUrl} class="underline" target="_blank" rel="noopener noreferrer">{MAP.name}</a> : MAP.name} 오픈플랫폼 이용</>}
    </p>
  </section>
)}

<script>
  import { initMapPanels } from '../../scripts/map-panel.ts';
  initMapPanels();
</script>
