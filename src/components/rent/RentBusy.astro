---
// 동 상세 '요즘 전월세 거래가 많은 건물'(2026-11-27 제미나이 합의). 위 3곳, 나머지는 '더 보기'(최대 10곳).
// 누르면 '건물별 거래' 탭에서 그 건물 이력을 연다(rent:bld-open). 사실 숫자(건수)만, 판정어·층 없음.
import { busyBuildings, BUSY_MONTHS } from '../../lib/rent-buildings.ts';
import Icon from '../Icon.astro';
interface Props { file: string; dong: string }
const { file, dong } = Astro.props;
const { list, from, to } = busyBuildings(file, dong);
const TYPE = ['빌라', '오피스텔', '아파트'];
---
{list.length > 0 && (
  <section class="busy mt-6" aria-labelledby="busy-h" data-busy>
    <h3 id="busy-h" class="v-cap" style="margin-top:0">요즘 전월세 거래가 많은 건물</h3>
    <div class="v-list">
      {list.map((b, i) => (
        <button type="button" class="v-row busy-row" data-bld-open={b.id} hidden={i >= 3 ? true : undefined}>
          <span class="t"><span class="n">{b.name || b.jibun}</span><span class="s">{TYPE[b.t]} · {dong} {b.jibun}{b.by ? ` · ${b.by}년` : ''}</span></span>
          <span class="val">{b.n}<small>건</small></span>
          <Icon name="chevron-right" size={18} class="chev" />
        </button>
      ))}
    </div>
    {list.length > 3 && <button type="button" class="v-more" data-busy-more>{list.length - 3}곳 더 보기</button>}
    <p class="v-cap busy-note">최근 {BUSY_MONTHS}개월({from}~{to}) 계약된 전월세 실거래 신고 건수예요. {BUSY_MONTHS}건 이상인 건물만 보여 주고, 층은 공개하지 않아요.</p>
  </section>
)}
<script>
  import { onPage } from '../../scripts/soft-nav.ts';
  onPage(() => {
    const sec = document.querySelector<HTMLElement>('[data-busy]');
    if (!sec || sec.dataset.ready) return;
    sec.dataset.ready = '1';
    sec.querySelector<HTMLButtonElement>('[data-busy-more]')?.addEventListener('click', (e) => {
      sec.querySelectorAll<HTMLElement>('.busy-row[hidden]').forEach((r) => { r.hidden = false; });
      const btn = e.currentTarget as HTMLButtonElement; btn.remove();
      sec.querySelectorAll<HTMLElement>('.busy-row')[3]?.focus();
    });
    sec.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-bld-open]');
      if (!b) return;
      const id = b.dataset.bldOpen!;
      // 건물 목록을 아직 못 받았으면 받은 뒤 주소의 #bld= 로 연다
      history.replaceState(history.state, '', `#bld=${encodeURIComponent(id)}`);
      document.dispatchEvent(new CustomEvent('rent:bld-open', { detail: id }));
      document.getElementById('tab-bld')?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
</script>
