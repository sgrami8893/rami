---
import Icon from './Icon.astro';
import { hoursLine, kakaoTo, kakaoSearch, naverSearch, km } from '../lib/format.ts';
import { kioskPath, type Kiosk } from '../lib/data.ts';
interface Props { k: Kiosk; distance?: number; compact?: boolean }
const { k, distance, compact = false } = Astro.props;
const reg = k.docs.includes('registry'), fam = k.docs.includes('family');
// 카드에는 차별점만 한 줄: 법원 발급 서류(등기부등본·가족관계증명서) 발급 여부. 전체 서류는 상세 페이지에.
const keyDocs = reg && fam ? '등기부등본·가족관계증명서 발급' : reg ? '등기부등본 발급' : fam ? '가족관계증명서 발급' : '';
const weekendOrHoliday = k.openSat || k.openSun || k.openHoliday;
const kakao = k.lat !== null && k.lng !== null ? kakaoTo(k.name, k.lat, k.lng) : kakaoSearch(k.roadAddress);
// 지도 버튼은 기기명·운영시간보다 덜 튀게: 36px, 연한 테두리, 회색 글자. 카드 전체 클릭(stretched link) 위로 z-10.
const btn = 'relative z-10 flex h-9 flex-1 items-center justify-center gap-1.5 rounded-xl border border-line/70 bg-card text-[14px] font-medium text-ink-2 hover:bg-bg';
---
<article
  class="kiosk card relative"
  data-id={k.id}
  data-hours={JSON.stringify(k.hours)}
  data-conf={k.hoursConfidence}
  data-f24h={k.is24h ? '1' : ''}
  data-fweekend={weekendOrHoliday ? '1' : ''}
  data-fregistry={reg ? '1' : ''}
  data-ffamily={fam ? '1' : ''}
  data-dong={k.dong ?? ''}
  data-subgu={k.subGu ?? ''}
>
  <div class="flex flex-wrap items-center gap-1.5">
    <span class="open-badge badge invisible bg-off-bg text-off">운영시간 내</span>
    {k.is24h && <span class="badge bg-info-bg text-info">24시간</span>}
    {(reg || fam) && <span class="badge bg-off-bg text-off">{reg && fam ? '등기부·가족관계' : reg ? '등기부' : '가족관계'}</span>}
    {distance !== undefined && <span class="badge bg-off-bg text-off">{km(distance)}</span>}
    <span class="next-open hidden text-cap text-ink-3"></span>
  </div>
  <h3 class="mt-2 text-h2 font-bold text-ink">
    <a href={kioskPath(k)} class="group flex items-center justify-between gap-2 after:absolute after:inset-0 after:rounded-card after:content-['']">
      <span>{k.name}</span>
      <Icon name="chevron-right" size={20} class="text-ink-3 group-hover:text-brand" />
    </a>
  </h3>
  {k.locationDetail && <p class="text-cap text-ink-3">{k.locationDetail}</p>}

  <ul class="mt-2.5 space-y-1 text-body text-ink-2">
    <li class="flex items-center gap-2">
      <Icon name="clock" size={16} class="text-ink-3" label="운영시간" />
      <span class="min-w-0 truncate">{k.hoursConfidence === 'unknown' ? <span class="text-warn">운영시간 확인 필요</span> : hoursLine(k.hours)}{k.hoursConfidence === 'partial' && <span class="ml-1 text-cap text-warn" title={k.hoursRaw}>휴일 미확인</span>}</span>
    </li>
    {!compact && keyDocs && (
      <li class="flex items-center gap-2"><Icon name="file-text" size={16} class="text-ink-3" label="주요 발급 서류" /><span>{keyDocs}</span></li>
    )}
    {!compact && (
      <li class="flex items-center gap-2">
        <Icon name="map-pin" size={16} class="text-ink-3" label="주소" />
        <span class="min-w-0 flex-1 truncate text-cap text-ink-3">{k.roadAddress}</span>
        <button type="button" data-copy={k.roadAddress} class="relative z-10 flex h-7 shrink-0 items-center gap-1 rounded-lg border border-line px-2 text-[12px] font-semibold text-ink-2 hover:bg-bg">
          <Icon name="copy" size={13} /><span>주소 복사</span>
        </button>
      </li>
    )}
  </ul>

  {!compact && (
    <div class="mt-3.5 flex gap-2">
      <a href={kakao} target="_blank" rel="noopener noreferrer" class={btn}><Icon name="navigation" size={16} class="text-ink-3" />카카오맵</a>
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class={btn}><Icon name="map" size={16} class="text-ink-3" />네이버 지도</a>
    </div>
  )}
</article>
