---
import { hoursLine, sortDocs, docLabel, kakaoTo, kakaoSearch, naverSearch, km, KEY_DOCS } from '../lib/format.ts';
import { kioskPath, hasDetail, type Kiosk } from '../lib/data.ts';
interface Props { k: Kiosk; distance?: number; compact?: boolean }
const { k, distance, compact = false } = Astro.props;
const all = sortDocs(k.docs);
const docs = all.filter((d) => KEY_DOCS.includes(d));
const more = all.length - docs.length;
const weekendOrHoliday = k.openSat || k.openSun || k.openHoliday;
---
<article
  class="kiosk rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
  data-id={k.id}
  data-hours={JSON.stringify(k.hours)}
  data-conf={k.hoursConfidence}
  data-f24h={k.is24h ? '1' : ''}
  data-fweekend={weekendOrHoliday ? '1' : ''}
  data-fregistry={k.docs.includes('registry') ? '1' : ''}
  data-ffamily={k.docs.includes('family') ? '1' : ''}
  data-dong={k.dong ?? ''}
  data-subgu={k.subGu ?? ''}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="text-base font-semibold leading-snug">
      {hasDetail(k) ? <a href={kioskPath(k)} class="hover:text-brand">{k.name}</a> : k.name}
    </h3>
    <div class="flex shrink-0 flex-wrap gap-1 text-xs">
      <span class="open-badge hidden rounded-full px-2 py-0.5 font-medium" aria-live="polite"></span>
      {k.is24h && <span class="rounded-full bg-indigo-50 px-2 py-0.5 font-medium text-indigo-700">24시간</span>}
      {distance !== undefined && <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{km(distance)}</span>}
    </div>
  </div>
  {k.locationDetail && <p class="mt-0.5 text-sm text-slate-500">{k.locationDetail}</p>}
  <p class="mt-2 text-sm">
    <span class="text-slate-500">운영</span> {k.hoursConfidence === 'unknown' ? <span class="text-amber-700">운영시간 확인 필요 ({k.hoursRaw || '정보 없음'})</span> : hoursLine(k.hours)}
    {k.hoursConfidence === 'partial' && <span class="ml-1 text-xs text-amber-700" title={k.hoursRaw}>· 일부 추정</span>}
  </p>
  <p class="next-open mt-0.5 hidden text-xs text-slate-500"></p>
  {!compact && docs.length > 0 && (
    <p class="mt-1 text-sm"><span class="text-slate-500">발급</span> {docs.map(docLabel).join(' · ')}{more > 0 && <span class="text-slate-500"> 외 {more}종</span>}</p>
  )}
  {!compact && <p class="mt-1 text-sm text-slate-500">{k.roadAddress}</p>}
  {!compact && (
    <div class="mt-3 flex gap-2 text-sm">
      {k.lat !== null && k.lng !== null
        ? <a href={kakaoTo(k.name, k.lat, k.lng)} target="_blank" rel="noopener" class="flex-1 rounded-lg bg-yellow-300 px-3 py-2 text-center font-medium text-slate-900 hover:bg-yellow-400">카카오맵 길찾기</a>
        : <a href={kakaoSearch(k.roadAddress)} target="_blank" rel="noopener" class="flex-1 rounded-lg bg-yellow-300 px-3 py-2 text-center font-medium text-slate-900 hover:bg-yellow-400">카카오맵에서 보기</a>}
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener" class="flex-1 rounded-lg bg-green-600 px-3 py-2 text-center font-medium text-white hover:bg-green-700">네이버 지도</a>
    </div>
  )}
</article>
