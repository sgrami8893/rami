---
import Icon from './Icon.astro';
import { hoursLine, sortDocs, docLabel, kakaoTo, kakaoSearch, naverSearch, km, KEY_DOCS } from '../lib/format.ts';
import { kioskPath, type Kiosk } from '../lib/data.ts';
interface Props { k: Kiosk; distance?: number; compact?: boolean }
const { k, distance, compact = false } = Astro.props;
const all = sortDocs(k.docs);
const docs = all.filter((d) => KEY_DOCS.includes(d));
const more = all.length - docs.length;
const weekendOrHoliday = k.openSat || k.openSun || k.openHoliday;
const kakao = k.lat !== null && k.lng !== null ? kakaoTo(k.name, k.lat, k.lng) : kakaoSearch(k.roadAddress);
const btn = 'flex h-11 flex-1 items-center justify-center gap-1.5 rounded-xl bg-bg text-[14px] font-semibold text-ink hover:bg-line';
---
<article
  class="kiosk card"
  data-id={k.id}
  data-hours={JSON.stringify(k.hours)}
  data-conf={k.hoursConfidence}
  data-f24h={k.is24h ? '1' : ''}
  data-fweekend={weekendOrHoliday ? '1' : ''}
  data-fregistry={k.docs.includes('registry') ? '1' : ''}
  data-ffamily={k.docs.includes('family') ? '1' : ''}
  data-dong={k.dong ?? ''}
  data-subgu={k.subGu ?? ''}
>
  <div class="flex flex-wrap items-center gap-1.5">
    <span class="open-badge badge invisible bg-off-bg text-off" aria-live="polite">운영 확인 중</span>
    {k.is24h && <span class="badge bg-info-bg text-info">24시간</span>}
    {distance !== undefined && <span class="badge bg-off-bg text-off">{km(distance)}</span>}
    <span class="next-open hidden text-cap text-ink-3"></span>
  </div>
  <h3 class="mt-2 text-h2 font-bold text-ink">
    <a href={kioskPath(k)} class="group flex items-center justify-between gap-2">
      <span>{k.name}</span>
      <Icon name="chevron-right" size={20} class="text-ink-3 group-hover:text-brand" />
    </a>
  </h3>
  {k.locationDetail && <p class="mt-0.5 text-cap text-ink-3">{k.locationDetail}</p>}

  <dl class="mt-3 space-y-1.5 text-body text-ink-2">
    <div class="flex gap-2">
      <dt class="pt-[3px]"><Icon name="clock" size={16} class="text-ink-3" label="운영시간" /></dt>
      <dd>
        {k.hoursConfidence === 'unknown' ? <span class="text-warn">운영시간 확인 필요</span> : hoursLine(k.hours)}
        {k.hoursConfidence === 'partial' && <span class="ml-1 text-cap text-warn" title={k.hoursRaw}>일부 추정</span>}
      </dd>
    </div>
    {!compact && docs.length > 0 && (
      <div class="flex gap-2">
        <dt class="pt-[3px]"><Icon name="file-text" size={16} class="text-ink-3" label="발급 서류" /></dt>
        <dd>{docs.map(docLabel).join(' · ')}{more > 0 && <span class="text-ink-3"> 외 {more}종</span>}</dd>
      </div>
    )}
    {!compact && (
      <div class="flex gap-2">
        <dt class="pt-[3px]"><Icon name="map-pin" size={16} class="text-ink-3" label="주소" /></dt>
        <dd class="text-cap leading-[22px] text-ink-3">{k.roadAddress}</dd>
      </div>
    )}
  </dl>

  {!compact && (
    <div class="mt-4 flex gap-2">
      <a href={kakao} target="_blank" rel="noopener noreferrer" class={btn}><Icon name="navigation" size={16} />카카오맵</a>
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class={btn}><Icon name="map" size={16} />네이버 지도</a>
    </div>
  )}
</article>
