---
import { GUIDES, guidePath, GUIDE_BASE } from '../lib/guides.ts';
interface Props { title?: string; limit?: number }
const { title = '무인민원발급기 이용 가이드', limit } = Astro.props;
const list = limit ? GUIDES.slice(0, limit) : GUIDES;
---
<section class="mt-8">
  <div class="mb-2 flex items-baseline justify-between">
    <h2 class="text-lg font-bold">{title}</h2>
    <a href={GUIDE_BASE} class="text-sm text-brand underline">전체 보기</a>
  </div>
  <ul class="grid gap-2 sm:grid-cols-2">
    {list.map((g) => (
      <li><a href={guidePath(g)} class="block h-full rounded-xl border border-slate-200 bg-white p-4 hover:border-brand">
        <p class="font-semibold leading-snug">{g.title}</p>
        <p class="mt-1 text-sm text-slate-600">{g.summary}</p>
      </a></li>
    ))}
  </ul>
</section>
