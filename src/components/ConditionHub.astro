---
// 시·도 단위 조건 허브 본문 (24h·weekend·registry·family 공용). 시·군·구마다 최대 5곳만 보여 주고 나머지는 시·군·구 필터 링크로.
import BaseLayout from '../layouts/BaseLayout.astro';
import KioskRow from './KioskRow.astro';
import GuideList from './GuideList.astro';
import Icon from './Icon.astro';
import { kiosks, regionsIn, sidoName, sidoShort, regionPath, MUIN_CRUMBS, type SidoSlug } from '../lib/data.ts';
import { HUB_CONDS, HUB_LABEL, HUB_PRED, hubStats, hubPath, type HubCond } from '../lib/hubs.ts';
import { hubTitle, hubDescription, hubSummary } from '../lib/copy.ts';
import { breadcrumb } from '../lib/jsonld.ts';
import { GUIDES, guidePath } from '../lib/guides.ts';
import { SIGUNGU } from '../../scripts/lib/regions.ts';

interface Props { sido: SidoSlug; cond: HubCond }
const { sido, cond } = Astro.props;
// 정적 폴더(24h 등)가 시·군·구 slug와 겹치면 시·군·구 페이지가 가려진다 → 빌드에서 막는다.
if (SIGUNGU[sido].some((s) => (HUB_CONDS as string[]).includes(s.slug))) throw new Error(`조건 허브 경로가 시·군·구 slug와 겹침: ${sido}`);

const PER_REGION = 5;
const label = HUB_LABEL[cond];
const st = hubStats(kiosks, sido, cond);
const rs = regionsIn(sido);
const hit = kiosks.filter((k) => k.sido === sido && HUB_PRED[cond](k));
const latest = hit.map((k) => k.baseDate).filter(Boolean).sort().at(-1) ?? '미상';
const groups = rs
  .map((r) => ({ r, items: hit.filter((k) => k.sigungu === r.sigungu).sort((a, b) => Number(b.is24h) - Number(a.is24h) || a.name.localeCompare(b.name, 'ko')) }))
  .filter((g) => g.items.length)
  .sort((a, b) => a.r.sigunguName.localeCompare(b.r.sigunguName, 'ko'));
const ranked = [...groups].sort((a, b) => b.items.length - a.items.length);
const others = HUB_CONDS.filter((c) => c !== cond).map((c) => ({ c, ...hubStats(kiosks, sido, c) })).filter((h) => h.count > 0);
const otherSidos = (['seoul', 'gyeonggi', 'incheon'] as SidoSlug[]).filter((s) => s !== sido && hubStats(kiosks, s, cond).count > 0);
const guideSlugs: Record<HubCond, string[]> = {
  '24h': ['24h-weekend', 'court-documents-hours'],
  weekend: ['24h-weekend', 'how-to-use'],
  registry: ['court-documents-hours', 'real-estate-contract-documents'],
  family: ['court-documents-hours', 'how-to-use'],
};
const guides = guideSlugs[cond].map((s) => GUIDES.find((g) => g.slug === s)).filter((g) => !!g);
const title = hubTitle(sido, cond, st.count, label.h1);
const crumbs = [...MUIN_CRUMBS, { name: sidoShort(sido), href: regionPath(sido) }, { name: label.short, href: hubPath(sido, cond) }];
const abs = (p: string) => new URL(p, Astro.site).href;
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
---
<BaseLayout tool="muin" canvas="white" title={title} description={hubDescription(sido, cond, st.count)} crumbs={crumbs}
  noindex={!st.indexable}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) })))]}>
  <h1 class="text-title font-bold text-ink">{sidoShort(sido)} {label.h1} {st.count.toLocaleString('ko-KR')}곳</h1>
  <p class="mt-1 text-cap text-ink-3">{sidoName(sido)} · 데이터 기준일 {latest}</p>

  <div class="mt-4 rounded-2xl bg-bg p-5 text-body text-ink-2">
    {hubSummary(sido, cond, hit, st.total, rs).map((t, i) => <p class={i ? 'mt-1.5' : ''}>{t}</p>)}
  </div>

  <section class="mt-8">
    <h2 class="text-h2 font-bold text-ink">시·군·구별 {label.short} 기기 수</h2>
    <div class="mt-3 -mx-5 overflow-x-auto px-5 lg:mx-0 lg:px-0">
      <table class="w-full min-w-[20rem] border-collapse text-[length:calc(16px*var(--fs,1))]">
        <thead>
          <tr class="border-b border-line text-left text-cap text-ink-3">
            <th scope="col" class="py-2 pr-2 font-semibold">시·군·구</th>
            <th scope="col" class="px-2 py-2 text-right font-semibold">{label.short}</th>
            <th scope="col" class="py-2 pl-2 text-right font-semibold">전체 대비</th>
          </tr>
        </thead>
        <tbody>
          {ranked.map(({ r, items }) => (
            <tr class="border-b border-line">
              <th scope="row" class="py-2.5 pr-2 text-left font-semibold text-ink"><a href={`#${r.sigungu}`} class="hover:text-brand">{r.sigunguName}</a></th>
              <td class="px-2 py-2.5 text-right tabular-nums text-ink">{items.length}<span class="text-ink-3"> / {r.total}</span></td>
              <td class="py-2.5 pl-2 text-right tabular-nums text-ink-2">{pct(items.length, r.total)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-8"><div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div></div>
  <div id="kiosk-list" class="mt-6 space-y-8">
    {groups.map(({ r, items }) => (
      <section id={r.sigungu} class="scroll-mt-16">
        <h2 class="text-[length:calc(17px*var(--fs,1))] font-bold text-ink-2">{r.sigunguName} <span class="ml-0.5 font-medium text-ink-3">{items.length}</span></h2>
        <div>{items.slice(0, PER_REGION).map((k) => <KioskRow k={k} />)}</div>
        {items.length > PER_REGION && (
          <a href={`${regionPath(r.sido, r.sigungu)}?f=${cond}`} class="mt-1 flex h-11 items-center gap-0.5 text-[length:calc(16px*var(--fs,1))] font-semibold text-brand">
            {r.sigunguName} {label.short} {items.length}곳 모두 보기<Icon name="chevron-right" size={18} />
          </a>
        )}
      </section>
    ))}
  </div>

  <div class="mt-8"><div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div></div>
  <section class="py-8">
    <h2 class="mb-3 text-h2 font-bold text-ink">다른 조건으로 모아보기</h2>
    <div class="flex flex-wrap gap-2">
      {others.map((h) => (
        <a href={hubPath(sido, h.c)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">
          {sidoShort(sido)} {HUB_LABEL[h.c].chip} <span class="ml-1 text-ink-3">{h.count.toLocaleString('ko-KR')}</span>
        </a>
      ))}
      {otherSidos.map((s) => (
        <a href={hubPath(s, cond)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">
          {sidoShort(s)} {label.chip}
        </a>
      ))}
      <a href={regionPath(sido)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">{sidoShort(sido)} 전체 {st.total.toLocaleString('ko-KR')}</a>
    </div>
    {guides.length > 0 && (
      <ul class="mt-6 divide-y divide-line">
        {guides.map((g) => (
          <li><a href={guidePath(g)} class="block py-4 hover:[&>p:first-child]:text-brand">
            <p class="text-body font-semibold text-ink">{g.title}</p>
            <p class="mt-1 text-cap text-ink-3">{g.summary}</p>
          </a></li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<script>
  import { refreshOpenState } from '../scripts/open-now.ts';
  refreshOpenState();
  setInterval(refreshOpenState, 60_000);
</script>
