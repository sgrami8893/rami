---
// 지도 위 도구 전환 [전월세|주차장|발급기](2026-11-26). PC(1024px+)에서만 보인다(모바일은 머리말 도구 탭 하나).
// 링크라서 JS 없이도 이동되고, JS가 있으면 지도 화면 안에서 바로 바뀐다(soft-nav, data-keep-view로 지도 위치 유지).
import { toolHref, toolKeys, TOOL_LABEL, type ToolKey } from '../lib/map-tools.ts';
interface Props { current: ToolKey; sido?: string | null; sgg?: string | null }
const { current, sido = null, sgg = null } = Astro.props;
const keys = toolKeys();
---
{keys.length > 1 && (
  <nav class="map-tools map-float pointer-events-auto hidden items-center p-1 lg:flex" aria-label="도구 바꾸기" data-sido={sido ?? ''} data-sgg={sgg ?? ''}>
    {keys.map((k) => (
      <a href={toolHref(k, sido, sgg)} data-tool={k} data-keep-view class="map-tool" aria-current={k === current ? 'page' : undefined}>{TOOL_LABEL[k]}</a>
    ))}
  </nav>
)}
<script>
  import { initMapTools } from '../scripts/map-tools.ts';
  initMapTools();
</script>
