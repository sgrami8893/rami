---
// 지도 위 지역 칩(시·도 › 시·군·구 › 동) 공통 마크업. 목록 팝업 동작은 src/scripts/map-picker.ts.
// 전월세 지도(rent-map.ts)는 지도에서 고른 지역으로, 주차장 지도(map-region-nav.ts)는 그 지역 페이지로 이동한다.
// data: 주차장처럼 페이지로 이동하는 지도의 항목 표(JSON). 없으면 지도 스크립트가 채운다.
import Icon from './Icon.astro';
interface Props { data?: unknown }
const { data } = Astro.props;
---
  <nav data-nav={data ? JSON.stringify(data) : undefined} class="rm-crumbs map-float pointer-events-auto relative z-[2] flex items-center p-1" aria-label="지역 선택">
    {[['sido', '시·도'], ['sgg', '시·군·구'], ['dong', '동네']].map(([k, name], i) => (
      <div class={`rm-pick relative flex items-center rm-pick-${k}`} hidden={i > 0}>
        {i > 0 && <Icon name="chevron-right" size={14} class="mx-0.5 text-[#B0B8C1]" />}
        <button type="button" class="rm-chip" aria-haspopup="listbox" aria-expanded="false">
          <span class="sr-only">{name}: </span>
          {i === 0 && <Icon name="map-pin" size={16} class="text-brand" />}
          <span class="rm-chip-text">{name}</span><Icon name="chevron-down" size={14} class="rm-chip-caret" />
        </button>
        <div class="rm-pop" hidden>
          <div class="rm-pop-search"><Icon name="search" size={16} class="text-ink-3" /><input type="text" role="combobox" aria-expanded="true" aria-autocomplete="list" aria-controls={`rm-list-${k}`} aria-label={`${name} 이름으로 찾기`} placeholder={`${name} 이름으로 찾기`} autocomplete="off" /></div>
          <ul id={`rm-list-${k}`} role="listbox" tabindex="-1" aria-label={`${name} 목록`}></ul>
        </div>
      </div>
    ))}
  </nav>
