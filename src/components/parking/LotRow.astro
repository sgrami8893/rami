---
import { lotPath, FEE_LABEL, LOT_TYPE, dayText, type ParkingLot } from '../../lib/parking.ts';
import { lotHours } from '../../../scripts/lib/parking.ts';
import { calcFee, feeText, sortValue } from '../../../scripts/lib/parking-fee.ts';
interface Props { l: ParkingLot; level?: 2 | 3 }
const { l, level = 3 } = Astro.props;
const H = `h${level}`;
const two = calcFee(l, 120);
const tone = l.fee.type === 'free' ? 'text-ok' : l.fee.type === 'unknown' ? 'text-warn' : 'text-ink-2';
---
<article data-name={l.name} data-free={l.fee.type === 'free' ? '1' : ''} data-hours={JSON.stringify(lotHours(l))} data-fee2={Number.isFinite(sortValue(two)) ? sortValue(two) : ''} class="lot relative -mx-5 px-5 py-[18px] active:bg-subtle lg:-mx-3 lg:rounded-xl lg:px-3 lg:hover:bg-subtle">
  <div class="flex items-start justify-between gap-3">
    <H class="text-[length:calc(19px*var(--fs,1))] font-semibold leading-snug text-ink"><a href={lotPath(l)} class="after:absolute after:inset-0">{l.name}</a></H>
    <span class={`shrink-0 text-cap font-semibold ${tone}`}>{FEE_LABEL[l.fee.type]}</span>
  </div>
  <p class="mt-1"><span class="p-open badge invisible bg-off-bg text-off">운영시간 확인 중</span></p>
  <p class="mt-1 text-[length:calc(16px*var(--fs,1))] text-ink-2">평일 {dayText(l, 'weekday')} · {LOT_TYPE[l.lotType]}{l.spaces !== null && ` · ${l.spaces}면`}</p>
  <p class="mt-1 text-[length:calc(16px*var(--fs,1))] text-ink-2"><span class="text-ink-3">2시간</span> <span class={`font-semibold ${two.status === 'ok' || two.status === 'free' ? 'text-ink' : 'text-ink-3'}`}>{two.status === 'none' ? '요금 정보 없음' : feeText(two)}</span></p>
  <p class="mt-0.5 break-words text-cap text-ink-3">{l.roadAddress || l.jibunAddress}</p>
</article>
