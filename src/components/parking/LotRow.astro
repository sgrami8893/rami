---
import { lotPath, FEE_LABEL, LOT_TYPE, dayText, is24hLot, type ParkingLot } from '../../lib/parking.ts';
import { validPoints } from '../../lib/map.ts';
import Icon from '../Icon.astro';
import { lotHours } from '../../../scripts/lib/parking.ts';
import { calcFee, feeText, sortValue, DURATIONS, dayMinutes } from '../../../scripts/lib/parking-fee.ts';
interface Props { l: ParkingLot; level?: 2 | 3 }
const { l, level = 3 } = Astro.props;
const H = `h${level}`;
const two = calcFee(l, 120);
// 머물 시간별 예상 요금(30분·1시간·2시간·3시간·종일). 계산 불가 = null(목록 맨 뒤 '요금 확인 필요' 묶음)
const fees = DURATIONS.map((d) => { const r = calcFee(l, d.minutes ?? 600); /* 목록의 '종일' = 10시간 기준 */ return r.status === 'free' ? 0 : r.status === 'ok' ? r.amount : null; });
const mapped = validPoints([l]).length > 0; // 지도에 핀이 있는 곳만 지도 연결(data-map-id·'지도' 버튼)
---
<!-- v2(2026-11-26 'UX 처음부터'): 이름 · 한 줄 사실(운영 배지 · 평일 시간 · 종류) · 오른쪽 2시간 요금. 주소는 작은 글자 한 줄. 지도 연결은 줄 전체(마우스 올리면 지도 핀 강조) -->
<article data-name={l.name} data-map-id={mapped ? l.id : undefined} data-f24={is24hLot(l) ? '1' : ''} data-free={l.fee.type === 'free' ? '1' : ''} data-hours={JSON.stringify(lotHours(l))} data-fee2={Number.isFinite(sortValue(two)) ? sortValue(two) : ''} data-fees={JSON.stringify(fees)} class="lot v-row">
  <div class="t">
    <H class="contents"><a href={lotPath(l)} class="n">{l.name}</a></H>
    <span class="s"><span class="p-open badge invisible bg-off-bg text-off">운영시간 확인 중</span> 평일 {dayText(l, 'weekday')} · {l.kind === 'private' ? '민영 ' : ''}{LOT_TYPE[l.lotType]}{l.spaces !== null && ` · ${l.spaces}면`}</span>
    <span class="s truncate">{l.roadAddress || l.jibunAddress}</span>
  </div>
  <div class="val">
    <span class={`p-fee ${l.fee.type === 'free' ? 'text-ok' : two.status === 'ok' ? '' : 'text-ink-3 text-[length:calc(15px*var(--fs,1))]'}`}>{l.fee.type === 'free' ? '무료' : two.status === 'none' ? '요금 정보 없음' : feeText(two)}</span>
    {l.fee.type !== 'free' && two.status !== 'none' && <small><span class="p-dur">2시간</span> · {FEE_LABEL[l.fee.type]}</small>}
  </div>
  <Icon name="chevron-right" size={18} class="chev" />
</article>
