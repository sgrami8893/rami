---
// 목록용 3줄 행 (3차 개편): 카드 박스·테두리 없이 여백(상하 18px)으로만 구분한다.
// 1줄: 기기명 + 운영 상태 배지 / 2줄: 오늘 기준 시간(JS가 "오늘 22:00까지"로 바꿈) · 법원 발급 서류 / 3줄: 주소 + 길찾기
// 네이버 지도·주소 복사·전체 서류는 상세 페이지로 옮겼다. 행 전체가 상세 링크(stretched link), 길찾기만 따로 동작.
import { hoursLine, kakaoTo, kakaoSearch } from '../lib/format.ts';
import { kioskPath, type Kiosk } from '../lib/data.ts';
interface Props { k: Kiosk; note?: string }
const { k, note } = Astro.props;
const reg = k.docs.includes('registry'), fam = k.docs.includes('family');
const keyDocs = reg && fam ? '등기부·가족관계' : reg ? '등기부등본' : fam ? '가족관계증명서' : '';
const weekendOrHoliday = k.openSat || k.openSun || k.openHoliday;
const kakao = k.lat !== null && k.lng !== null ? kakaoTo(k.name, k.lat, k.lng) : kakaoSearch(k.roadAddress);
// 도로명주소 괄호에 상세위치가 이미 있으면 다시 붙이지 않는다
const addr = k.locationDetail && !k.roadAddress.includes(k.locationDetail) ? `${k.roadAddress} · ${k.locationDetail}` : k.roadAddress;
const hours = k.hoursConfidence === 'unknown' ? '운영시간 확인 필요' : hoursLine(k.hours);
---
<article
  class="kiosk relative -mx-5 px-5 py-[18px] transition-colors active:bg-subtle lg:-mx-3 lg:rounded-xl lg:px-3 lg:hover:bg-subtle"
  data-id={k.id}
  data-hours={JSON.stringify(k.hours)}
  data-conf={k.hoursConfidence}
  data-f24h={k.is24h ? '1' : ''}
  data-fweekend={weekendOrHoliday ? '1' : ''}
  data-fregistry={reg ? '1' : ''}
  data-ffamily={fam ? '1' : ''}
  data-dong={k.dong ?? ''}
  data-subgu={k.subGu ?? ''}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="min-w-0 text-[18px] font-semibold leading-snug text-ink">
      <a href={kioskPath(k)} class="after:absolute after:inset-0 after:content-['']">{k.name}</a>
    </h3>
    <span class="open-badge badge invisible mt-0.5 shrink-0 bg-off-bg text-off">운영시간 내</span>
  </div>
  <p class="mt-1 truncate text-body leading-6">
    <span class="rel-time font-medium text-ink" data-default={hours}>{hours}</span>{k.hoursConfidence === 'partial' && <span class="ml-1 text-cap text-warn">휴일 미확인</span>}{keyDocs && <span class="text-ink-2"> · {keyDocs}</span>}
  </p>
  <div class="mt-1 flex items-center gap-3">
    <p class="min-w-0 flex-1 truncate text-[14px] leading-5 text-ink-3">{addr}</p>
    <a href={kakao} target="_blank" rel="noopener noreferrer" class="relative z-10 -my-2 -mr-2 flex min-h-11 shrink-0 items-center px-2 text-[14px] font-semibold text-brand" aria-label={`${k.name} 카카오맵 길찾기`}>길찾기</a>
  </div>
  {note && <p class="mt-1 text-cap font-medium text-ok">{note}</p>}
</article>
