---
// Tabler Icons 인라인 SVG 아이콘 (MIT). 장식용이면 aria-hidden, 의미가 있으면 label 지정.
import { ICONS, type IconName } from '../lib/icons.ts';
interface Props { name: IconName; size?: number; class?: string; label?: string; stroke?: number }
const { name, size = 18, class: cls = '', label, stroke = 2 } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" class={`shrink-0 ${cls}`}
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })} set:html={ICONS[name]} />
