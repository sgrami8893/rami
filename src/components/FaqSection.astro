---
import type { Faq } from '../lib/faq.ts';
import Icon from './Icon.astro';
interface Props { title: string; items: Faq[]; flat?: boolean }
const { title, items, flat = false } = Astro.props;
---
<section class={flat ? 'py-8' : 'mt-10'}>
  <h2 class="mb-3 text-h2 font-bold text-ink">{title}</h2>
  <div class={flat ? 'divide-y divide-line' : 'card divide-y divide-line px-5 py-1'}>
    {items.map((f) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-3 text-body font-semibold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
          <span><span class="mr-1 text-brand">Q.</span>{f.q}</span>
          <Icon name="chevron-right" size={18} class="mt-0.5 text-ink-3 transition-transform group-open:rotate-90" />
        </summary>
        <p class="mt-2 text-body text-ink-2">{f.a}</p>
      </details>
    ))}
  </div>
</section>
