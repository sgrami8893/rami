---
// 지도 패널 v2 (2026-11-26 PC 지도 2단 개편). BaseLayout의 'map' 슬롯에 넣는다: <MapPanel slot="map" ... />
// - PC(1024px+): 오른쪽 큰 지도. 헤더 아래 화면 높이에 고정(sticky)되고 왼쪽 패널만 스크롤된다.
// - 모바일: 처음엔 숨어 있고, 본문의 '지도로 보기'(MapButton)나 목록의 '지도' 버튼으로 전체 화면 대화상자로 연다.
// - Leaflet(BSD-2) + Leaflet.markercluster(MIT)를 우리 번들에서 늦게 불러온다(외부 스크립트·쿠키 없음, 바깥 요청은 타일 이미지뿐).
// - 배경지도 타일은 브라우저가 제공처에서 직접 받는다(저장·캐시·프록시 없음, VWorld 약관 19조 6항). 출처 표기는 항상 보인다.
// - 내 위치(GPS)는 쓰지 않는다. 지도 범위는 핀들의 경계에 맞춘다.
import { MAP } from '../config.ts';
import { validPoints, type MapPoint } from '../lib/map.ts';
import Icon from './Icon.astro';
import { hasArea } from '../lib/area-geo.ts';
import MapTools from './MapTools.astro';
import RegionChips from './RegionChips.astro';
import type { ToolKey } from '../lib/map-tools.ts';

export type { MapPoint };
// area: 이 페이지의 지역(시·도 slug, 시·군·구 slug, 동 이름). 경계 자료가 있으면 지도에 지역 틀을 그린다(src/scripts/map-frame.ts)
// tool·nav·filters(2026-11-26 '주차장도 전월세 지도와 같은 구성'): 지도 위 도구 막대 = 도구 전환(PC) + 지역 칩 + 조건 토글(목록 버튼을 대신 누름)
interface Props { points: MapPoint[]; label: string; missing?: number; area?: { sido: string; sigungu?: string; dong?: string }
  tool?: ToolKey; nav?: unknown; filters?: { key: string; label: string }[] }
const { points, label, missing = 0, area, tool, nav, filters = [] } = Astro.props;
const areaData = area && hasArea(area.sido, area.sigungu) ? JSON.stringify({ sido: area.sido, sgg: area.sigungu ? `${area.sido}__${area.sigungu}` : undefined, dong: area.dong }) : undefined;
const valid = validPoints(points);
const show = MAP.enabled && valid.length > 0;
const cfg = { url: MAP.url, attribution: MAP.attribution, maxZoom: MAP.maxZoom };
const link = 'inline-flex min-h-11 items-center px-1 text-cap font-semibold text-brand hover:underline';
---
{show && (
  <section id="map-pane" class="map-pane" aria-label={`${label} 지도`} data-label={`${label} 지도`}>
    <!-- 모바일 전체 화면일 때만 보이는 윗줄 -->
    <div class="map-bar flex h-14 shrink-0 items-center gap-2 border-b border-line bg-card px-3 lg:hidden">
      <h2 class="min-w-0 flex-1 truncate pl-1 text-body font-bold text-ink">{label} 지도</h2>
      <button type="button" data-map-close class="flex h-11 shrink-0 items-center gap-1 rounded-xl bg-bg px-3 text-[length:calc(16px*var(--fs,1))] font-semibold text-ink">
        <Icon name="list" size={18} />목록으로
      </button>
    </div>
    <div class="relative min-h-0 flex-1">
      <div class="map-canvas absolute inset-0" data-points={JSON.stringify(valid)} data-cfg={JSON.stringify(cfg)} data-area={areaData}>
        <p class="map-loading flex h-full items-center justify-center text-cap text-ink-3">지도 불러오는 중</p>
      </div>
      <div class="map-card map-float absolute inset-x-3 bottom-9 z-[1000] p-4 lg:inset-x-auto lg:left-3 lg:w-[360px]" role="region" aria-label="선택한 곳 요약" hidden>
        <button type="button" class="map-card-close absolute right-2 top-2 flex size-11 items-center justify-center rounded-full text-ink-3 hover:bg-bg" aria-label="요약 닫기"><Icon name="x" size={20} /></button>
        <p class="map-card-badge pr-10 text-cap font-semibold text-brand"></p>
        <p class="map-card-name pr-10 text-body font-bold leading-snug text-ink"></p>
        <p class="map-card-meta mt-0.5 text-cap text-ink-2"></p>
        <p class="map-card-addr mt-0.5 break-words text-cap text-ink-3"></p>
        <div class="mt-1 flex flex-wrap items-center gap-x-3">
          <a class={`map-card-kakao ${link}`} target="_blank" rel="noopener noreferrer">카카오맵<span class="sr-only">(새 창)</span></a>
          <a class={`map-card-naver ${link}`} target="_blank" rel="noopener noreferrer">네이버 지도<span class="sr-only">(새 창)</span></a>
          <button type="button" class={`map-card-copy ${link}`}><span>주소 복사</span></button>
        </div>
        <a class="map-card-link mt-2 flex h-11 items-center justify-center rounded-xl bg-brand text-[length:calc(17px*var(--fs,1))] font-semibold text-white hover:brightness-95">상세 보기</a>
      </div>
      {(tool || nav) && (
        <div class="map-toolbar pointer-events-none absolute left-3 right-[60px] top-3 z-[1000] flex flex-wrap items-start gap-2">
          {tool && <MapTools current={tool} sido={area?.sido} sgg={area?.sigungu} />}
          {nav && <RegionChips data={nav} />}
          {filters.length > 0 && (
            <div class="map-filts map-float pointer-events-auto flex items-center gap-0.5 rounded-[14px] p-1" role="group" aria-label="지도 조건" hidden>
              {filters.map((f) => <button type="button" class="map-filt" data-proxy={f.key} aria-pressed="false" hidden>{f.label}</button>)}
            </div>
          )}
        </div>
      )}
      <p class="map-filter-note pointer-events-none absolute left-1/2 top-3 z-[1000] -translate-x-1/2 rounded-full bg-[#191F28]/90 px-3.5 py-1.5 text-cap font-semibold text-white shadow-lg" data-off={filters.length > 0 ? '1' : undefined} hidden></p>
    </div>
    <p class="map-note shrink-0 border-t border-line bg-card px-4 py-2 text-[length:calc(14px*var(--fs,1))] text-ink-3">
      <span class="map-count">{valid.length}곳 표시</span>{missing > 0 && ` · ${missing}곳은 좌표가 없어 목록에만 있어요`}{MAP.name && <> · 배경지도 {MAP.policyUrl ? <a href={MAP.policyUrl} class="underline" target="_blank" rel="noopener noreferrer">{MAP.name}</a> : MAP.name} 오픈플랫폼 이용</>}
    </p>
  </section>
)}

<script>
  import { initMapPanels } from '../scripts/map-panel.ts';
  initMapPanels();
</script>
