---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../config.ts';
---
<BaseLayout title={`문의 | ${SITE_NAME}`} description={`${SITE_NAME} 문의 안내`}>
  <h1 class="text-xl font-bold">문의</h1>
  <p class="mt-3 text-slate-700">서비스 문의: {CONTACT_EMAIL}</p>
  <p class="mt-2 text-slate-700">특정 기기의 정보 오류는 해당 기기 상세 페이지의 '정보 오류 제보'를 이용해 주세요. 민원 서류 발급 자체에 관한 문의는 각 기기의 관리기관으로 해 주세요.</p>
</BaseLayout>
