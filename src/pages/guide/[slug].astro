---
// 생활 정보 가이드(전월세·주차). 무인발급기 가이드는 /muin/guide/ 에 따로 있다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LIFE_GUIDES, lifePath, LIFE_BASE, type LifeGuide } from '../../lib/guides-life.ts';
import { breadcrumb, article } from '../../lib/jsonld.ts';
import { SITE_NAME } from '../../config.ts';
export function getStaticPaths() { return LIFE_GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props as { g: LifeGuide };
const abs = (p: string) => new URL(p, Astro.site).href;
const crumbs = [{ name: '홈', href: '/' }, { name: '생활 가이드', href: LIFE_BASE }, { name: g.title, href: lifePath(g) }];
const blocks = g.blocks(); // set:html 은 직접 쓴 가이드 문장에만
const others = LIFE_GUIDES.filter((o) => o.slug !== g.slug);
---
<BaseLayout tool={g.tool} title={g.title} description={g.description} crumbs={crumbs}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))), article({ headline: g.title, description: g.description, url: abs(lifePath(g)), published: g.published, modified: g.modified, publisher: SITE_NAME, citations: g.sources.map((s) => s.url) })]}>
  <article class="text-body text-ink-2 [&_p_a]:font-semibold [&_p_a]:text-brand [&_li_a]:font-semibold [&_li_a]:text-brand">
    <p class="v-cap" style="margin-top:0"><a href={LIFE_BASE}>생활 가이드</a></p>
    <h1 class="v-h1">{g.title}</h1>
    <p class="mt-1 text-cap text-ink-3">작성 {g.published} · 최종 수정 {g.modified} · {SITE_NAME}</p>
    <p class="mt-4 rounded-2xl bg-bg p-4 font-semibold text-ink">{g.summary}</p>
    {blocks.map((b) => (
      <section class="border-t border-line py-6 first-of-type:mt-4">
        <h2 class="mb-1 text-h2 font-bold text-ink">{b.h2}</h2>
        {b.p?.map((t) => <p class="mt-2" set:html={t} />)}
        {b.ul && <ul class="mt-2 list-disc space-y-1 pl-5 marker:text-ink-3">{b.ul.map((t) => <li set:html={t} />)}</ul>}
      </section>
    ))}
    <section class="rounded-2xl bg-bg p-5 text-cap text-ink-3">
      <h2 class="mb-1 text-body font-bold text-ink-2">출처</h2>
      <ul class="list-disc space-y-1 pl-5">{g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center underline">{s.name}</a>{s.note && ` (${s.note})`}</li>)}</ul>
      <p class="mt-3">이 글은 법령과 공식 안내를 정리한 일반 정보이고 법률 자문이 아니에요. 법령과 금리는 바뀔 수 있으니 최종 확인은 원문과 관계 기관에 해 주세요.</p>
    </section>
  </article>
  <section class="pt-8">
    <h2 class="mb-1 text-h2 font-bold text-ink">다른 가이드</h2>
    <ul class="divide-y divide-line">
      {others.map((o) => <li><a href={lifePath(o)} class="flex min-h-[48px] items-center justify-between gap-2 py-3 text-body font-medium text-ink hover:text-brand">{o.title}<span class="text-ink-3">›</span></a></li>)}
      <li><a href="/muin/guide/" class="flex min-h-[48px] items-center justify-between gap-2 py-3 text-body font-medium text-ink hover:text-brand">무인민원발급기 이용 가이드<span class="text-ink-3">›</span></a></li>
    </ul>
  </section>
</BaseLayout>
