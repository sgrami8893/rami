---
// /rent/ 첫 화면. 실데이터가 있고 공개(TOOLS rent 'live')이거나 미리보기(RENT_PREVIEW=1) 빌드에서만 생성된다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MockBanner from '../../components/rent/MockBanner.astro';
import { RENT_SOURCES, IS_MOCK, HAS_PAGES, SIDOS, sidoName, sigunguOf, rentPath, periodText, stats } from '../../lib/rent.ts';
import { sigunguAreas } from '../../../scripts/lib/rent.ts';
export function getStaticPaths() { return HAS_PAGES ? [{ params: { index: undefined } }] : []; }
const total = sigunguAreas(stats).reduce((s, a) => s + a.n, 0);
const crumbs = [{ name: '홈', href: '/' }, { name: '빌라·오피스텔 전월세', href: '/rent/' }];
---
<BaseLayout title="동네 빌라·오피스텔 전월세 실거래 시세 | 서울·경기·인천" description={`서울·경기·인천 빌라(연립·다세대)·오피스텔 전월세 실거래 ${total.toLocaleString('ko-KR')}건(${periodText()})을 시·군·구와 동네별로 정리했어요. 전세·월세 중위값과 면적대별 시세, 중개보수·전환 계산기를 볼 수 있어요.`} crumbs={crumbs} noindex={IS_MOCK} tool="rent" sidebar={false} sources={RENT_SOURCES}>
  {IS_MOCK && <MockBanner />}
  <h1 class="text-title font-bold text-ink">동네 빌라·오피스텔 전월세 실거래</h1>
  <p class="mt-1 text-body text-ink-2">{periodText()} 신고된 전월세 거래를 동네별로 모았어요. 아파트는 다루지 않아요.</p>
  {SIDOS.map((s) => (
    <section class="mt-6" aria-labelledby={`h-${s}`}>
      <h2 id={`h-${s}`} class="text-h2 font-bold text-ink"><a href={rentPath(s)} class="hover:text-brand">{sidoName(s)}</a></h2>
      <div class="mt-2 flex flex-wrap gap-2">
        {sigunguOf(s).map((a) => <a href={rentPath(s, a.sigungu)} class="flex min-h-11 items-center gap-1 rounded-xl bg-bg px-3 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">{a.sigunguName}<span class="text-ink-3">{a.n}건</span></a>)}
      </div>
    </section>
  ))}
</BaseLayout>
