---
// 동 페이지(골격): 최근 12개월 거래 PAGE_MIN건 이상인 법정동만 생성. 색인은 INDEX_MIN건 이상 + 시·군·구의 90% 이하(scripts/lib/rent.ts RENT_RULE)
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../../components/rent/MockBanner.astro';
import RentSummary from '../../../../../components/rent/RentSummary.astro';
import RentCalculator from '../../../../../components/rent/RentCalculator.astro';
import RentNotes from '../../../../../components/rent/RentNotes.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import { RENT_SOURCES, stats, DONG_PAGES, sidoShort, dongsOf, hasDongPage, rentPath, periodText, dongIndexable, IS_MOCK, type RentArea } from '../../../../../lib/rent.ts';
import { manwon } from '../../../../../../scripts/lib/rent.ts';
import type { SidoSlug } from '../../../../../../scripts/lib/regions.ts';
export function getStaticPaths() { return DONG_PAGES.map((a) => ({ params: { sido: a.sido, sigungu: a.sigungu, dong: a.dong! }, props: { a } })); }
const { a } = Astro.props as { a: RentArea };
const sido = a.sido as SidoSlug, dong = a.dong!;
const v = a.byType.villa, o = a.byType.officetel;
const main = v && (!o || v.n >= o.n) ? v : o;
const sg = stats.areas.find((x) => x.dong === null && x.sido === a.sido && x.sigungu === a.sigungu)!;
const sgMed = sg.byType.villa?.jeonse?.median ?? null;
const others = dongsOf(sido, a.sigungu).filter((d) => d.dong !== dong && hasDongPage(d));
const crumbs = [{ name: '홈', href: '/' }, { name: '빌라·오피스텔 전월세', href: '/rent/' }, { name: sidoShort(sido), href: rentPath(sido) }, { name: a.sigunguName, href: rentPath(sido, a.sigungu) }, { name: dong, href: rentPath(sido, a.sigungu, dong) }];
---
<BaseLayout title={`${a.sigunguName} ${dong} 빌라·오피스텔 전월세 실거래 시세 | 최근 12개월 ${a.n}건`} description="골격 미리보기" crumbs={crumbs} noindex={IS_MOCK || !dongIndexable(stats, a)} sidebar={false} sources={RENT_SOURCES}>
  {IS_MOCK && <MockBanner />}
  <h1 class="text-title font-bold text-ink">{a.sigunguName} {dong} 빌라·오피스텔 전월세</h1>
  <p class="mt-1 text-cap text-ink-3">{periodText()} 실거래 {a.n}건 · 빌라 {v?.n ?? 0}건 · 오피스텔 {o?.n ?? 0}건 · 법정동 기준</p>
  {v?.jeonse && sgMed !== null && <p class="mt-3 rounded-2xl bg-bg px-4 py-3 text-body text-ink-2">빌라 전세 중위값은 {dong} {manwon(v.jeonse.median)}, {a.sigunguName} 전체 {manwon(sgMed)}이에요.</p>}
  <RentSummary a={a} place={dong} />
  <RentCalculator deposit={main?.jeonse?.median ?? 10000} officetel={main === o} />
  <AdSlot name="A" />
  <nav aria-labelledby="more-h" class="mt-8">
    <h2 id="more-h" class="text-h2 font-bold text-ink">더 찾아보기</h2>
    <a href={rentPath(sido, a.sigungu)} class="mt-3 flex min-h-11 items-center rounded-xl bg-bg px-4 text-body font-semibold text-ink-2 hover:text-brand">{a.sigunguName} 전체 보기</a>
    {others.length > 0 && <div class="mt-3 flex flex-wrap gap-2">{others.map((d) => <a href={rentPath(sido, a.sigungu, d.dong)} class="flex min-h-11 items-center gap-1 rounded-xl bg-bg px-3 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">{d.dong}<span class="text-ink-3">{d.n}건</span></a>)}</div>}
  </nav>
  <RentNotes />
</BaseLayout>
