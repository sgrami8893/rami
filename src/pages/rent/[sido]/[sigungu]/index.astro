---
// 전월세 시·군·구(v2): "이 지역 안에서 어디가 싸고 어디가 비싸요?" ① 위치 줄 ② 답 카드 ③ [빌라|오피스텔][전세|월세] + 동 목록(거래 많은 순) ④ 접힘.
import Near from '../../../../components/v2/Near.astro';
import { rentOg } from '../../../../lib/og.ts';
import RentSummary from '../../../../components/rent/RentSummary.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../components/rent/MockBanner.astro';
import MapView from "../../../../components/v2/MapView.astro";
import RentNotes from '../../../../components/rent/RentNotes.astro';
import RentBands from '../../../../components/rent/RentBands.astro';
import PlaceBar from '../../../../components/v2/PlaceBar.astro';
import RentMode from '../../../../components/v2/RentMode.astro';
import RentAnswer from '../../../../components/v2/RentAnswer.astro';
import RentRow from '../../../../components/v2/RentRow.astro';
import VList from '../../../../components/v2/VList.astro';
import Fold from '../../../../components/v2/Fold.astro';
import MapPill from '../../../../components/v2/MapPill.astro';
import { RENT_MAP, RENT_SOURCES, stats, dongsOf, hasDongPage, rentPath, subGuText, sigunguIndexable, IS_MOCK, rentDescription, type RentArea } from '../../../../lib/rent.ts';
import { rentPlace } from '../../../../lib/rent-view.ts';
import { LOW_N } from '../../../../lib/rent-geo.ts';
import { sigunguAreas } from '../../../../../scripts/lib/rent.ts';
import { SIDO, type SidoSlug } from '../../../../../scripts/lib/regions.ts';
export function getStaticPaths() { return sigunguAreas(stats).map((a) => ({ params: { sido: a.sido, sigungu: a.sigungu }, props: { a } })); }
const { a } = Astro.props as { a: RentArea };
const sido = a.sido as SidoSlug;
const dongs = dongsOf(sido, a.sigungu);
const main = dongs.filter((d) => d.n >= LOW_N);
const few = dongs.filter((d) => d.n < LOW_N);
const crumbs = [{ name: '홈', href: '/' }, { name: '전월세', href: '/rent/' }, { name: SIDO[sido].aliases[0], href: rentPath(sido) }, { name: a.sigunguName, href: rentPath(sido, a.sigungu) }];
---
<BaseLayout title={`${a.sigunguName} 빌라·오피스텔 전월세 실거래 시세 ${a.n}건 | 동별 전세·월세`} description={rentDescription(a.sigunguName, a)} crumbs={crumbs} noindex={IS_MOCK || !sigunguIndexable(a)} tool="rent" ogImage={rentOg(a.sido, a.sigungu)} sources={RENT_SOURCES}>
  {IS_MOCK && <MockBanner />}
  <PlaceBar levels={rentPlace(sido, a.sigungu)} />
  <h1 class="v-h1">{a.sigunguName}{subGuText(sido, a.sigungu)} 빌라·오피스텔 전월세</h1>
  <Near class="mt-2" tool="rent" />
  <RentMode class="mt-3" />
  <RentAnswer a={a} />
  <VList label={`${a.sigunguName} 동별 전월세 중위값`} count={`동 ${main.length}곳`} sorts={[{ v: 'n', label: '거래 많은 순' }, { v: 'lo', label: '낮은 순' }, { v: 'hi', label: '높은 순' }, { v: 'nm', label: '이름순' }]}>
    {main.map((d) => <RentRow a={d} name={d.dong!} href={hasDongPage(d) ? rentPath(sido, a.sigungu, d.dong) : null} />)}
  </VList>
  <RentSummary a={a} place={a.sigunguName} dongs={dongs} />
  <div class="v-folds">
    {few.length > 0 && (
      <Fold title={`거래 ${LOW_N}건 미만인 동 ${few.length}곳`}>
        <p>거래가 적으면 중위값이 크게 흔들려서 숫자를 비교하지 않아요.</p>
        <ul class="mt-2 flex flex-wrap gap-2">{few.map((d) => <li>{hasDongPage(d) ? <a class="v-chip" href={rentPath(sido, a.sigungu, d.dong)}>{d.dong} <small class="text-ink-3">{d.n}건</small></a> : <span class="v-chip">{d.dong} <small class="text-ink-3">{d.n}건</small></span>}</li>)}</ul>
      </Fold>
    )}
    <Fold title="면적별 중위값"><RentBands a={a} /></Fold>
    <RentNotes />
  </div>
  <MapPill />
  {RENT_MAP && <MapView slot="map" kind="rent" focus={{ sido, slug: a.sigungu }} title={`${a.sigunguName} 전월세 지도`} />}
</BaseLayout>
