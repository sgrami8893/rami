---
// 허브 v2(2026-11-26 'UX 처음부터'): 찾기(검색 시트) · 도구 카드 3개(전월세 먼저) · 자주 찾는 지역 · 가이드(접힘). PC는 오른쪽에 수도권 전월세 지도.
// 옛 설명: 허브는 도구 목록만 둔다. 도구별 콘텐츠·내부 링크·사이트맵은 각 하위 폴더(/muin/ …)에서 독립적으로 관리.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL, TOOLS } from '../config.ts';
import { lots as parkingLots, SIDOS as PARKING_SIDOS, regionsOf as parkingRegionsOf, parkingPath } from '../lib/parking.ts';
import { SIGUNGU } from '../../scripts/lib/regions.ts';
import { stats as rentStats, HAS_PAGES as rentReady, IS_MOCK as rentMock, RENT_RULE, SIDOS as RENT_SIDOS, sigunguOf as rentSigunguOf, rentPath } from '../lib/rent.ts';
import { kiosks, stats, regionsIn, SIDO_ORDER, sidoShort, regionPath, subGuOf } from '../lib/data.ts';
import GuideList from '../components/GuideList.astro';
import MapView from '../components/v2/MapView.astro';
import MapPill from '../components/v2/MapPill.astro';
import Fold from '../components/v2/Fold.astro';
import Near from '../components/v2/Near.astro';
import { MAP } from '../config.ts';

import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons.ts';
const ICON: Record<string, IconName> = { muin: 'file-text', waste: 'trash-2', parking: 'square-parking', rent: 'building', cert: 'award' };

const n = (x: number) => x.toLocaleString('ko-KR');
const rentTotal = rentStats.areas.filter((a) => a.dong === null).reduce((s, a) => s + a.n, 0);
const rentDongs = rentStats.areas.filter((a) => a.dong !== null && a.n >= RENT_RULE.PAGE_MIN).length;
// 도구 카드 2줄 규격(2026-11-26 제미나이 검수): 1줄 핵심 수치 + 2줄 대표 조건 2개. 세 카드 높이를 같게 맞춘다
const counts: Record<string, string> = { muin: `수도권 ${n(kiosks.length)}곳`, ...(parkingLots.length ? { parking: `수도권 ${n(parkingLots.length)}곳` } : {}), ...(rentReady && !rentMock ? { rent: `최근 12개월 실거래 ${n(rentTotal)}건` } : {}) };
// 2026-11-26 전월세 중심 전환(사용자·제미나이 합의): 홈의 '찾을 정보' 기본값과 도구 카드 순서를 전월세 → 주차장 → 무인발급기로
const HOME_ORDER = ['rent', 'parking', 'muin'];
const rank = (s: string) => (HOME_ORDER.indexOf(s) + 1 || 99);
const live = TOOLS.filter((t) => t.status === 'live').sort((a, b) => rank(a.slug) - rank(b.slug));
// 검색용: 시·군·구 67곳을 HTML에 내장(JS 없이도 '전체 지역'에서 링크로 이동 가능)
// 2026-11-26 재배치: 지역 검색이 무인발급기 하나로 고정되지 않게, 시·군·구마다 세 도구 주소를 함께 싣고 위의 '찾을 정보' 선택으로 바꾼다
type R = { sido: (typeof SIDO_ORDER)[number]; sigungu: string; sigunguName: string; href: Partial<Record<'muin' | 'parking' | 'rent', string>> };
const regionMap = new Map<string, R>();
const put = (sido: R['sido'], sigungu: string, tool: keyof R['href'], href: string) => {
  const k = `${sido}/${sigungu}`;
  const r = regionMap.get(k) ?? { sido, sigungu, sigunguName: SIGUNGU[sido].find((x) => x.slug === sigungu)?.name ?? sigungu, href: {} };
  r.href[tool] = href; regionMap.set(k, r);
};
SIDO_ORDER.forEach((s) => regionsIn(s).forEach((r) => put(s, r.sigungu, 'muin', regionPath(s, r.sigungu))));
if (live.some((t) => t.slug === 'parking')) PARKING_SIDOS.forEach((s) => parkingRegionsOf(s).forEach((r) => put(s, r.sigungu, 'parking', parkingPath(s, r.sigungu))));
if (live.some((t) => t.slug === 'rent') && rentReady) RENT_SIDOS.forEach((s) => rentSigunguOf(s).forEach((r) => put(s, r.sigungu, 'rent', rentPath(s, r.sigungu))));
const allRegions = SIDO_ORDER.flatMap((s) => [...regionMap.values()].filter((r) => r.sido === s).sort((a, b) => a.sigunguName.localeCompare(b.sigunguName, 'ko')));
const PICK = live.map((t) => ({ slug: t.slug as 'muin' | 'parking' | 'rent', label: ({ muin: '무인발급기', parking: '주차장', rent: '전월세' } as Record<string, string>)[t.slug] ?? t.name }));
const DEF = PICK[0]?.slug ?? 'muin'; // 처음 선택된 도구(전월세). JS가 없을 때도 링크가 이 도구로 간다
const defHref = (r: R) => r.href[DEF] ?? r.href.muin ?? Object.values(r.href)[0];
const hrefAttrs = (r: R) => Object.fromEntries(Object.entries(r.href).map(([k, v]) => [`data-href-${k}`, v]));
// 모바일 390px 한 줄에 들어가는 5개: 서울·경기·인천 균형
const QUICK = ['seoul/gangnam-gu', 'gyeonggi/seongnam-si', 'gyeonggi/suwon-si', 'gyeonggi/anyang-si', 'incheon/bupyeong-gu'];
// 생활권 별칭: 시·군·구 이름이 아닌 동네 이름으로 찾는 경우(분당·일산·영통처럼 일반구 이름은 이미 검색 키에 있음)
const ALIAS: Record<string, string> = {
  'gyeonggi/seongnam-si': '판교 위례', 'gyeonggi/hwaseong-si': '동탄 봉담', 'gyeonggi/suwon-si': '광교',
  'gyeonggi/anyang-si': '평촌', 'gyeonggi/gunpo-si': '산본', 'gyeonggi/hanam-si': '미사 위례', 'gyeonggi/namyangju-si': '다산 별내',
  'gyeonggi/paju-si': '운정', 'gyeonggi/goyang-si': '일산 삼송 원흥', 'gyeonggi/yongin-si': '수지 기흥 처인', 'gyeonggi/gimpo-si': '한강신도시',
  'seoul/songpa-gu': '위례 잠실', 'incheon/yeonsu-gu': '송도', 'incheon/seohae-gu': '청라 서구', 'incheon/geomdan-gu': '서구',
  'incheon/michuhol-gu': '남구', 'incheon/jemulpo-gu': '중구 동구', 'incheon/yeongjong-gu': '영종도',
};
const quick = QUICK.map((key) => regionMap.get(key)).filter((r) => r !== undefined);
const sum = (f: (k: (typeof kiosks)[number]) => boolean) => kiosks.filter(f).length;
const features: Record<string, { icon: IconName; label: string }[]> = {
  muin: [{ icon: 'clock', label: `24시간 ${n(sum((k) => k.is24h))}곳` }, { icon: 'file-text', label: `등기부 ${n(sum((k) => k.docs.includes('registry')))}곳` }],
  parking: [{ icon: 'square-parking', label: `무료 ${n(parkingLots.filter((l) => l.fee.type === 'free').length)}곳` }, { icon: 'clock', label: '2시간 요금 비교' }],
  rent: [{ icon: 'map-pin', label: `동네 ${n(rentDongs)}곳` }, { icon: 'file-text', label: '중개보수·전환 계산기' }],
};
// 2026-11-26 PC 홈 = 전월세 지도 화면(사용자·제미나이 합의): 1024px+ 왼쪽 400px 패널(지금 홈 내용 그대로) + 오른쪽 전월세 단계구분도.
// 모바일은 카드 홈 그대로 + '전월세 지도로 보기' 버튼(전체 화면). 홈 HTML 본문은 그대로라 검색엔진에는 변화 없음.
const rentMap = MAP.enabled && rentReady && live.some((t) => t.slug === 'rent');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/` }];
---
<BaseLayout title={`${SITE_NAME} | 전월세·주차장·발급기, 우리 동네 생활 정보 한눈에`} description={`서울·경기·인천 빌라·오피스텔 전월세 실거래 ${n(rentTotal)}건, 공영주차장 ${n(parkingLots.length)}곳, 무인민원발급기 ${n(kiosks.length)}곳을 지역별로 모아 보여 주는 민간 생활 정보 서비스예요.`} jsonld={jsonld} tool={undefined}>
  <p class="v-eyebrow mt-1"><Icon name="map-pin" size={14} />서울·경기·인천</p>
  <h1 class="v-h1 mt-2">우리 동네 생활 정보,<br class="sm:hidden" /> <span class="hl">한눈에</span> 찾아요</h1>
  <button type="button" class="v-search-big mt-4" data-sheet-open aria-haspopup="dialog"><Icon name="search" size={20} />동네·지역 이름으로 찾기</button>
  <Near auto />
  <h2 class="v-sec">무엇을 찾을까요</h2>
  <div class="grid gap-2">
    {live.map((t) => (
      <a href={t.path} class="v-tool" data-t={t.slug}>
        <span class="ic" aria-hidden="true"><Icon name={ICON[t.slug] ?? 'map-pin'} size={22} /></span>
        <span class="t"><b>{({ rent: '빌라·오피스텔 전월세', parking: '공영주차장', muin: '무인민원발급기' } as Record<string, string>)[t.slug] ?? t.name}</b>
          <span><span class="num">{counts[t.slug]}</span>{features[t.slug] && <span class="ft">{features[t.slug].map((f) => f.label).join(' · ')}</span>}</span></span>
        <Icon name="chevron-right" size={18} class="chev" />
      </a>
    ))}
  </div>
  {quick.length > 0 && <>
    <h2 class="v-sec" data-quick-h>자주 찾는 지역 전월세</h2>
    <ul class="flex flex-wrap gap-2" data-quick>{quick.map((r) => <li><a class="v-chip" href={r.href.rent ?? defHref(r)}>{r.sigunguName}</a></li>)}</ul>
  </>}
  <div class="v-folds">
    <Fold title="생활 정보 가이드"><GuideList flat inFold limit={4} title="자주 찾는 가이드" /></Fold>
  </div>
  {rentMap && <MapPill label="전월세 지도" />}
  {rentMap && <MapView slot="map" kind="rent" title="수도권 전월세 지도" />}
</BaseLayout>
<script>
  import { onPage } from '../scripts/soft-nav.ts';
  // 최근 본 지역(이 기기에만, PlaceBar가 저장)이 있으면 '자주 찾는 지역' 대신 먼저 보여 준다
  onPage(() => {
    const ul = document.querySelector<HTMLElement>('[data-quick]'), h = document.querySelector<HTMLElement>('[data-quick-h]');
    if (!ul || !h || ul.dataset.ready) return;
    ul.dataset.ready = '1';
    let rec: { l: string; h: string; t: string }[] = [];
    try { rec = (JSON.parse(localStorage.getItem('dnkk:recent:v1') || '[]') as typeof rec).filter((r) => r.t === 'rent' || r.t === 'parking').slice(0, 6); } catch { /* 없음 */ }
    if (!rec.length) return;
    h.textContent = '최근 본 곳';
    ul.replaceChildren(...rec.map((r) => { const li = document.createElement('li'); const a = document.createElement('a'); a.className = 'v-chip'; a.href = r.h; a.textContent = `${r.l} ${r.t === 'rent' ? '전월세' : '주차장'}`; li.append(a); return li; }));
  });
</script>
