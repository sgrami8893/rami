---
// 허브: 도구 목록만 둔다. 도구별 콘텐츠·내부 링크·사이트맵은 각 하위 폴더(/muin/ …)에서 독립적으로 관리.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_URL, TOOLS } from '../config.ts';
import { kiosks, stats, regionsIn, SIDO_ORDER, sidoShort, regionPath, subGuOf } from '../lib/data.ts';
import GuideList from '../components/GuideList.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons.ts';
const ICON: Record<string, IconName> = { muin: 'file-text', waste: 'trash-2', parking: 'square-parking', cert: 'award' };

const counts: Record<string, string> = { muin: `수도권 ${kiosks.length.toLocaleString('ko-KR')}곳` };
const live = TOOLS.filter((t) => t.status === 'live');
// 검색용: 시·군·구 67곳을 HTML에 내장(JS 없이도 '전체 지역'에서 링크로 이동 가능)
const allRegions = SIDO_ORDER.flatMap((s) => [...regionsIn(s)].sort((a, b) => a.sigunguName.localeCompare(b.sigunguName, 'ko')));
// 모바일 390px 한 줄에 들어가는 5개: 서울·경기·인천 균형
const QUICK = ['seoul/gangnam-gu', 'gyeonggi/seongnam-si', 'gyeonggi/suwon-si', 'gyeonggi/anyang-si', 'incheon/bupyeong-gu'];
// 생활권 별칭: 시·군·구 이름이 아닌 동네 이름으로 찾는 경우(분당·일산·영통처럼 일반구 이름은 이미 검색 키에 있음)
const ALIAS: Record<string, string> = {
  'gyeonggi/seongnam-si': '판교 위례', 'gyeonggi/hwaseong-si': '동탄 봉담', 'gyeonggi/suwon-si': '광교',
  'gyeonggi/anyang-si': '평촌', 'gyeonggi/gunpo-si': '산본', 'gyeonggi/hanam-si': '미사 위례', 'gyeonggi/namyangju-si': '다산 별내',
  'gyeonggi/paju-si': '운정', 'gyeonggi/goyang-si': '일산 삼송 원흥', 'gyeonggi/yongin-si': '수지 기흥 처인', 'gyeonggi/gimpo-si': '한강신도시',
  'seoul/songpa-gu': '위례 잠실', 'incheon/yeonsu-gu': '송도', 'incheon/seohae-gu': '청라 서구', 'incheon/geomdan-gu': '서구',
  'incheon/michuhol-gu': '남구', 'incheon/jemulpo-gu': '중구 동구', 'incheon/yeongjong-gu': '영종도',
};
const quick = QUICK.map((key) => stats.find((r) => `${r.sido}/${r.sigungu}` === key)).filter((r) => r !== undefined);
const sum = (f: (k: (typeof kiosks)[number]) => boolean) => kiosks.filter(f).length;
const muinStats = [
  { icon: 'clock' as const, label: `24시간 ${sum((k) => k.is24h).toLocaleString('ko-KR')}곳` },
  { icon: 'file-text' as const, label: `등기부 ${sum((k) => k.docs.includes('registry')).toLocaleString('ko-KR')}곳` },
];
const jsonld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/` }];
---
<BaseLayout title={`${SITE_NAME} | 우리 동네 무인민원발급기 운영시간·위치 찾기`} description={`서울·경기·인천 무인민원발급기 ${kiosks.length.toLocaleString('ko-KR')}곳의 운영시간과 위치, 24시간·주말 운영 기기를 지역별로 찾아보세요. 동네 생활 공공정보를 모아 보여 주는 민간 서비스입니다.`} jsonld={jsonld} sidebar>
  <section class="pt-2">
    <h1 class="text-title font-bold text-ink">우리 동네 무인민원발급기,<br class="sm:hidden" /> 지금 운영시간 바로 확인</h1>
    <form id="region-search" action="/muin/" class="mt-4" role="search" onsubmit="return false">
      <label for="q" class="sr-only">시·군·구 검색</label>
      <div class="flex h-12 items-center gap-2 rounded-2xl bg-card px-4 ring-1 ring-line focus-within:ring-2 focus-within:ring-brand">
        <input id="q" type="search" autocomplete="off" placeholder="시·군·구 이름으로 검색 (예: 강남구, 안양시)"
          class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none placeholder:text-ink-3" />
        <Icon name="search" size={20} class="text-ink-3" />
      </div>
    </form>
    <div class="scrollbar-none -mx-4 mt-3 flex gap-2 overflow-x-auto px-4">
      {quick.map((r) => <a href={regionPath(r.sido, r.sigungu)} class="shrink-0 rounded-xl border border-line bg-card px-3 py-1.5 text-[14px] font-medium text-ink-2 hover:text-brand">{r.sigunguName}</a>)}
    </div>
    <details id="all-regions" class="mt-3">
      <summary class="cursor-pointer px-1 text-cap font-semibold text-ink-3">전체 지역 보기 ({allRegions.length})</summary>
      <ul id="region-list" class="card mt-2 grid grid-cols-2 gap-x-3 gap-y-1 p-4 sm:grid-cols-3">
        {allRegions.map((r) => (
          <li data-key={`${r.sigunguName} ${sidoShort(r.sido)} ${subGuOf(r.sido, r.sigungu).join(' ')} ${ALIAS[`${r.sido}/${r.sigungu}`] ?? ''}`}>
            <a href={regionPath(r.sido, r.sigungu)} class="block rounded-lg px-2 py-1.5 text-body text-ink-2 hover:bg-bg hover:text-brand">{r.sigunguName} <span class="text-cap text-ink-3">{sidoShort(r.sido)}</span></a>
          </li>
        ))}
      </ul>
      <p id="region-empty" class="mt-2 px-1 text-cap text-ink-3" hidden>일치하는 지역이 없습니다. 현재 서울·경기·인천만 지원합니다. 시·군·구 이름(예: 분당 → 성남시)이나 동네 이름(예: 일산, 송도)으로 찾아 주세요.</p>
    </details>
  </section>

  <section class="mt-6 grid gap-3">
    {live.map((t) => (
      <a href={t.path} class="card block hover:ring-2 hover:ring-brand/20">
        <span class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-weak text-brand"><Icon name={ICON[t.slug]} size={22} /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-h2 font-bold text-ink">{t.name}</span>
            {counts[t.slug] && <span class="block text-cap text-ink-3">{counts[t.slug]}</span>}
          </span>
          <Icon name="chevron-right" size={20} class="text-ink-3" />
        </span>
        {t.slug === 'muin' && (
          <span class="mt-3 flex flex-wrap gap-x-4 gap-y-1 border-t border-line pt-3 text-cap text-ink-2">
            {muinStats.map((m) => <span class="flex items-center gap-1"><Icon name={m.icon} size={14} class="text-ink-3" />{m.label}</span>)}
          </span>
        )}
      </a>
    ))}
    <p class="px-1 text-[12px] text-ink-3">정부·지자체 공식 서비스가 아니며, 공공데이터를 정리해 보여 줍니다.</p>
  </section>

  <GuideList title="생활 정보 가이드" />
</BaseLayout>

<script>
  // 시·군·구 즉시 필터: 내장된 링크 목록을 숨김/표시만 한다(Enter는 첫 결과로 이동).
  const q = document.getElementById('q') as HTMLInputElement | null;
  const box = document.getElementById('all-regions') as HTMLDetailsElement | null;
  const items = [...document.querySelectorAll<HTMLLIElement>('#region-list li')];
  const empty = document.getElementById('region-empty');
  const norm = (s: string) => s.replace(/\s+/g, '').toLowerCase();
  q?.addEventListener('input', () => {
    const v = norm(q.value);
    let n = 0;
    for (const li of items) { const ok = !v || norm(li.dataset.key ?? '').includes(v); li.hidden = !ok; if (ok) n++; }
    if (box) box.open = v.length > 0;
    if (empty) empty.hidden = n > 0;
  });
  q?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const first = items.find((li) => !li.hidden)?.querySelector('a');
    if (first && q.value.trim()) location.href = first.href;
  });
</script>
