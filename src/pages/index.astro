---
// 허브: 도구 목록만 둔다. 도구별 콘텐츠·내부 링크·사이트맵은 각 하위 폴더(/muin/ …)에서 독립적으로 관리.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESC, SITE_URL, TOOLS } from '../config.ts';
import { kiosks } from '../lib/data.ts';
import GuideList from '../components/GuideList.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons.ts';
const ICON: Record<string, IconName> = { muin: 'file-text', waste: 'trash-2', parking: 'square-parking', cert: 'award' };

const counts: Record<string, string> = { muin: `수도권 ${kiosks.length.toLocaleString('ko-KR')}곳` };
const live = TOOLS.filter((t) => t.status === 'live');
const soon = TOOLS.filter((t) => t.status === 'soon');
const jsonld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/` }];
---
<BaseLayout title={`${SITE_NAME} | 동네 생활 공공정보 한눈에`} description={SITE_DESC} jsonld={jsonld}>
  <section class="pt-2">
    <h1 class="text-title font-bold text-ink">{SITE_NAME}</h1>
    <p class="mt-1 text-body text-ink-2">동네에서 바로 필요한 생활 공공정보를 공공데이터로 정리한 민간 정보 서비스입니다.</p>
  </section>

  <section class="mt-5 grid gap-3">
    {live.map((t) => (
      <a href={t.path} class="card flex items-center gap-4 hover:ring-2 hover:ring-brand/20">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-weak text-brand"><Icon name={ICON[t.slug]} size={24} /></span>
        <span class="min-w-0 flex-1">
          <span class="flex items-baseline justify-between gap-2">
            <span class="text-h2 font-bold text-ink">{t.name}</span>
            {counts[t.slug] && <span class="shrink-0 text-cap text-ink-3">{counts[t.slug]}</span>}
          </span>
          <span class="mt-0.5 block text-cap text-ink-2">{t.desc}</span>
        </span>
        <Icon name="chevron-right" size={20} class="text-ink-3" />
      </a>
    ))}
  </section>

  <GuideList title="생활 정보 가이드" />

  {soon.length > 0 && (
    <section class="mt-10">
      <h2 class="mb-3 px-1 text-h2 font-bold text-ink">준비 중인 도구</h2>
      <ul class="grid gap-2 sm:grid-cols-3">
        {soon.map((t) => (
          <li class="card flex items-start gap-3 p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-bg text-ink-3"><Icon name={ICON[t.slug]} size={20} /></span>
            <span><span class="block text-body font-semibold text-ink-2">{t.name}</span><span class="mt-0.5 block text-cap text-ink-3">{t.desc}</span></span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
