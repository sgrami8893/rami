---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { GUIDES, guidePath, GUIDE_BASE, type Guide } from '../../../lib/guides.ts';
import { MUIN_CRUMBS } from '../../../lib/data.ts';
import { breadcrumb, article } from '../../../lib/jsonld.ts';
import { SITE_NAME } from '../../../config.ts';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const abs = (p: string) => new URL(p, Astro.site).href;
const crumbs = [...MUIN_CRUMBS, { name: '이용 가이드', href: GUIDE_BASE }, { name: g.title, href: guidePath(g) }];
// set:html 은 직접 작성한 가이드 문장에만 쓴다(공공데이터 원문 텍스트는 넣지 않음: 숫자·고정 지역명만 보간).
const blocks = g.blocks();
const related = g.related().filter((r) => r.links.length);
const others = GUIDES.filter((o) => o.slug !== g.slug);
---
<BaseLayout tool="muin" title={g.title} description={g.description} crumbs={crumbs}
  jsonld={[
    breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))),
    article({ headline: g.title, description: g.description, url: abs(guidePath(g)), published: g.published, modified: g.modified, publisher: SITE_NAME, citations: g.sources.map((s) => s.url) }),
  ]}>
  <article class="text-body text-ink-2">
    <h1 class="text-title font-bold text-ink">{g.title}</h1>
    <p class="mt-1 text-cap text-ink-3">작성 {g.published} · 최종 수정 {g.modified} · {SITE_NAME}</p>
    {blocks.map((b, i) => (
      <>
        <section class="border-t border-line py-6 first-of-type:mt-4">
          <h2 class="mb-1 text-h2 font-bold text-ink">{b.h2}</h2>
          {b.p?.map((t) => <p class="mt-2" set:html={t} />)}
          {b.ul && <ul class="mt-2 list-disc space-y-1 pl-5 marker:text-ink-3">{b.ul.map((t) => <li set:html={t} />)}</ul>}
        </section>
        {i === 1 && <AdSlot name="A" />}
      </>
    ))}

    {related.map((r) => (
      <section class="border-t border-line py-6">
        <h2 class="mb-3 text-h2 font-bold text-ink">{r.title}</h2>
        <ul class="flex flex-wrap gap-2">
          {r.links.map((l) => (
            <li><a href={l.href} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[14px] font-medium text-ink-2 hover:text-brand">{l.label}{l.meta && <span class="ml-1 text-ink-3">· {l.meta}</span>}</a></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="rounded-2xl bg-bg p-5 text-cap text-ink-3">
      <h2 class="mb-1 text-body font-bold text-ink-2">출처</h2>
      <ul class="list-disc space-y-1 pl-5">
        {g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="underline">{s.name}</a>{s.note && ` (${s.note})`}</li>)}
      </ul>
      <p class="mt-3">이 글은 공개된 공식 안내와 공공데이터를 정리한 일반 정보입니다. 수수료·발급 시간 등은 지자체와 시기에 따라 바뀔 수 있으니 최종 확인은 관리기관에 해 주세요.</p>
    </section>
  </article>

  <AdSlot name="C" />

  <div class="band -mx-5 mt-8 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <section class="pt-7">
    <h2 class="mb-1 text-h2 font-bold text-ink">다른 가이드</h2>
    <ul class="divide-y divide-line">
      {others.map((o) => <li><a href={guidePath(o)} class="flex items-center justify-between gap-2 py-4 text-body font-medium text-ink hover:text-brand">{o.title}<span class="text-ink-3">›</span></a></li>)}
    </ul>
  </section>
</BaseLayout>
