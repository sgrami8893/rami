---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { GUIDES, guidePath, GUIDE_BASE, type Guide } from '../../../lib/guides.ts';
import { MUIN_CRUMBS } from '../../../lib/data.ts';
import { breadcrumb, article } from '../../../lib/jsonld.ts';
import { SITE_NAME } from '../../../config.ts';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const abs = (p: string) => new URL(p, Astro.site).href;
const crumbs = [...MUIN_CRUMBS, { name: '이용 가이드', href: GUIDE_BASE }, { name: g.title, href: guidePath(g) }];
// set:html 은 직접 작성한 가이드 문장에만 쓴다(공공데이터 원문 텍스트는 넣지 않음: 숫자·고정 지역명만 보간).
const blocks = g.blocks();
const related = g.related().filter((r) => r.links.length);
const others = GUIDES.filter((o) => o.slug !== g.slug);
---
<BaseLayout tool="muin" title={g.title} description={g.description} crumbs={crumbs}
  jsonld={[
    breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))),
    article({ headline: g.title, description: g.description, url: abs(guidePath(g)), published: g.published, modified: g.modified, publisher: SITE_NAME, citations: g.sources.map((s) => s.url) }),
  ]}>
  <article class="text-[15px] leading-relaxed text-slate-800">
    <h1 class="text-xl font-bold leading-snug sm:text-2xl">{g.title}</h1>
    <p class="mt-1 text-xs text-slate-500">작성 {g.published} · 최종 수정 {g.modified} · {SITE_NAME}</p>
    {blocks.map((b, i) => (
      <>
        <section class="mt-6">
          <h2 class="mb-2 text-lg font-bold">{b.h2}</h2>
          {b.p?.map((t) => <p class="mt-2" set:html={t} />)}
          {b.ul && <ul class="mt-2 list-disc space-y-1 pl-5">{b.ul.map((t) => <li set:html={t} />)}</ul>}
        </section>
        {i === 1 && <AdSlot name="A" />}
      </>
    ))}

    {related.map((r) => (
      <section class="mt-8 rounded-xl border border-slate-200 bg-white p-4">
        <h2 class="mb-2 font-bold">{r.title}</h2>
        <ul class="flex flex-wrap gap-2">
          {r.links.map((l) => (
            <li><a href={l.href} class="inline-block rounded-full border border-slate-300 px-3 py-1.5 text-sm hover:border-brand">{l.label} {l.meta && <span class="text-slate-500">· {l.meta}</span>}</a></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="mt-8 text-sm text-slate-600">
      <h2 class="mb-1 font-bold text-slate-800">출처</h2>
      <ul class="list-disc space-y-1 pl-5">
        {g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="underline">{s.name}</a>{s.note && ` (${s.note})`}</li>)}
      </ul>
      <p class="mt-3 text-xs text-slate-500">이 글은 공개된 공식 안내와 공공데이터를 정리한 일반 정보입니다. 수수료·발급 시간 등은 지자체와 시기에 따라 바뀔 수 있으니 최종 확인은 관리기관에 해 주세요.</p>
    </section>
  </article>

  <AdSlot name="C" />

  <section class="mt-8">
    <h2 class="mb-2 text-lg font-bold">다른 가이드</h2>
    <ul class="space-y-2">
      {others.map((o) => <li><a href={guidePath(o)} class="text-brand underline">{o.title}</a></li>)}
    </ul>
  </section>
</BaseLayout>
