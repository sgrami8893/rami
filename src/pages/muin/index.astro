---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SIDO_ORDER, regionsIn, sidoName, regionPath, kiosks, MUIN_CRUMBS } from '../../lib/data.ts';
import { homeTitle, homeDescription } from '../../lib/copy.ts';
import GuideList from '../../components/GuideList.astro';
import SidoChips from '../../components/SidoChips.astro';
import { breadcrumb } from '../../lib/jsonld.ts';
import Icon from '../../components/Icon.astro';
import { FAV_KEY } from '../../scripts/favorites.ts';
const cards = SIDO_ORDER.map((s) => ({ s, regions: regionsIn(s) })).filter((x) => x.regions.length);
---
<BaseLayout title={homeTitle(kiosks.length)} description={homeDescription(kiosks.length)} crumbs={MUIN_CRUMBS} tool="muin"
  jsonld={[breadcrumb(MUIN_CRUMBS.map((c) => ({ name: c.name, url: new URL(c.href, Astro.site).href })))]}>
  <SidoChips class="mb-4" />
  <section class="card mt-1 bg-brand text-white">
    <p class="text-cap font-semibold text-white">서울·경기·인천 {kiosks.length.toLocaleString('ko-KR')}곳</p>
    <h1 class="mt-1 text-title font-bold">수도권 무인민원발급기,<br />지금 운영시간 바로 확인</h1>
    <p class="mt-2 text-body text-white">24시간, 주말·공휴일, 등기부등본, 가족관계증명서 조건으로 바로 걸러 보세요.</p>
  </section>

  <!-- 즐겨찾는 발급기: 이 브라우저의 localStorage에서 바로 그린다(첫 화면 그리기 전에 실행되는 인라인 스크립트라 화면 밀림 없음) -->
  <section id="fav" class="mt-8" hidden aria-labelledby="fav-h">
    <h2 id="fav-h" class="mb-1 flex items-center gap-1.5 px-1 text-h2 font-bold text-ink"><Icon name="star" size={18} class="fill-current text-brand" />즐겨찾는 발급기</h2>
    <p class="px-1 text-cap text-ink-3">이 브라우저에만 저장돼요. 기기 상세의 '저장' 버튼으로 추가·삭제해요.</p>
    <div id="fav-list"></div>
  </section>
  <script is:inline define:vars={{ FAV_KEY }}>
    (function () {
      var list; try { list = JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch (e) { list = []; }
      if (!Array.isArray(list) || !list.length) return;
      var box = document.getElementById('fav-list');
      list.slice(0, 20).forEach(function (f) {
        if (!f || typeof f.path !== 'string' || f.path.indexOf('/muin/') !== 0) return; // 우리 사이트 내부 경로만
        var a = document.createElement('article');
        a.className = 'kiosk relative -mx-5 px-5 py-4 active:bg-subtle lg:-mx-3 lg:rounded-xl lg:px-3 lg:hover:bg-subtle';
        a.dataset.hours = JSON.stringify(f.hours || {}); a.dataset.conf = String(f.conf || ''); a.dataset.f24h = f.f24h ? '1' : '';
        var top = document.createElement('div'); top.className = 'flex items-start justify-between gap-3';
        var h = document.createElement('h3'); h.className = 'text-[17px] font-semibold leading-snug text-ink';
        var link = document.createElement('a'); link.href = f.path; link.className = 'after:absolute after:inset-0'; link.textContent = String(f.name || '');
        h.appendChild(link);
        var badge = document.createElement('span'); badge.className = 'open-badge badge bg-off-bg text-off'; badge.textContent = '확인 중';
        top.appendChild(h); top.appendChild(badge);
        var p1 = document.createElement('p'); p1.className = 'mt-1 text-[15px] text-ink';
        var rel = document.createElement('span'); rel.className = 'rel-time font-medium'; rel.dataset.default = f.f24h ? '연중 24시간' : ''; rel.textContent = f.f24h ? '연중 24시간' : '\u00a0';
        p1.appendChild(rel);
        var p2 = document.createElement('p'); p2.className = 'mt-0.5 truncate text-cap text-ink-3'; p2.textContent = String(f.sub || '');
        a.appendChild(top); a.appendChild(p1); a.appendChild(p2); box.appendChild(a);
      });
      if (box.children.length) document.getElementById('fav').hidden = false;
    })();
  </script>

  <a href="/muin/checklist/" class="mt-8 flex min-h-14 items-center gap-3 rounded-2xl bg-bg px-5 py-4 hover:[&_strong]:text-brand">
    <Icon name="file-text" size={22} class="shrink-0 text-brand" />
    <span class="min-w-0 flex-1"><strong class="block text-body text-ink">상황별 서류 체크리스트</strong><span class="block text-cap text-ink-3">부동산 계약·전세대출·연말정산·자동차, 챙길 서류를 체크해요</span></span>
    <Icon name="chevron-right" size={18} class="shrink-0 text-ink-3" />
  </a>
  {cards.map(({ s, regions }) => (
    <section class="mt-8">
      <h2 class="mb-3 flex items-baseline justify-between px-1">
        <a href={regionPath(s)} class="text-h2 font-bold text-ink hover:text-brand">{sidoName(s)}</a>
        <span class="text-cap text-ink-3">{regions.reduce((a, r) => a + r.total, 0).toLocaleString('ko-KR')}곳</span>
      </h2>
      <div class="flex flex-wrap gap-2">
        {regions.map((r) => (
          <a href={regionPath(r.sido, r.sigungu)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[14px] font-medium text-ink-2 hover:text-brand">{r.sigunguName}<span class="ml-1 text-ink-3">{r.total}</span></a>
        ))}
      </div>
    </section>
  ))}
  <div class="band -mx-5 mt-10 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <GuideList />
</BaseLayout>

<script>
  import { refreshOpenState } from '../../scripts/open-now.ts';
  refreshOpenState();
  setInterval(refreshOpenState, 60_000);
</script>
