---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import KioskCard from '../../../../../components/KioskCard.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import {
  kiosks, byId, hasDetail, hasCoords, sidoShort, regionPath, kioskPath, MUIN_CRUMBS, type Kiosk,
} from '../../../../../lib/data.ts';
import { fmtRange, sortDocs, docLabel, kakaoTo, kakaoMap, kakaoSearch, naverSearch, reportUrl } from '../../../../../lib/format.ts';
import { breadcrumb, place } from '../../../../../lib/jsonld.ts';
import { kioskTitle, kioskDescription } from '../../../../../lib/copy.ts';
import { DOC_LABELS, type DocCode } from '../../../../../../scripts/lib/docs.ts';

export function getStaticPaths() {
  return kiosks.filter(hasDetail).map((k) => ({ params: { sido: k.sido, sigungu: k.sigungu, id: k.id }, props: { k } }));
}

const { k } = Astro.props as { k: Kiosk };
const nearby = (k.nearby ?? []).map((n) => ({ k: byId.get(n.id)!, m: n.m })).filter((x) => x.k);
// 대체 기기: 좌표가 있으면 반경 2km, 없으면 같은 동 → 같은 일반구(빌드 스크립트가 계산).
// 대체 기기가 하나도 없으면 noindex, 대신 같은 시·군·구의 다른 기기 3곳(좌표가 있으면 가까운 순)을 보여 준다.
const noindex = nearby.length === 0;
const byCoords = hasCoords(k);
const fallback = noindex
  ? kiosks.filter((o) => o.id !== k.id && o.sido === k.sido && o.sigungu === k.sigungu)
      .map((o) => ({ k: o, m: byCoords && hasCoords(o) ? Math.round(Math.hypot((o.lat! - k.lat!) * 111000, (o.lng! - k.lng!) * 88000)) : undefined }))
      .sort((a, b) => (a.m ?? 1e9) - (b.m ?? 1e9)).slice(0, 3)
  : [];
const altTitle = noindex
  ? `${k.sigunguName}의 다른 무인민원발급기`
  : byCoords ? `반경 2km 안의 다른 무인민원발급기 (${nearby.length}곳)` : `${k.dong ?? k.subGu ?? k.sigunguName} 주변 다른 무인민원발급기 (${nearby.length}곳)`;
const alt = noindex ? fallback : nearby;

// What the alternatives issue that this kiosk does not.
const missing = (o: Kiosk) => sortDocs(o.docs.filter((d) => !k.docs.includes(d) && d !== 'other'));

const site = Astro.site!;
const url = new URL(kioskPath(k), site).href;
const report = reportUrl(k.id, k.name);
const title = kioskTitle(k);
const description = kioskDescription(k);
const crumbs = [
  ...MUIN_CRUMBS,
  { name: sidoShort(k.sido), href: regionPath(k.sido) },
  { name: k.sigunguName, href: regionPath(k.sido, k.sigungu) },
  { name: k.name, href: kioskPath(k) },
];
const rows: [string, keyof Kiosk['hours']][] = [['평일', 'weekday'], ['토요일', 'sat'], ['일요일', 'sun'], ['공휴일', 'holiday']];
const allDocs = Object.keys(DOC_LABELS).filter((d) => d !== 'other') as DocCode[];
---
<BaseLayout
  tool="muin"
  title={title}
  description={description}
  noindex={noindex}
  crumbs={crumbs}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))), place(k, url)]}
>
  <div id="self" class="kiosk" data-id={k.id} data-hours={JSON.stringify(k.hours)} data-conf={k.hoursConfidence}>
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-xl font-bold leading-snug sm:text-2xl">{k.name}</h1>
      <span class="open-badge hidden rounded-full px-2 py-0.5 text-xs font-medium"></span>
    </div>
    <p class="mt-1 text-sm text-slate-600">{k.locationDetail} · {k.roadAddress}</p>
    <p class="next-open mt-1 hidden text-sm text-slate-500"></p>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="mb-2 font-bold">운영시간</h2>
      <table class="w-full text-sm">
        <tbody>
          {rows.map(([label, key]) => (
            <tr class="border-t border-slate-100 first:border-0">
              <th class="py-1.5 text-left font-normal text-slate-500">{label}</th>
              <td class="py-1.5 text-right">{fmtRange(k.hours[key])}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {k.hoursConfidence !== 'ok' && <p class="mt-2 text-xs text-amber-700">원문: {k.hoursRaw || '정보 없음'} (일부 추정)</p>}
    </section>
    <section class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="mb-2 font-bold">발급 가능 서류</h2>
      <ul class="space-y-1 text-sm">
        {allDocs.map((d) => (
          <li class="flex justify-between border-t border-slate-100 py-1 first:border-0">
            <span>{DOC_LABELS[d]}</span>
            {k.docs.includes(d) ? <span class="text-emerald-700">가능</span> : <span class="text-slate-400">불가 또는 정보 없음</span>}
          </li>
        ))}
      </ul>
      {k.docCount ? <p class="mt-2 text-xs text-slate-500">이 기기의 발급 가능 민원 사무 총 {k.docCount}종 (원천 데이터 기준)</p> : <p class="mt-2 text-xs text-slate-500">원문: {k.docsRaw}</p>}
    </section>
  </div>

  <div class="mt-4 flex gap-2 text-sm">
    {byCoords ? <>
      <a href={kakaoTo(k.name, k.lat!, k.lng!)} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg bg-yellow-300 px-3 py-2.5 text-center font-medium hover:bg-yellow-400">카카오맵 길찾기</a>
      <a href={kakaoMap(k.name, k.lat!, k.lng!)} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-center font-medium">카카오맵 위치</a>
    </> : <a href={kakaoSearch(k.roadAddress)} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg bg-yellow-300 px-3 py-2.5 text-center font-medium hover:bg-yellow-400">카카오맵에서 보기</a>}
    <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-lg bg-green-600 px-3 py-2.5 text-center font-medium text-white hover:bg-green-700">네이버 지도</a>
  </div>
  {(k.a11y?.length ?? 0) > 0 && <p class="mt-3 text-sm"><span class="text-slate-500">장애인 편의</span> {k.a11y!.join(' · ')}</p>}
  {k.infoUrl && <p class="mt-1 text-sm"><a href={k.infoUrl} target="_blank" rel="noopener noreferrer nofollow" class="text-brand underline">관리기관 안내 페이지</a></p>}
  <p class="mt-3 text-sm text-slate-600">관리: {k.agency}{k.phone && <> · <a href={`tel:${k.phone}`} class="underline">{k.phone}</a></>} · 기준일 {k.baseDate ?? '미상'}</p>

  <AdSlot name="A" />

  <section class="mt-6">
    <h2 class="mb-1 text-lg font-bold">{altTitle}</h2>
    <p class="mb-3 text-sm text-slate-600">이 기기가 닫혀 있거나 필요한 서류가 없을 때 갈 수 있는 곳입니다.{byCoords && ' 가까운 순.'}</p>
    <div id="kiosk-list" class="space-y-3">
      {alt.map(({ k: o, m }) => (
        <div>
          <KioskCard k={o} distance={m} compact />
          {missing(o).length > 0 && <p class="mt-1 pl-1 text-xs text-emerald-700">이곳에서 추가로 발급: {missing(o).map(docLabel).join(', ')}</p>}
        </div>
      ))}
    </div>
  </section>

  <p class="mt-8 text-sm">
    <a href={regionPath(k.sido, k.sigungu)} class="text-brand underline">{k.sigunguName} 무인민원발급기 전체 보기</a>
  </p>
  {report
    ? <p class="mt-2 text-sm"><a href={report} target="_blank" rel="noopener noreferrer" class="text-slate-500 underline">정보 오류 제보</a></p>
    : <p class="mt-2 text-xs text-slate-400">정보 오류 제보 (구글 폼 연결 전)</p>}
</BaseLayout>

<script>
  import { refreshOpenState } from '../../../../../scripts/open-now.ts';
  refreshOpenState();
  setInterval(() => refreshOpenState(), 60_000);
</script>
