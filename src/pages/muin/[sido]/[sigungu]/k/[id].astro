---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import KioskRow from '../../../../../components/KioskRow.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import {
  kiosks, byId, hasDetail, hasCoords, sidoShort, regionPath, kioskPath, MUIN_CRUMBS, type Kiosk,
} from '../../../../../lib/data.ts';
import { fmtRange, hoursLine, sortDocs, docLabel, kakaoTo, kakaoSearch, naverSearch, reportUrl } from '../../../../../lib/format.ts';
import Icon from '../../../../../components/Icon.astro';
import { breadcrumb, place } from '../../../../../lib/jsonld.ts';
import { kioskTitle, kioskDescription, kioskCheckpoints } from '../../../../../lib/copy.ts';
import { DOC_LABELS, type DocCode } from '../../../../../../scripts/lib/docs.ts';

export function getStaticPaths() {
  return kiosks.filter(hasDetail).map((k) => ({ params: { sido: k.sido, sigungu: k.sigungu, id: k.id }, props: { k } }));
}

const { k } = Astro.props as { k: Kiosk };
// '운영시간 외'일 때 보여 줄 같은 동 기기(브라우저가 지금 운영시간인 곳만 센다)와 서류별 필터 링크용 개수
const regionHref = regionPath(k.sido, k.sigungu);
const sameDong = k.dong ? kiosks.filter((o) => o.id !== k.id && o.sido === k.sido && o.sigungu === k.sigungu && o.dong === k.dong && o.hoursConfidence !== 'unknown') : [];
const inRegion = kiosks.filter((o) => o.sido === k.sido && o.sigungu === k.sigungu);
const regCount = inRegion.filter((o) => o.docs.includes('registry')).length;
const famCount = inRegion.filter((o) => o.docs.includes('family')).length;
const checkpoints = kioskCheckpoints(k, { regionHref, regCount, today: new Date().toISOString().slice(0, 10) });
const nearby = (k.nearby ?? []).map((n) => ({ k: byId.get(n.id)!, m: n.m })).filter((x) => x.k);
// 대체 기기: 좌표가 있으면 반경 2km, 없으면 같은 동 → 같은 일반구(빌드 스크립트가 계산).
// 대체 기기가 하나도 없으면 noindex, 대신 같은 시·군·구의 다른 기기 3곳(좌표가 있으면 가까운 순)을 보여 준다.
const noindex = nearby.length === 0;
const byCoords = hasCoords(k);
const fallback = noindex
  ? kiosks.filter((o) => o.id !== k.id && o.sido === k.sido && o.sigungu === k.sigungu)
      .map((o) => ({ k: o, m: byCoords && hasCoords(o) ? Math.round(Math.hypot((o.lat! - k.lat!) * 111000, (o.lng! - k.lng!) * 88000)) : undefined }))
      .sort((a, b) => (a.m ?? 1e9) - (b.m ?? 1e9)).slice(0, 3)
  : [];
const altTitle = noindex
  ? `${k.sigunguName}의 다른 무인민원발급기`
  : byCoords ? `반경 2km 안의 다른 무인민원발급기 (${nearby.length}곳)` : `${k.dong ?? k.subGu ?? k.sigunguName}의 다른 무인민원발급기 (${nearby.length}곳)`;
const alt = noindex ? fallback : nearby;

// What the alternatives issue that this kiosk does not.
const missing = (o: Kiosk) => sortDocs(o.docs.filter((d) => !k.docs.includes(d) && d !== 'other'));

const site = Astro.site!;
const url = new URL(kioskPath(k), site).href;
const report = reportUrl(k.id, k.name);
const title = kioskTitle(k);
const description = kioskDescription(k);
const crumbs = [
  ...MUIN_CRUMBS,
  { name: sidoShort(k.sido), href: regionPath(k.sido) },
  { name: k.sigunguName, href: regionPath(k.sido, k.sigungu) },
  { name: k.name, href: kioskPath(k) },
];
const rows: [string, keyof Kiosk['hours']][] = [['평일', 'weekday'], ['토요일', 'sat'], ['일요일', 'sun'], ['공휴일', 'holiday']];
const allDocs = Object.keys(DOC_LABELS).filter((d) => d !== 'other') as DocCode[];
const available = sortDocs(k.docs).filter((d) => d !== 'other');
const unavailable = allDocs.filter((d) => !k.docs.includes(d));
// 핵심 6종(주민등록·가족관계·등기부·토지·지방세 순, docOrder)만 먼저 보여 주고 나머지는 접는다(JS 없이 <details>).
const SHOW_DOCS = 6;
const docsHead = available.slice(0, SHOW_DOCS), docsRest = available.slice(SHOW_DOCS);
const chip = 'rounded-xl bg-bg px-2.5 py-1 text-cap font-medium text-ink-2';
const hoursText = k.hoursConfidence === 'unknown' ? '운영시간 확인 필요' : hoursLine(k.hours);
const BAND = 'band -mx-5 lg:mx-0 lg:rounded-lg';
const kakaoHref = byCoords ? kakaoTo(k.name, k.lat!, k.lng!) : kakaoSearch(k.roadAddress);
---
<BaseLayout
  tool="muin"
  canvas="white"
  title={title}
  description={description}
  noindex={noindex}
  crumbs={crumbs}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))), place(k, url)]}
>
  <!-- 최상단 상태 블록: 들어오자마자 이용 가능 여부. JS가 한국 시간으로 "운영시간 내 · 오늘 18:00까지"로 채운다.
       기본 HTML은 원래 운영시간, 한 줄 말줄임이라 치환해도 높이가 바뀌지 않는다(CLS 없음). -->
  <div id="self" class="kiosk pb-7" data-id={k.id} data-hours={JSON.stringify(k.hours)} data-conf={k.hoursConfidence} data-f24h={k.is24h ? '1' : ''}>
    <p id="status" class="truncate text-[22px] font-bold leading-[1.45] text-ink-2">
      <span id="status-label">운영시간</span><span> · </span><span class="rel-time" data-default={hoursText}>{hoursText}</span>
    </p>
    <h1 class="mt-3 text-[20px] font-bold leading-snug text-ink">{k.name} <span class="sr-only">무인민원발급기</span></h1>
    {(k.locationDetail || k.placeType) && (
      <p class="mt-0.5 text-body text-ink-2">{[k.locationDetail, k.placeType].filter(Boolean).join(' · ')}</p>
    )}
    <!-- 주소는 왼쪽에서 자유롭게 줄바꿈, 복사 버튼은 오른쪽 첫 줄에 고정 -->
    <div class="mt-1.5 flex items-start gap-3">
      <p class="min-w-0 flex-1 text-[14px] leading-6 text-ink-3">{k.roadAddress}</p>
      <button type="button" data-copy={k.roadAddress} class="flex h-7 shrink-0 items-center gap-1 rounded-lg bg-bg px-2.5 text-[13px] font-semibold text-ink-2 hover:text-brand">
        <Icon name="copy" size={13} /><span>주소 복사</span>
      </button>
    </div>

    <!-- 운영시간 외일 때만: 지금 운영시간인 같은 동 기기로 바로가기(없으면 같은 지역 필터) -->
    <a id="alt-now" hidden href={`${regionHref}?f=open`} data-region={regionHref} data-dong={k.dong ?? ''} data-hours-list={JSON.stringify(sameDong.map((o) => o.hours))}
      class="mt-4 flex min-h-12 items-center justify-between gap-2 rounded-xl bg-brand-weak px-4 py-3 text-[15px] font-semibold text-brand">
      <span id="alt-now-text">같은 지역에서 지금 운영시간인 곳 찾기</span><Icon name="chevron-right" size={20} />
    </a>

    <!-- PC: 본문 상단 버튼(모바일은 하단 고정 바). 테두리 없이 면 대비만. -->
    <div class="mt-5 hidden gap-2 lg:flex">
      <a href={kakaoHref} target="_blank" rel="noopener noreferrer" class="flex h-12 flex-1 items-center justify-center gap-1.5 rounded-2xl bg-brand text-body font-bold text-white hover:brightness-95"><Icon name="direction-sign" size={20} />{byCoords ? '카카오맵 길찾기' : '카카오맵에서 보기'}</a>
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class="flex h-12 flex-1 items-center justify-center gap-1.5 rounded-2xl bg-bg text-body font-bold text-ink-2 hover:brightness-[0.97]"><Icon name="map" size={20} />네이버 지도</a>
    </div>
  </div>

  {checkpoints.length > 0 && (
    <>
      <div class={BAND} aria-hidden="true"></div>
      <section class="py-7">
        <h2 class="mb-3 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="triangle-alert" size={20} class="text-warn" />방문 전 체크포인트</h2>
        <ul class="space-y-2.5">
          {checkpoints.map((c) => (
            <li class="flex gap-2 text-body text-ink-2"><Icon name="check" size={18} class="mt-[3px] text-brand" /><span>{c.text}{c.href && <> <a href={c.href} class="font-semibold text-brand">{c.link}</a></>}</span></li>
          ))}
        </ul>
      </section>
    </>
  )}

  <div class={BAND} aria-hidden="true"></div>
  <section class="py-7">
    <h2 class="mb-2 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="clock" size={20} class="text-brand" />운영시간</h2>
    <!-- 오늘(KST·공휴일 반영)에 해당하는 줄은 스크립트가 연한 배경과 '오늘' 배지로 강조한다 -->
    <table class="-mx-2 w-[calc(100%+16px)] text-body">
      <tbody>
        {rows.map(([label, key]) => (
          <tr data-hkey={key}>
            <th class="rounded-l-lg px-2 py-2.5 text-left font-normal text-ink-3">{label}<span data-today hidden class="badge ml-1.5 bg-brand text-white">오늘</span></th>
            <td class={`rounded-r-lg px-2 py-2.5 text-right font-semibold ${k.hours[key] === null ? 'text-ink-3' : 'text-ink'}`}>{fmtRange(k.hours[key])}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {k.hoursConfidence !== 'ok' && <p class="mt-2 rounded-xl bg-bg px-3 py-2 text-cap text-ink-3">원천 데이터 원문: {k.hoursRaw || '정보 없음'}</p>}
  </section>

  <div class={BAND} aria-hidden="true"></div>
  <section class="py-7">
    <h2 class="mb-3 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="file-text" size={20} class="text-brand" />발급 가능 서류</h2>
    <ul class="flex flex-wrap gap-1.5">
      {docsHead.map((d) => <li class={chip}>{DOC_LABELS[d]}</li>)}
    </ul>
    {docsRest.length > 0 && (
      <details class="group mt-1.5">
        <summary class="inline-flex cursor-pointer list-none items-center gap-0.5 rounded-xl px-1 py-1 text-cap font-semibold text-brand [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">+ {docsRest.length}종 더보기</span><span class="hidden group-open:inline">접기</span>
        </summary>
        <ul class="mt-1 flex flex-wrap gap-1.5">
          {docsRest.map((d) => <li class={chip}>{DOC_LABELS[d]}</li>)}
        </ul>
      </details>
    )}
    {unavailable.length > 0 && <p class="mt-3 text-cap text-ink-3">발급 안 됨 또는 정보 없음: {unavailable.map((d) => DOC_LABELS[d]).join(', ')}</p>}
    {k.docCount ? <p class="mt-1 text-cap text-ink-3">세부 종류로 나누면 이 기기에서 발급할 수 있는 서류는 {k.docCount}종입니다(원천 데이터 기준).</p> : null}
    <!-- 서류별 필터 링크: 같은 시·군·구 목록을 해당 서류 필터가 켜진 상태로 연다 -->
    <div class="mt-3 divide-y divide-line border-t border-line">
      {regCount > 0 && <a href={`${regionHref}?f=registry`} class="flex min-h-12 items-center justify-between gap-2 text-body font-semibold text-ink hover:text-brand">{k.sigunguName}에서 등기부등본 발급 기기 {regCount}곳 보기<Icon name="chevron-right" size={20} class="text-ink-3" /></a>}
      {famCount > 0 && <a href={`${regionHref}?f=family`} class="flex min-h-12 items-center justify-between gap-2 text-body font-semibold text-ink hover:text-brand">{k.sigunguName}에서 가족관계증명서 발급 기기 {famCount}곳 보기<Icon name="chevron-right" size={20} class="text-ink-3" /></a>}
    </div>
  </section>

  {(k.a11y?.length ?? 0) > 0 && (
    <>
      <div class={BAND} aria-hidden="true"></div>
      <section class="py-7">
        <h2 class="mb-3 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="accessibility" size={20} class="text-brand" />장애인 편의 기능</h2>
        <ul class="flex flex-wrap gap-1.5">
          {k.a11y!.map((a) => <li class={chip}>{a}</li>)}
        </ul>
      </section>
    </>
  )}

  <div class={BAND} aria-hidden="true"></div>
  <section class="py-7 text-body text-ink-2">
    <dl class="space-y-2">
      <div class="flex justify-between gap-4"><dt class="text-ink-3">관리기관</dt><dd class="text-right">{k.agency}{k.phone && <> · <a href={`tel:${k.phone}`} class="underline">{k.phone}</a></>}</dd></div>
      <div class="flex justify-between gap-4"><dt class="text-ink-3">데이터 기준일</dt><dd>{k.baseDate ?? '미상'}</dd></div>
    </dl>
    {k.infoUrl && <a href={k.infoUrl} target="_blank" rel="noopener noreferrer nofollow" class="mt-3 inline-flex items-center gap-1 text-cap font-semibold text-brand">관리기관 안내 페이지<Icon name="external-link" size={14} /></a>}
  </section>

  <AdSlot name="A" />

  <div class={BAND} aria-hidden="true"></div>
  <section class="pt-7">
    <h2 class="text-h2 font-bold text-ink">{altTitle}</h2>
    <p class="mt-1 text-cap text-ink-3">이 기기가 운영시간 외이거나 필요한 서류가 없을 때 갈 수 있는 곳입니다.{byCoords && ' 가까운 순.'}</p>
    <div id="kiosk-list" class="mt-1">
      {alt.map(({ k: o }) => <KioskRow k={o} note={missing(o).length > 0 ? `이곳에서 추가로 발급: ${missing(o).map(docLabel).join(', ')}` : undefined} />)}
    </div>
  </section>

  <div class="mt-4 flex flex-col gap-2 text-body">
    <a href={regionPath(k.sido, k.sigungu)} class="flex items-center gap-1 py-2 font-semibold text-brand">{k.sigunguName} 무인민원발급기 전체 보기<Icon name="chevron-right" size={16} /></a>
    {report && <a href={report} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-cap text-ink-3"><Icon name="triangle-alert" size={14} />정보 오류 제보</a>}
  </div>

  <!-- 하단 고정 길찾기 버튼(모바일): 푸터 뒤에 버튼 높이만큼 여백을 둬 마지막 내용이 가려지지 않게 한다 -->
  <div slot="bottom" aria-hidden="true" class="h-[calc(96px+env(safe-area-inset-bottom))] lg:hidden"></div>
  <div slot="bottom" class="lg:hidden fixed inset-x-0 bottom-0 z-30 bg-card/95 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] backdrop-blur">
    <div class="mx-auto flex max-w-2xl gap-2 px-5 pt-3 pb-[calc(12px+env(safe-area-inset-bottom))]">
      <a href={kakaoHref} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-[1.4] items-center justify-center gap-1.5 rounded-2xl bg-brand text-[16px] font-bold text-white hover:brightness-95">
        <Icon name="direction-sign" size={20} />{byCoords ? '카카오맵 길찾기' : '카카오맵에서 보기'}
      </a>
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-1 items-center justify-center gap-1.5 rounded-2xl bg-bg text-[16px] font-bold text-ink-2 hover:brightness-[0.97]">
        <Icon name="map" size={20} />네이버 지도
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  import { refreshOpenState, todayKey, isOpenNow } from '../../../../../scripts/open-now.ts';
  import type { Hours } from '../../../../../../scripts/lib/hours.ts';
  import { initCopy } from '../../../../../scripts/copy.ts';
  const STATUS = { open: ['운영시간 내', 'text-ok'], closed: ['운영시간 외', 'text-ink-2'], unknown: ['운영시간 확인 필요', 'text-warn'] } as const;
  const tick = () => {
    const now = refreshOpenState(); // .rel-time(지금 기준 문구)과 data-open을 채운다
    const self = document.getElementById('self')!;
    const [label, color] = STATUS[(self.dataset.open ?? 'unknown') as keyof typeof STATUS];
    document.getElementById('status-label')!.textContent = label;
    document.getElementById('status')!.className = `truncate text-[22px] font-bold leading-[1.45] ${color}`;
    // 운영시간 외: 같은 동에서 지금 운영시간인 기기 수를 세어 바로가기 문구를 정한다(값은 textContent·setAttribute로만 씀)
    const alt = document.getElementById('alt-now') as HTMLAnchorElement | null;
    if (alt) {
      const closed = self.dataset.open === 'closed';
      alt.hidden = !closed;
      if (closed) {
        let list: Hours[] = [];
        try { list = JSON.parse(alt.dataset.hoursList || '[]'); } catch { /* 빈 목록으로 처리 */ }
        const n = list.filter((h) => isOpenNow(h, now) === true).length;
        const dong = alt.dataset.dong ?? '';
        const region = alt.dataset.region ?? '';
        alt.setAttribute('href', n > 0 && dong ? `${region}?f=open&dong=${encodeURIComponent(dong)}` : `${region}?f=open`);
        document.getElementById('alt-now-text')!.textContent = n > 0 && dong ? `지금 운영시간인 ${dong} 기기 ${n}곳 보기` : '같은 지역에서 지금 운영시간인 곳 찾기';
      }
    }
    const key = todayKey(now);
    document.querySelectorAll<HTMLElement>('tr[data-hkey]').forEach((tr) => {
      const on = tr.dataset.hkey === key;
      tr.querySelectorAll('th, td').forEach((c) => c.classList.toggle('bg-brand-weak', on));
      tr.querySelector<HTMLElement>('[data-today]')!.hidden = !on;
    });
  };
  tick();
  setInterval(tick, 60_000);
  initCopy();
</script>
