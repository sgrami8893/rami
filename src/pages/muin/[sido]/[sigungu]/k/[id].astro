---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import KioskCard from '../../../../../components/KioskCard.astro';
import AdSlot from '../../../../../components/AdSlot.astro';
import {
  kiosks, byId, hasDetail, hasCoords, sidoShort, regionPath, kioskPath, MUIN_CRUMBS, type Kiosk,
} from '../../../../../lib/data.ts';
import { fmtRange, sortDocs, docLabel, kakaoTo, kakaoSearch, naverSearch, reportUrl } from '../../../../../lib/format.ts';
import Icon from '../../../../../components/Icon.astro';
import { breadcrumb, place } from '../../../../../lib/jsonld.ts';
import { kioskTitle, kioskDescription } from '../../../../../lib/copy.ts';
import { DOC_LABELS, type DocCode } from '../../../../../../scripts/lib/docs.ts';

export function getStaticPaths() {
  return kiosks.filter(hasDetail).map((k) => ({ params: { sido: k.sido, sigungu: k.sigungu, id: k.id }, props: { k } }));
}

const { k } = Astro.props as { k: Kiosk };
const nearby = (k.nearby ?? []).map((n) => ({ k: byId.get(n.id)!, m: n.m })).filter((x) => x.k);
// 대체 기기: 좌표가 있으면 반경 2km, 없으면 같은 동 → 같은 일반구(빌드 스크립트가 계산).
// 대체 기기가 하나도 없으면 noindex, 대신 같은 시·군·구의 다른 기기 3곳(좌표가 있으면 가까운 순)을 보여 준다.
const noindex = nearby.length === 0;
const byCoords = hasCoords(k);
const fallback = noindex
  ? kiosks.filter((o) => o.id !== k.id && o.sido === k.sido && o.sigungu === k.sigungu)
      .map((o) => ({ k: o, m: byCoords && hasCoords(o) ? Math.round(Math.hypot((o.lat! - k.lat!) * 111000, (o.lng! - k.lng!) * 88000)) : undefined }))
      .sort((a, b) => (a.m ?? 1e9) - (b.m ?? 1e9)).slice(0, 3)
  : [];
const altTitle = noindex
  ? `${k.sigunguName}의 다른 무인민원발급기`
  : byCoords ? `반경 2km 안의 다른 무인민원발급기 (${nearby.length}곳)` : `${k.dong ?? k.subGu ?? k.sigunguName} 주변 다른 무인민원발급기 (${nearby.length}곳)`;
const alt = noindex ? fallback : nearby;

// What the alternatives issue that this kiosk does not.
const missing = (o: Kiosk) => sortDocs(o.docs.filter((d) => !k.docs.includes(d) && d !== 'other'));

const site = Astro.site!;
const url = new URL(kioskPath(k), site).href;
const report = reportUrl(k.id, k.name);
const title = kioskTitle(k);
const description = kioskDescription(k);
const crumbs = [
  ...MUIN_CRUMBS,
  { name: sidoShort(k.sido), href: regionPath(k.sido) },
  { name: k.sigunguName, href: regionPath(k.sido, k.sigungu) },
  { name: k.name, href: kioskPath(k) },
];
const rows: [string, keyof Kiosk['hours']][] = [['평일', 'weekday'], ['토요일', 'sat'], ['일요일', 'sun'], ['공휴일', 'holiday']];
const allDocs = Object.keys(DOC_LABELS).filter((d) => d !== 'other') as DocCode[];
const available = sortDocs(k.docs).filter((d) => d !== 'other');
const unavailable = allDocs.filter((d) => !k.docs.includes(d));
const kakaoHref = byCoords ? kakaoTo(k.name, k.lat!, k.lng!) : kakaoSearch(k.roadAddress);
---
<BaseLayout
  tool="muin"
  title={title}
  description={description}
  noindex={noindex}
  crumbs={crumbs}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site).href }))), place(k, url)]}
>
  <div id="self" class="kiosk" data-id={k.id} data-hours={JSON.stringify(k.hours)} data-conf={k.hoursConfidence}>
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="open-badge badge invisible bg-off-bg text-off">운영 확인 중</span>
      {k.is24h && <span class="badge bg-info-bg text-info">24시간</span>}
      {k.placeType && <span class="badge bg-off-bg text-off">{k.placeType}</span>}
      <span class="next-open hidden text-cap text-ink-3"></span>
    </div>
    <h1 class="mt-2 text-title font-bold text-ink">{k.name}</h1>
    {k.locationDetail && <p class="mt-0.5 text-body text-ink-2">{k.locationDetail}</p>}
    <p class="mt-1 flex items-start gap-1 text-cap text-ink-3"><Icon name="map-pin" size={14} class="mt-[3px]" />{k.roadAddress}</p>
  </div>

  <div class="mt-4 hidden gap-2 lg:flex">
    <a href={kakaoHref} target="_blank" rel="noopener noreferrer" class="flex h-12 flex-1 items-center justify-center gap-1.5 rounded-2xl bg-brand text-body font-bold text-white hover:brightness-95"><Icon name="navigation" size={18} />{byCoords ? '카카오맵 길찾기' : '카카오맵에서 보기'}</a>
    <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class="flex h-12 flex-1 items-center justify-center gap-1.5 rounded-2xl bg-card text-body font-bold text-ink ring-1 ring-line hover:bg-bg"><Icon name="map" size={18} />네이버 지도</a>
  </div>

  <section class="card mt-4">
    <h2 class="mb-2 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="clock" size={18} class="text-brand" />운영시간</h2>
    <table class="w-full text-body">
      <tbody>
        {rows.map(([label, key]) => (
          <tr class="border-t border-line first:border-0">
            <th class="py-2 text-left font-normal text-ink-3">{label}</th>
            <td class={`py-2 text-right font-semibold ${k.hours[key] === null ? 'text-ink-3' : 'text-ink'}`}>{fmtRange(k.hours[key])}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {k.hoursConfidence !== 'ok' && <p class="mt-2 rounded-xl bg-bg px-3 py-2 text-cap text-warn">일부 추정 · 원문: {k.hoursRaw || '정보 없음'}</p>}
    {(k.docs.includes('registry') || k.docs.includes('family')) && <p class="mt-2 text-cap text-ink-3">등기부등본·가족관계 서류는 기기 운영시간과 달리 평일 낮에만 발급되는 곳이 있습니다. <a href="/muin/guide/court-documents-hours/" class="font-semibold text-brand">대법원 서류 발급 시간 안내</a></p>}
  </section>

  <section class="card mt-3">
    <h2 class="mb-3 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="file-text" size={18} class="text-brand" />발급 가능 서류</h2>
    <ul class="flex flex-wrap gap-1.5">
      {available.map((d) => <li class="rounded-xl bg-bg px-2.5 py-1 text-cap font-medium text-ink-2">{DOC_LABELS[d]}</li>)}
    </ul>
    {unavailable.length > 0 && <p class="mt-3 text-cap text-ink-3">발급 안 됨 또는 정보 없음: {unavailable.map((d) => DOC_LABELS[d]).join(', ')}</p>}
    {k.docCount ? <p class="mt-1 text-cap text-ink-3">세부 민원 사무 기준 총 {k.docCount}종 (원천 데이터)</p> : null}
  </section>

  {(k.a11y?.length ?? 0) > 0 && (
    <section class="card mt-3">
      <h2 class="mb-2 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="accessibility" size={18} class="text-brand" />장애인 편의 기능</h2>
      <ul class="flex flex-wrap gap-1.5">
        {k.a11y!.map((a) => <li class="rounded-xl bg-bg px-2.5 py-1 text-cap font-medium text-ink-2">{a}</li>)}
      </ul>
    </section>
  )}

  <section class="card mt-3 text-body text-ink-2">
    <dl class="space-y-1.5">
      <div class="flex justify-between gap-4"><dt class="text-ink-3">관리기관</dt><dd class="text-right">{k.agency}{k.phone && <> · <a href={`tel:${k.phone}`} class="underline">{k.phone}</a></>}</dd></div>
      <div class="flex justify-between gap-4"><dt class="text-ink-3">데이터 기준일</dt><dd>{k.baseDate ?? '미상'}</dd></div>
    </dl>
    {k.infoUrl && <a href={k.infoUrl} target="_blank" rel="noopener noreferrer nofollow" class="mt-3 flex items-center gap-1 text-cap font-semibold text-brand">관리기관 안내 페이지<Icon name="external-link" size={14} /></a>}
  </section>

  <AdSlot name="A" />

  <section class="mt-8">
    <h2 class="mb-1 px-1 text-h2 font-bold text-ink">{altTitle}</h2>
    <p class="mb-3 px-1 text-cap text-ink-3">이 기기가 닫혀 있거나 필요한 서류가 없을 때 갈 수 있는 곳입니다.{byCoords && ' 가까운 순.'}</p>
    <div id="kiosk-list" class="space-y-3">
      {alt.map(({ k: o, m }) => (
        <div>
          <KioskCard k={o} distance={m} compact />
          {missing(o).length > 0 && <p class="mt-1.5 px-2 text-cap font-medium text-ok">이곳에서 추가로 발급: {missing(o).map(docLabel).join(', ')}</p>}
        </div>
      ))}
    </div>
  </section>

  <div class="mt-8 flex flex-col gap-2 px-1 text-body">
    <a href={regionPath(k.sido, k.sigungu)} class="flex items-center gap-1 font-semibold text-brand">{k.sigunguName} 무인민원발급기 전체 보기<Icon name="chevron-right" size={16} /></a>
    {report
      ? <a href={report} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-cap text-ink-3"><Icon name="triangle-alert" size={14} />정보 오류 제보</a>
      : <p class="flex items-center gap-1 text-cap text-ink-3"><Icon name="triangle-alert" size={14} />정보 오류 제보 (구글 폼 연결 전)</p>}
  </div>

  <!-- 하단 고정 길찾기 버튼: 푸터 뒤에 버튼 높이만큼 여백을 둬 마지막 내용이 가려지지 않게 한다 -->
  <div slot="bottom" aria-hidden="true" class="h-[calc(76px+env(safe-area-inset-bottom))] lg:hidden"></div>
  <div slot="bottom" class="lg:hidden fixed inset-x-0 bottom-0 z-30 bg-card/95 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] backdrop-blur">
    <div class="mx-auto flex max-w-2xl gap-2 px-4 pt-3 pb-[calc(12px+env(safe-area-inset-bottom))]">
      <a href={kakaoHref} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-[1.4] items-center justify-center gap-1.5 rounded-2xl bg-brand text-[16px] font-bold text-white hover:brightness-95">
        <Icon name="navigation" size={18} />{byCoords ? '카카오맵 길찾기' : '카카오맵에서 보기'}
      </a>
      <a href={naverSearch(k.roadAddress, k.name)} target="_blank" rel="noopener noreferrer" class="flex h-[52px] flex-1 items-center justify-center gap-1.5 rounded-2xl bg-bg text-[16px] font-bold text-ink hover:bg-line">
        <Icon name="map" size={18} />네이버 지도
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  import { refreshOpenState } from '../../../../../scripts/open-now.ts';
  refreshOpenState();
  setInterval(() => refreshOpenState(), 60_000);
</script>
