---
import MapPanel from '../../../../components/MapPanel.astro';
import MapButton from '../../../../components/MapButton.astro';
import { mapOn, validPoints, kioskPoint } from '../../../../lib/map.ts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import KioskRow from '../../../../components/KioskRow.astro';
import FilterBar from '../../../../components/FilterBar.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import FaqSection from '../../../../components/FaqSection.astro';
import StatCards from '../../../../components/StatCards.astro';
import {
  stats, kiosksIn, statsFor, subGuOf, sidoName, sidoShort, regionPath, kioskPath, nearestOutside, nearbyRegions, MUIN_CRUMBS,
  type SidoSlug, type Kiosk,
} from '../../../../lib/data.ts';
import { regionFaq } from '../../../../lib/faq.ts';
import { regionPageTitle, regionDescription, regionUsageSummary } from '../../../../lib/copy.ts';
import { faqPage, breadcrumb, itemList } from '../../../../lib/jsonld.ts';
import { km } from '../../../../lib/format.ts';
import { REPORT_FORM } from '../../../../config.ts';
import GuideList from '../../../../components/GuideList.astro';
import Icon from '../../../../components/Icon.astro';
import { dongPage, dongPagesIn, dongPath } from '../../../../lib/dongs.ts';

export function getStaticPaths() {
  return stats.map((s) => ({ params: { sido: s.sido, sigungu: s.sigungu } }));
}

const sido = Astro.params.sido as SidoSlug;
const sigungu = Astro.params.sigungu!;
const st = statsFor(sido, sigungu);
const ks = kiosksIn(sido, sigungu).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const subGu = subGuOf(sido, sigungu);

// Group by 일반구 when the city has them, otherwise by 동. Kiosks with no 동 go last.
type Group = { key: string; title: string; items: Kiosk[] };
const groupKey = (k: Kiosk) => (subGu.length ? k.subGu : k.dong) ?? '기타';
const order = subGu.length ? [...subGu, '기타'] : Object.keys(st.byDong).concat('기타');
const groups: Group[] = order
  .map((key) => ({ key, title: key, items: ks.filter((k) => groupKey(k) === key) }))
  .filter((g) => g.items.length);
const dongs = Object.keys(st.byDong).sort((a, b) => a.localeCompare(b, 'ko'));
// 동 바로가기: 동 페이지가 있으면 그 페이지로, 없으면(동별로 묶인 경우) 이 페이지의 동 소제목으로
const dongLinks = dongs.map((d) => ({ d, n: st.byDong[d], page: dongPage(sido, sigungu, d) }))
  .filter((x) => x.page || !subGu.length)
  .map((x) => ({ ...x, href: x.page ? dongPath(sido, sigungu, x.d) : `#${encodeURIComponent(x.d)}` }));
const dongPageCount = dongPagesIn(sido, sigungu).length;
const AD_INFEED_AFTER = 3; // 인피드 광고: 3번째 카드 아래, 5곳 이상일 때만 (애드센스 설정 전에는 렌더 안 함)
let cardIndex = 0;

const faq = regionFaq(sido, sigungu);
const fallback = nearestOutside(sido, sigungu, () => true, 3);
const neighbours = nearbyRegions(sido, sigungu);
// 좌표가 없으면 nearbyRegions는 거리순이 아니라 같은 시·도의 다른 지역을 준다 → 제목도 그에 맞춘다.
const byDistance = ks.some((k) => k.lat !== null && k.lng !== null);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const title = regionPageTitle(st);
const crumbs = [
  ...MUIN_CRUMBS,
  { name: sidoShort(sido), href: regionPath(sido) },
  { name: st.sigunguName, href: regionPath(sido, sigungu) },
];
---
<BaseLayout
  tool="muin"
  canvas="white"
  title={title}
  description={regionDescription(st)}
  crumbs={crumbs}
  jsonld={[
    breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))),
    itemList(ks.map((k) => ({ name: k.name, url: abs(kioskPath(k)) }))),
    faqPage(faq),
  ]}
>
  <h1 class="text-title font-bold text-ink">{title}</h1>
  <p class="mt-1 text-cap text-ink-3">
    {sidoName(sido)} · 데이터 기준일 {st.latestBaseDate ?? '미상'}
  </p>
  <StatCards st={st} />
  <MapButton points={ks} />

  <FilterBar dongs={dongs} subGu={subGu} />
  {dongLinks.length > 1 && (
    <details class="mt-2">
      <summary class="inline-flex min-h-11 cursor-pointer items-center text-cap font-semibold text-brand">동별 바로가기 ({dongLinks.length}개 동{dongPageCount > 0 && ` · 동 페이지 ${dongPageCount}개`})</summary>
      <nav aria-label="동별 바로가기" class="mt-1 flex flex-wrap gap-2 pb-2">
        {dongLinks.map((x) => (
          <a href={x.href} class={`flex min-h-11 items-center gap-1 rounded-xl px-3 text-[length:calc(16px*var(--fs,1))] font-medium hover:text-brand ${x.page ? 'bg-brand-weak text-brand' : 'bg-bg text-ink-2'}`}>
            {x.d}<span class="text-ink-3">{x.n}</span>
          </a>
        ))}
      </nav>
      {dongPageCount > 0 && <p class="pb-2 text-cap text-ink-3">파란 칩은 기기가 많은 동의 별도 페이지예요.</p>}
    </details>
  )}

  <!-- 행 사이 구분선 없음: 상하 18px 여백만. 동(구) 묶음 사이는 32px. -->
  <div id="kiosk-list" class="mt-2 space-y-8">
    {groups.map((g) => (
      <section data-group={g.key} id={g.key} class="scroll-mt-32">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-[length:calc(17px*var(--fs,1))] font-bold text-ink-2">{g.key === '기타' ? '기타 지역' : g.title} 무인민원발급기 <span class="g-count font-medium text-ink-3">{g.items.length}곳</span></h2>
          {!subGu.length && dongPage(sido, sigungu, g.key) && <a href={dongPath(sido, sigungu, g.key)} class="-my-2 flex min-h-11 shrink-0 items-center text-cap font-semibold text-brand hover:underline">{g.title}만 보기 ›</a>}
        </div>
        <div>
          {g.items.map((k) => {
            cardIndex++;
            return (
              <>
                <KioskRow k={k} />
                {cardIndex === AD_INFEED_AFTER && ks.length >= 5 && <AdSlot name="B" variant="infeed" />}
              </>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <div id="empty-state" class="py-6" hidden>
    <p class="text-body font-semibold text-ink">조건에 맞는 곳이 {st.sigunguName}에 없어요.</p>
    <p class="mt-1 text-body text-ink-2">조건을 줄이거나, 다른 지역에서 찾아보세요.</p>
    <button type="button" id="reset-filters" class="mt-3 flex h-9 items-center gap-1 rounded-xl bg-brand px-3.5 text-[length:calc(16px*var(--fs,1))] font-semibold text-white hover:brightness-95">필터 초기화</button>
    {fallback.length > 0 && (
      <>
        <p class="mt-4 text-body text-ink-2">{byDistance ? '가까운 다른 지역의 무인민원발급기:' : '다른 지역의 무인민원발급기:'}</p>
        <ul class="mt-2 space-y-1 text-body">
          {fallback.map(({ k, m }) => (
            <li><a class="font-medium text-brand" href={kioskPath(k)}>{k.sigunguName} {k.name}</a> {m !== undefined && <span class="text-ink-3">약 {km(m)}</span>}</li>
          ))}
        </ul>
      </>
    )}
  </div>

  <div class="mt-8"><div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div></div>
  <section class="py-8 text-body text-ink-2">
    <h2 class="mb-3 text-h2 font-bold text-ink">{st.sigunguName} 무인민원발급기 이용 요약</h2>
    <ul class="list-disc space-y-1.5 pl-5 marker:text-ink-3">
      {regionUsageSummary(st, ks, stats).map((t) => <li>{t}</li>)}
    </ul>
    <p class="mt-3 text-cap text-ink-3">행정안전부 무인민원발급기 정보(데이터 기준일 {st.latestBaseDate ?? '미상'})를 집계했어요.</p>
  </section>

  <div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <section class="py-8 text-body text-ink-2">
    <h2 class="mb-2 flex items-center gap-1.5 text-h2 font-bold text-ink"><Icon name="info" size={18} class="text-brand" />이용 전 알아두세요</h2>
    <ul class="list-disc space-y-1 pl-5 marker:text-ink-3">
      <li>주민등록 등·초본, 가족관계증명서처럼 본인 확인이 필요한 서류는 주민등록증을 만들 때 등록한 지문으로 확인해요.</li>
      <li>등기부등본·가족관계증명서 같은 법원 발급 서류는 24시간 기기라도 평일 낮에만 발급되는 곳이 있어요.</li>
      <li>수수료는 서류마다 다르고 현금만 받는 기기가 있으니 현금을 준비하면 안전해요.</li>
      <li>시설 휴관·기기 점검 시간에는 이용할 수 없어요.</li>
    </ul>
  </section>

  <AdSlot name="C" />

  <div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <FaqSection flat title={`${st.sigunguName} 무인민원발급기 자주 묻는 질문`} items={faq} />

  {neighbours.length > 0 && (
    <div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
    <section class="py-8">
      <h2 class="mb-3 text-h2 font-bold text-ink">{byDistance ? '가까운 지역' : `${sidoShort(sido)}의 다른 지역`}</h2>
      <div class="flex flex-wrap gap-2">
        {neighbours.map((n) => (
          <a href={regionPath(n.sido, n.sigungu)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">
            {n.sigunguName} <span class="ml-1 text-ink-3">{n.total}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {REPORT_FORM.formId && <p class="pb-6 px-1 text-cap text-ink-3">정보가 실제와 다르면 각 기기 상세 페이지의 '정보 오류 제보'로 알려 주세요.</p>}
  <div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <GuideList flat limit={4} />
  {mapOn(ks) && <MapPanel slot="map" points={validPoints(ks).map(kioskPoint)} label={`${st.sigunguName} 무인민원발급기`} missing={ks.length - validPoints(ks).length} area={{ sido, sigungu }} />}
</BaseLayout>

<script>
  import { initFilters } from '../../../../scripts/filters.ts';
  import { initCopy } from '../../../../scripts/copy.ts';
  initFilters();
  initCopy();
</script>
