---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import KioskCard from '../../../../components/KioskCard.astro';
import FilterBar from '../../../../components/FilterBar.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import FaqSection from '../../../../components/FaqSection.astro';
import StatCards from '../../../../components/StatCards.astro';
import {
  stats, kiosksIn, statsFor, subGuOf, sidoName, sidoShort, regionPath, kioskPath, nearestOutside, nearbyRegions, MUIN_CRUMBS,
  type SidoSlug, type Kiosk,
} from '../../../../lib/data.ts';
import { regionFaq } from '../../../../lib/faq.ts';
import { regionPageTitle, regionDescription, regionSummary } from '../../../../lib/copy.ts';
import { faqPage, breadcrumb, itemList } from '../../../../lib/jsonld.ts';
import { km } from '../../../../lib/format.ts';
import GuideList from '../../../../components/GuideList.astro';

export function getStaticPaths() {
  return stats.map((s) => ({ params: { sido: s.sido, sigungu: s.sigungu } }));
}

const sido = Astro.params.sido as SidoSlug;
const sigungu = Astro.params.sigungu!;
const st = statsFor(sido, sigungu);
const ks = kiosksIn(sido, sigungu).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const subGu = subGuOf(sido, sigungu);

// Group by 일반구 when the city has them, otherwise by 동. Kiosks with no 동 go last.
type Group = { key: string; title: string; items: Kiosk[] };
const groupKey = (k: Kiosk) => (subGu.length ? k.subGu : k.dong) ?? '기타';
const order = subGu.length ? [...subGu, '기타'] : Object.keys(st.byDong).concat('기타');
const groups: Group[] = order
  .map((key) => ({ key, title: key, items: ks.filter((k) => groupKey(k) === key) }))
  .filter((g) => g.items.length);
const dongs = Object.keys(st.byDong).sort((a, b) => a.localeCompare(b, 'ko'));
const AD_B_AFTER = 5; // 광고 B: 6번째 카드 위치, 8곳 이상일 때만
let cardIndex = 0;

const faq = regionFaq(sido, sigungu);
const fallback = nearestOutside(sido, sigungu, () => true, 3);
const neighbours = nearbyRegions(sido, sigungu);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const title = regionPageTitle(st);
const crumbs = [
  ...MUIN_CRUMBS,
  { name: sidoShort(sido), href: regionPath(sido) },
  { name: st.sigunguName, href: regionPath(sido, sigungu) },
];
---
<BaseLayout
  tool="muin"
  title={title}
  description={regionDescription(st)}
  crumbs={crumbs}
  jsonld={[
    breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))),
    itemList(ks.map((k) => ({ name: k.name, url: abs(kioskPath(k)) }))),
    faqPage(faq),
  ]}
>
  <h1 class="text-xl font-bold leading-snug sm:text-2xl">{title}</h1>
  <p class="mt-1 text-xs text-slate-500">
    {sidoName(sido)} · 데이터 기준일 {st.latestBaseDate ?? '미상'} · 월 1~2회 갱신
  </p>
  <p class="mt-3 text-[15px] leading-relaxed text-slate-700">{regionSummary(st)}</p>
  <StatCards st={st} />

  <AdSlot name="A" />

  <FilterBar dongs={dongs} subGu={subGu} />

  <div id="kiosk-list" class="mt-4 space-y-8">
    {groups.map((g) => (
      <section data-group={g.key} id={g.key}>
        <h2 class="mb-3 text-lg font-bold">{g.title} <span class="text-sm font-normal text-slate-500">({g.items.length})</span></h2>
        <div class="space-y-3">
          {g.items.map((k) => {
            cardIndex++;
            return (
              <>
                <KioskCard k={k} />
                {cardIndex === AD_B_AFTER && ks.length >= 8 && <AdSlot name="B" />}
              </>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <div id="empty-state" class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white p-4" hidden>
    <p class="font-medium">조건에 맞는 곳이 {st.sigunguName}에 없습니다.</p>
    {fallback.length > 0 && (
      <>
        <p class="mt-1 text-sm text-slate-600">가까운 다른 지역의 무인민원발급기:</p>
        <ul class="mt-2 space-y-1 text-sm">
          {fallback.map(({ k, m }) => (
            <li><a class="text-brand underline" href={kioskPath(k)}>{k.sigunguName} {k.name}</a> {m !== undefined && <span class="text-slate-500">약 {km(m)}</span>}</li>
          ))}
        </ul>
      </>
    )}
  </div>

  <section class="mt-8 rounded-xl bg-white p-4 text-sm leading-relaxed text-slate-700">
    <h2 class="mb-2 text-lg font-bold text-slate-900">이용 전 알아두세요</h2>
    <ul class="list-disc space-y-1 pl-5">
      <li>주민등록 등·초본, 가족관계증명서처럼 본인 확인이 필요한 서류는 지문 인식으로 확인합니다.</li>
      <li>등기부등본·가족관계등록부 같은 대법원 서류는 24시간 기기라도 평일 낮에만 발급되는 곳이 있습니다.</li>
      <li>수수료는 서류마다 다르고 현금만 받는 기기가 있으니 현금을 준비하면 안전합니다.</li>
      <li>시설 휴관·기기 점검 시간에는 이용할 수 없습니다.</li>
    </ul>
  </section>

  <AdSlot name="C" />

  <FaqSection title={`${st.sigunguName} 무인민원발급기 자주 묻는 질문`} items={faq} />

  {neighbours.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-bold">가까운 지역</h2>
      <div class="flex flex-wrap gap-2">
        {neighbours.map((n) => (
          <a href={regionPath(n.sido, n.sigungu)} class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm hover:border-brand">
            {n.sigunguName} <span class="text-slate-500">({n.total})</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <p class="mt-8 text-xs text-slate-500">정보가 실제와 다르면 각 기기 상세 페이지의 '정보 오류 제보'로 알려 주세요.</p>
  <GuideList limit={4} />
</BaseLayout>

<script>
  import { initFilters } from '../../../../scripts/filters.ts';
  initFilters();
</script>
