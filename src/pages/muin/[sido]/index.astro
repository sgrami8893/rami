---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { SIDO_ORDER, regionsIn, sidoName, sidoShort, regionPath, subGuOf, MUIN_CRUMBS, type SidoSlug } from '../../../lib/data.ts';
import { sidoTitle, sidoDescription, sidoSummary } from '../../../lib/copy.ts';
import { kiosks } from '../../../lib/data.ts';
import { HUB_CONDS, HUB_LABEL, hubStats, hubPath } from '../../../lib/hubs.ts';
import GuideList from '../../../components/GuideList.astro';
import SidoChips from '../../../components/SidoChips.astro';
import { breadcrumb, itemList } from '../../../lib/jsonld.ts';

export function getStaticPaths() {
  return SIDO_ORDER.filter((s) => regionsIn(s).length).map((sido) => ({ params: { sido } }));
}
const sido = Astro.params.sido as SidoSlug;
const regions = regionsIn(sido).sort((a, b) => a.sigunguName.localeCompare(b.sigunguName, 'ko'));
const total = regions.reduce((a, r) => a + r.total, 0);
const sum = (f: (r: (typeof regions)[number]) => number) => regions.reduce((a, r) => a + f(r), 0);
const totals = { total, is24h: sum((r) => r.is24h), openWeekend: sum((r) => r.openWeekend), registry: sum((r) => r.docs.registry ?? 0) };
const title = sidoTitle(sido, totals);
const crumbs = [...MUIN_CRUMBS, { name: sidoShort(sido), href: regionPath(sido) }];
const abs = (p: string) => new URL(p, Astro.site).href;
const hubs = HUB_CONDS.map((c) => ({ c, ...hubStats(kiosks, sido, c) })).filter((h) => h.count > 0);
// 비교표: 전체 기기 수 많은 순
const table = [...regions].sort((a, b) => b.total - a.total);
const pctOf = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const cell = (r: (typeof regions)[number], f: string, v: number) => (v > 0 ? `${regionPath(r.sido, r.sigungu)}?f=${f}` : '');
---
<BaseLayout title={title} crumbs={crumbs} tool="muin"
  description={sidoDescription(sido, totals)}
  jsonld={[breadcrumb(crumbs.map((c) => ({ name: c.name, url: abs(c.href) }))), itemList(regions.map((r) => ({ name: r.sigunguName, url: abs(regionPath(r.sido, r.sigungu)) })))]}>
  <SidoChips current={sido} class="mb-4" />
  <h1 class="text-title font-bold text-ink">{sidoName(sido)} 무인민원발급기 {total.toLocaleString('ko-KR')}곳</h1>
  <div class="mt-3 rounded-2xl bg-bg p-5 text-body text-ink-2">
    {sidoSummary(sido, regions).map((t, i) => <p class={i ? 'mt-1.5' : ''}>{t}</p>)}
  </div>
  <nav aria-label="조건별 모아보기" class="mt-4 flex flex-wrap gap-2">
    {hubs.map((h) => (
      <a href={hubPath(sido, h.c)} class="flex h-9 items-center rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">
        {HUB_LABEL[h.c].chip} <span class="ml-1 text-ink-3">{h.count.toLocaleString('ko-KR')}</span>
      </a>
    ))}
  </nav>
  <AdSlot name="A" />
  <!-- 시·군·구 리스트(비교표의 핵심 숫자를 합친 카드): 행 56px 이상, 1px 구분선, PC 2열 -->
  <ul class="mt-4 grid sm:grid-cols-2 sm:gap-x-8">
    {regions.map((r) => (
      <li class="border-b border-line">
        <a href={regionPath(r.sido, r.sigungu)} class="group flex min-h-14 items-center gap-3 py-3">
          <span class="min-w-0 flex-1">
            <span class="block text-[length:calc(19px*var(--fs,1))] font-semibold leading-snug text-ink group-hover:text-brand">{r.sigunguName}{subGuOf(r.sido, r.sigungu).length > 0 && <span class="text-cap font-normal text-ink-3"> ({subGuOf(r.sido, r.sigungu).join('·')})</span>}</span>
            <span class="mt-0.5 block text-cap text-ink-3">24시간 {r.is24h}곳({pctOf(r.is24h, r.total)}%) · 주말·공휴일 {r.openWeekend} · 등기부 {r.docs.registry ?? 0}</span>
          </span>
          <span class="flex shrink-0 items-center gap-0.5 text-[length:calc(16px*var(--fs,1))] font-semibold text-ink-2">{r.total}곳<Icon name="chevron-right" size={18} class="text-ink-3" /></span>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-8"><div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div></div>
  <details class="group py-8">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
      <span><span class="block text-h2 font-bold text-ink">시·군·구 비교표 펼치기</span><span class="mt-0.5 block text-cap text-ink-3">{sidoShort(sido)} {regions.length}개 시·군·구의 24시간·주말·등기부·가족관계 기기 수</span></span>
      <Icon name="chevron-down" size={20} class="shrink-0 text-ink-3 transition-transform group-open:rotate-180" />
    </summary>
    <p class="mt-3 text-cap text-ink-3">기기 수가 많은 순이에요. 숫자를 누르면 그 조건으로 걸러 낸 목록으로 이동해요.</p>
    <div class="mt-3 -mx-5 overflow-x-auto px-5 lg:mx-0 lg:px-0">
      <table class="w-full min-w-[34rem] border-collapse text-[length:calc(16px*var(--fs,1))]">
        <thead>
          <tr class="border-b border-line text-left text-cap text-ink-3">
            <th scope="col" class="py-2 pr-2 font-semibold">시·군·구</th>
            <th scope="col" class="px-2 py-2 text-right font-semibold">전체</th>
            <th scope="col" class="px-2 py-2 text-right font-semibold">24시간</th>
            <th scope="col" class="px-2 py-2 text-right font-semibold">주말·공휴일</th>
            <th scope="col" class="px-2 py-2 text-right font-semibold">등기부</th>
            <th scope="col" class="py-2 pl-2 text-right font-semibold">가족관계</th>
          </tr>
        </thead>
        <tbody>
          {table.map((r) => {
            const cols: [string, number][] = [['24h', r.is24h], ['weekend', r.openWeekend], ['registry', r.docs.registry ?? 0], ['family', r.docs.family ?? 0]];
            return (
              <tr class="border-b border-line">
                <th scope="row" class="py-2.5 pr-2 text-left font-semibold text-ink"><a href={regionPath(r.sido, r.sigungu)} class="hover:text-brand">{r.sigunguName}</a></th>
                <td class="px-2 py-2.5 text-right tabular-nums text-ink">{r.total}</td>
                {cols.map(([f, v], i) => (
                  <td class={`${i === 3 ? 'pl-2' : 'px-2'} py-2.5 text-right tabular-nums text-ink-2`}>
                    {cell(r, f, v) ? <a href={cell(r, f, v)} class="font-medium text-brand">{v}</a> : <span class="text-ink-3">0</span>}
                    {f === '24h' && <span class="ml-1 text-cap text-ink-3">{pctOf(v, r.total)}%</span>}
                  </td>
                ))}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-cap text-ink-3">행정안전부 무인민원발급기 정보를 시·군·구별로 집계했어요. 주말·공휴일은 토요일이나 일요일에 운영하는 기기예요.</p>
  </details>
  <div class="band -mx-5 lg:mx-0 lg:rounded-lg" aria-hidden="true"></div>
  <GuideList flat limit={4} />
</BaseLayout>
