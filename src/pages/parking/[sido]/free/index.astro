---
import { parkingNav, PARKING_MAP_FILTERS as PF } from '../../../../lib/parking.ts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../components/parking/MockBanner.astro';
import LotMore from '../../../../components/parking/LotMore.astro';
import LotRow from '../../../../components/parking/LotRow.astro';
import LotFilters from '../../../../components/parking/LotFilters.astro';
import FreeNote from '../../../../components/parking/FreeNote.astro';
import MapView from '../../../../components/v2/MapView.astro';
import PlaceBar from '../../../../components/v2/PlaceBar.astro';
import { parkingPlace } from '../../../../lib/parking-view.ts';
import MapPill from '../../../../components/v2/MapPill.astro';
import { mapOn } from '../../../../lib/map.ts';
import { SIDOS, lots, sidoName, sidoShort, parkingPath, freePath, regionsOf, freeHubIndexable, toPoint, IS_MOCK, type ParkingLot } from '../../../../lib/parking.ts';
import { SIGUNGU, type SidoSlug } from '../../../../../scripts/lib/regions.ts';
export function getStaticPaths() { return SIDOS.map((sido) => ({ params: { sido } })); }
const sido = Astro.params.sido as SidoSlug;
if (SIGUNGU[sido].some((s) => s.slug === 'free')) throw new Error('free 경로가 시·군·구 slug와 겹침');
const st = freeHubIndexable(lots as ParkingLot[], sido);
const groups = regionsOf(sido).map((r) => ({ ...r, items: r.lots.filter((l) => l.fee.type === 'free') })).filter((g) => g.items.length);
const free = groups.flatMap((g) => g.items);
// 목록이 너무 길면(경기 1,300여 곳 → HTML 1.7MB) 모바일에서 무거워서 시·군·구 목록으로 대신한다
const LIST_MAX = 300;
const pts = free.filter((l) => l.lat !== null && l.lng !== null);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(sido), href: parkingPath(sido) }, { name: '무료', href: freePath(sido) }];
---
<BaseLayout tool="parking" title={`${sidoShort(sido)} 무료 공영주차장 ${st.count.toLocaleString("ko-KR")}곳 | 시·군·구별 위치`} description={`${sidoName(sido)} 무료 공영주차장 ${st.count.toLocaleString("ko-KR")}곳을 시·군·구별로 모았어요. 지금 운영시간 내인 곳만 골라 볼 수 있어요.`} crumbs={crumbs} noindex={IS_MOCK || !st.indexable}>
  <MockBanner />
  <PlaceBar levels={parkingPlace(sido)} />
  <h1 class="v-h1">{sidoShort(sido)} 무료 공영주차장 {st.count.toLocaleString("ko-KR")}곳</h1>
  <p class="mt-1 text-cap text-ink-3">{sidoName(sido)} 전체 {st.total.toLocaleString("ko-KR")}곳 중 {st.count.toLocaleString("ko-KR")}곳 · {st.regions}개 시·군·구</p>
  <FreeNote class="mt-3" />
  {free.length <= LIST_MAX && (
  <nav aria-label="시·군·구별 무료주차장" class="mt-4 flex flex-wrap gap-2">
    {groups.map((g) => <a href={`${parkingPath(sido, g.sigungu)}free/`} class="flex min-h-11 items-center gap-1 rounded-xl bg-bg px-3.5 text-[length:calc(16px*var(--fs,1))] font-semibold text-ink-2 hover:text-brand">{g.name}<span class="font-medium text-ink-3">{g.items.length}</span></a>)}
  </nav>
  )}
  <MapPill />
  {free.length <= LIST_MAX ? (
    <>
      <LotFilters total={free.length} free={false} sort={false} />
      <div id="lot-list" class="mt-1">
        {groups.map((g) => g.items.map((l) => <LotRow l={l} level={2} />))}
      </div>
  <LotMore />
    </>
  ) : (
    <section class="mt-5" aria-labelledby="sg-h">
      <h2 id="sg-h" class="text-h2 font-bold text-ink">시·군·구를 고르세요</h2>
      <p class="mt-1 text-cap text-ink-3">무료 주차장이 많아서 시·군·구별로 나눠 보여 드려요. 각 페이지에서 '지금 운영시간 내'로 거를 수 있어요.</p>
      <ul class="mt-2 grid sm:grid-cols-2 sm:gap-x-8">
        {groups.map((g) => (
          <li class="border-b border-line">
            <a href={`${parkingPath(sido, g.sigungu)}free/`} class="flex min-h-14 items-center justify-between gap-3 py-3 hover:text-brand">
              <span class="text-[length:calc(19px*var(--fs,1))] font-semibold text-ink">{g.name}</span>
              <span class="text-[length:calc(16px*var(--fs,1))] font-semibold text-ok">무료 {g.items.length}곳</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {mapOn(pts) && <MapView slot="map" kind="pins" points={pts.map(toPoint)} title={`${sidoShort(sido)} 무료 주차장 지도`} />}
</BaseLayout>

<script>
  import { initParkingList } from '../../../../scripts/parking-list.ts';
  initParkingList();
</script>
