---
import Near from '../../../components/v2/Near.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import MockBanner from '../../../components/parking/MockBanner.astro';
import MapView from '../../../components/v2/MapView.astro';
import PlaceBar from '../../../components/v2/PlaceBar.astro';
import { parkingPlace } from '../../../lib/parking-view.ts';
import MapPill from '../../../components/v2/MapPill.astro';
import { mapOn } from '../../../lib/map.ts';
import { SIDOS, sidoName, sidoShort, parkingPath, freePath, regionsOf, freeHubIndexable, lots, IS_MOCK, toPoint, parkingNav, PARKING_MAP_FILTERS, type ParkingLot } from '../../../lib/parking.ts';
import type { SidoSlug } from '../../../../scripts/lib/regions.ts';
export function getStaticPaths() { return SIDOS.map((sido) => ({ params: { sido } })); }
const sido = Astro.params.sido as SidoSlug;
const rs = regionsOf(sido);
const total = rs.reduce((a, r) => a + r.lots.length, 0);
const fh = freeHubIndexable(lots as ParkingLot[], sido);
// 시·도 지도(2026-11-26 '주차장도 전월세 지도와 같은 구성'): 좌표 있는 곳 전부, 묶음으로 보여 준다
const pts = rs.flatMap((r) => r.lots).filter((l) => l.lat !== null && l.lng !== null);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(sido), href: parkingPath(sido) }];
---
<BaseLayout tool="parking" title={`${sidoShort(sido)} 공영주차장 ${total.toLocaleString("ko-KR")}곳 | 시·군·구별 무료·유료`} description={`${sidoName(sido)} 공영주차장 ${total.toLocaleString("ko-KR")}곳(무료 ${fh.count.toLocaleString("ko-KR")}곳)을 시·군·구별로 찾아보세요. 요금, 운영시간, 2시간 주차 요금을 비교할 수 있어요.`} crumbs={crumbs} noindex={IS_MOCK}>
  <MockBanner />
  <PlaceBar levels={parkingPlace(sido)} />
  <h1 class="v-h1">{sidoName(sido)} 공영주차장 {total.toLocaleString("ko-KR")}곳</h1>
  <Near class="mt-2" />
  <div class="v-ans"><div class="v-ans-row">
    <div><p class="k">전체</p><p class="v">{total.toLocaleString("ko-KR")}<small>곳</small></p></div>
    <div><p class="k">무료</p><p class="v">{fh.count.toLocaleString("ko-KR")}<small>곳</small></p></div>
  </div><p class="note"><a class="underline" href={freePath(sido)}>무료 주차장만 모아 보기</a></p></div>
  {mapOn(pts) && <MapPill />}
  <h2 class="v-cap">시·군·구 {rs.length}곳</h2>
  <div class="v-list">
    {rs.map((r) => (
      <div class="v-row" data-key={r.sigungu}>
        <div class="t"><a class="n" href={parkingPath(sido, r.sigungu)}>{r.name}</a><span class="s">무료 {r.free}곳</span></div>
        <div class="val">{r.lots.length.toLocaleString("ko-KR")}<small>곳</small></div>
        <Icon name="chevron-right" size={18} class="chev" />
      </div>
    ))}
  </div>
  {mapOn(pts) && <MapView slot="map" kind="pins" points={pts.map(toPoint)} title={`${sidoShort(sido)} 공영주차장 지도`} />}
</BaseLayout>
