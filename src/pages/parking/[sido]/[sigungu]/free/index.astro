---
// 시·군·구 무료주차장 허브. 색인 기준: 무료 5곳 이상 + 무료 비율 85% 이하(scripts/lib/parking.ts freeSigunguIndexable). 기준 미달은 noindex.
import { parkingNav, PARKING_MAP_FILTERS as PF } from '../../../../../lib/parking.ts';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../../components/parking/MockBanner.astro';
import LotMore from '../../../../../components/parking/LotMore.astro';
import LotRow from '../../../../../components/parking/LotRow.astro';
import LotFilters from '../../../../../components/parking/LotFilters.astro';
import FreeNote from '../../../../../components/parking/FreeNote.astro';
import MapView from '../../../../../components/v2/MapView.astro';
import PlaceBar from '../../../../../components/v2/PlaceBar.astro';
import { parkingPlace } from '../../../../../lib/parking-view.ts';
import MapPill from '../../../../../components/v2/MapPill.astro';
import { mapOn } from '../../../../../lib/map.ts';
import { SIDOS, sidoShort, parkingPath, freePath, regionsOf, toPoint, IS_MOCK } from '../../../../../lib/parking.ts';
import { freeSigunguIndexable } from '../../../../../../scripts/lib/parking.ts';
import type { SidoSlug } from '../../../../../../scripts/lib/regions.ts';
export function getStaticPaths() {
  return SIDOS.flatMap((sido) => regionsOf(sido).filter((r) => r.free > 0).map((r) => ({ params: { sido, sigungu: r.sigungu }, props: { r } })));
}
const sido = Astro.params.sido as SidoSlug;
const { r } = Astro.props as { r: ReturnType<typeof regionsOf>[number] };
const st = freeSigunguIndexable(r.lots);
const free = r.lots.filter((l) => l.fee.type === 'free').sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const pts = free.filter((l) => l.lat !== null && l.lng !== null);
const base = parkingPath(sido, r.sigungu);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(sido), href: parkingPath(sido) }, { name: r.name, href: base }, { name: '무료', href: `${base}free/` }];
---
<BaseLayout tool="parking" title={`${r.name} 무료주차장 ${st.count}곳 | 위치·운영시간 (${sidoShort(sido)})`} description={`${sidoShort(sido)} ${r.name} 무료 공영주차장 ${st.count}곳의 위치와 운영시간이에요. 지금 운영시간 내인 곳만 골라 볼 수 있어요. 공공데이터 기준이라 현장 확인이 필요해요.`} crumbs={crumbs}
  noindex={IS_MOCK || !st.indexable}>
  <MockBanner />
  <PlaceBar levels={parkingPlace(sido, r.sigungu)} />
  <h1 class="v-h1">{r.name} 무료주차장 {st.count}곳</h1>
  <p class="mt-1 text-cap text-ink-3">{r.name} 공영주차장 {st.total}곳 중 무료 {st.count}곳</p>
  <FreeNote class="mt-3" />
  <MapPill />
  <LotFilters total={free.length} free={false} sort={false} />
  <div id="lot-list" class="mt-1">{free.map((l) => <LotRow l={l} level={2} />)}</div>
  <LotMore />
  <nav aria-label="관련 페이지" class="mt-8 flex flex-col gap-2">
    <a href={base} class="flex min-h-11 items-center rounded-xl bg-bg px-4 text-body font-semibold text-ink-2 hover:text-brand">{r.name} 공영주차장 전체 {st.total}곳 · 요금 비교</a>
    <a href={freePath(sido)} class="flex min-h-11 items-center rounded-xl bg-bg px-4 text-body font-semibold text-ink-2 hover:text-brand">{sidoShort(sido)} 무료주차장 전체</a>
  </nav>
  {mapOn(pts) && <MapView slot="map" kind="pins" points={pts.map(toPoint)} title={`${r.name} 무료주차장 지도`} />}
</BaseLayout>

<script>
  import { initParkingList } from '../../../../../scripts/parking-list.ts';
  initParkingList();
</script>
