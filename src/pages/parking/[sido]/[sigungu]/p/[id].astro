---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../../components/parking/MockBanner.astro';
import BottomActionBar from '../../../../../components/BottomActionBar.astro';
import MapView from '../../../../../components/v2/MapView.astro';
import MapPill from '../../../../../components/v2/MapPill.astro';
import PlaceBar from '../../../../../components/v2/PlaceBar.astro';
import { parkingPlace } from '../../../../../lib/parking-view.ts';
import { mapOn } from '../../../../../lib/map.ts';
import FeeCalculator from '../../../../../components/parking/FeeCalculator.astro';
import { lots, toPoint, sidoShort, parkingPath, sigunguName, lotIndexable, FEE_LABEL, LOT_TYPE, dayText, won, IS_MOCK, type ParkingLot } from '../../../../../lib/parking.ts';
export function getStaticPaths() { return lots.map((l) => ({ params: { sido: l.sido, sigungu: l.sigungu, id: l.id }, props: { l } })); }
const { l } = Astro.props as { l: ParkingLot };
const sgName = sigunguName(l.sido, l.sigungu);
// 상세도 지도 틀 안(v2): 같은 시·군·구 주차장 핀 + 이 곳을 크게
const near = lots.filter((x) => x.sido === l.sido && x.sigungu === l.sigungu && x.lat !== null && x.lng !== null);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(l.sido), href: parkingPath(l.sido) }, { name: sgName, href: parkingPath(l.sido, l.sigungu) }, { name: l.name, href: Astro.url.pathname }];
const rows: [string, string][] = [
  ['요금 구분', FEE_LABEL[l.fee.type]],
  ['기본', l.fee.baseMin !== null ? `${l.fee.baseMin}분 ${won(l.fee.baseFee)}` : '-'],
  ['추가', l.fee.unitMin !== null ? `${l.fee.unitMin}분마다 ${won(l.fee.unitFee)}` : '-'],
  ['1일 주차권', l.fee.dayPass ? won(l.fee.dayPass) + (l.dayPassHours ? ` (${/^\d+$/.test(l.dayPassHours) ? `${l.dayPassHours}시간 적용` : l.dayPassHours})` : '') : '-'], ['월 정기권', l.fee.monthly ? won(l.fee.monthly) : '-'],
  ['결제 방법', l.payment.join(', ') || '-'],
];
const desc = `${sgName} ${l.name}(${FEE_LABEL[l.fee.type]})의 평일 운영시간 ${dayText(l, 'weekday')}${l.spaces !== null ? `, 주차면 ${l.spaces}면` : ''}과 요금, 1~2시간 주차 요금 계산, 위치를 확인하세요. 공공데이터 기준이에요.`;
const info: [string, string][] = [
  ['운영 요일', l.days || '-'], ['부제 시행', l.oddEven || '-'], ['급지', l.grade ? `${l.grade}급지` : '-'],
  ['장애인 전용 구역', l.disabledSpots === null ? '정보 없음' : l.disabledSpots ? '있음' : '없음'],
];
---
<BaseLayout tool="parking" title={`${l.name} 주차장 요금·운영시간 - ${sgName}`} description={desc} crumbs={crumbs} noindex={IS_MOCK || !lotIndexable(l)}>
  <MockBanner />
  <PlaceBar levels={parkingPlace(l.sido, l.sigungu, l.dong)} />
  <p class="mt-3 text-cap font-semibold text-ink-3">{FEE_LABEL[l.fee.type]} · {l.kind === 'private' ? '민영 · ' : ''}{LOT_TYPE[l.lotType]}{l.spaces !== null && ` · ${l.spaces}면`}</p>
  <h1 class="v-h1 mt-1">{l.name}</h1>
  <p class="mt-2 text-body text-ink-2">{l.roadAddress || l.jibunAddress}</p>
  {l.flags.includes('feeConflict') && <p class="mt-3 rounded-xl bg-bg px-4 py-3 text-cap text-warn">원천 데이터의 요금 정보가 서로 맞지 않아 요금 구분을 '확인 필요'로 표시했어요. 관리기관에 확인해 주세요.</p>}
  <FeeCalculator l={l} />
  <section class="mt-6">
    <h2 class="text-h2 font-bold text-ink">운영시간</h2>
    <table class="mt-2 w-full text-[length:calc(17px*var(--fs,1))]"><tbody>
      {([['평일', 'weekday'], ['토요일', 'sat'], ['공휴일', 'holiday']] as const).map(([d, k]) => (
        <tr class="border-b border-line"><th scope="row" class="py-2.5 text-left font-semibold text-ink-2">{d}</th><td class="py-2.5 text-right text-ink">{dayText(l, k)}</td></tr>
      ))}
    </tbody></table>
    {!!l.ambiguousDays?.length && <p class="mt-2 text-cap text-ink-2">'확인 필요'는 원천 자료에 00:00~00:00으로 적혀 있는 날이에요. 24시간 운영인지, 운영(유료 징수)을 하지 않는 날인지 알 수 없어서 '지금 운영시간 내' 판정에서도 빼고 있어요. 관리기관에 확인해 주세요.</p>}
  </section>
  <section class="mt-6">
    <h2 class="text-h2 font-bold text-ink">요금</h2>
    <table class="mt-2 w-full text-[length:calc(17px*var(--fs,1))]"><tbody>
      {rows.map(([k, v]) => <tr class="border-b border-line"><th scope="row" class="py-2.5 text-left font-semibold text-ink-2">{k}</th><td class="py-2.5 text-right text-ink">{v}</td></tr>)}
    </tbody></table>
  </section>
  <section class="mt-6">
    <h2 class="text-h2 font-bold text-ink">이용 정보</h2>
    <table class="mt-2 w-full text-[length:calc(17px*var(--fs,1))]"><tbody>
      {info.map(([k, v]) => <tr class="border-b border-line"><th scope="row" class="py-2.5 text-left font-semibold text-ink-2">{k}</th><td class="py-2.5 text-right text-ink">{v}</td></tr>)}
    </tbody></table>
  </section>
  <section class="mt-6 text-body text-ink-2">
    <h2 class="text-h2 font-bold text-ink">관리기관</h2>
    <p class="mt-2">{l.agency || '정보 없음'}{l.phone && ` · ${l.phone}`}</p>
    <p class="mt-2 text-cap text-ink-3">데이터 기준일 {l.baseDate ?? '미상'}</p>
  </section>
  <MapPill />
  {mapOn(near) && l.lat !== null && <MapView slot="map" kind="pins" points={near.map(toPoint)} focusId={l.id} title={`${l.name} 주변 지도`} />}
  <BottomActionBar slot="bottom" name={l.name} address={l.roadAddress || l.jibunAddress} lat={l.lat} lng={l.lng} label="길찾기·주소 복사" />
</BaseLayout>

<script>
  import { initCopy } from '../../../../../scripts/copy.ts';
  initCopy();
</script>
