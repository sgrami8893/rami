---
import { parkingNav, PARKING_MAP_FILTERS as PF } from '../../../../lib/parking.ts';
import Near from '../../../../components/v2/Near.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../components/parking/MockBanner.astro';
import LotRow from '../../../../components/parking/LotRow.astro';
import LotFilters from '../../../../components/parking/LotFilters.astro';
import FreeNote from '../../../../components/parking/FreeNote.astro';
import LotMore from '../../../../components/parking/LotMore.astro';
import MapView from '../../../../components/v2/MapView.astro';
import PlaceBar from '../../../../components/v2/PlaceBar.astro';
import { parkingPlace } from '../../../../lib/parking-view.ts';
import MapPill from '../../../../components/v2/MapPill.astro';
import { mapOn } from '../../../../lib/map.ts';
import { MAP as MAP_CFG } from '../../../../config.ts';
import { SIDOS, sidoShort, parkingPath, regionsOf, regionIndexable, toPoint, IS_MOCK } from '../../../../lib/parking.ts';
import type { SidoSlug } from '../../../../../scripts/lib/regions.ts';
import { calcFee } from '../../../../../scripts/lib/parking-fee.ts';
import { parkingDongs } from '../../../../../scripts/lib/parking.ts';
import { lots as allLots } from '../../../../lib/parking.ts';
export function getStaticPaths() {
  return SIDOS.flatMap((sido) => regionsOf(sido).map((r) => ({ params: { sido, sigungu: r.sigungu }, props: { r } })));
}
const sido = Astro.params.sido as SidoSlug;
const { r } = Astro.props as { r: ReturnType<typeof regionsOf>[number] };
const ls = [...r.lots].sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const twoh = ls.map((l) => calcFee(l, 120)).filter((r) => r.status === 'ok').map((r) => (r as { amount: number }).amount).filter((v) => v > 0);
const freeN = ls.filter((l) => l.fee.type === 'free').length;
const w = (n: number) => `${n.toLocaleString('ko-KR')}원`;
const dongPages = new Set(parkingDongs(allLots).filter((d) => d.sido === sido && d.sigungu === r.sigungu).map((d) => d.dong));
const groupMap = new Map<string, typeof ls>();
for (const l of ls) groupMap.set(l.dong ?? '기타', [...(groupMap.get(l.dong ?? '기타') ?? []), l]);
const groups = [...groupMap].sort((a, b) => (a[0] === '기타' ? 1 : b[0] === '기타' ? -1 : b[1].length - a[1].length || a[0].localeCompare(b[0], 'ko')));
const dpath = (d: string) => `${parkingPath(sido, r.sigungu)}${encodeURIComponent(d)}/`;
const withCoords = ls.filter((l) => l.lat !== null && l.lng !== null);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(sido), href: parkingPath(sido) }, { name: r.name, href: parkingPath(sido, r.sigungu) }];
---
<BaseLayout tool="parking" title={`${r.name} 공영주차장 ${ls.length}곳 (무료 ${r.free}곳) | 위치·요금·운영시간`} description={`${sidoShort(sido)} ${r.name} 공영주차장 ${ls.length}곳(무료 ${r.free}곳)의 위치, 2시간 주차 요금 비교, 평일·주말 운영시간을 동별로 확인하세요.`} crumbs={crumbs}
  noindex={IS_MOCK || !regionIndexable(ls.length)}>
  <MockBanner />
  <PlaceBar levels={parkingPlace(sido, r.sigungu)} />
  <h1 class="v-h1">{r.name} 공영주차장 {ls.length}곳</h1>
  <Near class="mt-2" tool="parking" />
  <div class="v-ans"><div class="v-ans-row">
    <div><p class="k">전체</p><p class="v">{ls.length}<small>곳</small></p></div>
    <div><p class="k">무료</p><p class="v">{freeN}<small>곳</small></p></div>
    <div><p class="k">유료 2시간 최저</p><p class="v">{twoh.length ? w(Math.min(...twoh)) : '-'}</p></div>
  </div>{freeN > 0 && <p class="note"><a class="underline" href={`${parkingPath(sido, r.sigungu)}free/`}>무료 주차장 {freeN}곳만 보기</a></p>}</div>
  <FreeNote class="mt-2" />
  <MapPill />
  <LotFilters total={ls.length} />
  {groups.filter(([d]) => d !== '기타').length >= 3 && (
    <nav id="dong-jump" class="v-dongjump" aria-label="동으로 바로 가기">
      {groups.filter(([d]) => d !== '기타').map(([d, g]) => <a href={`#${d}`}>{d}<span>{g.length}</span></a>)}
    </nav>
  )}
  <button type="button" class="v-dongjump-more" aria-expanded="false" aria-controls="dong-jump" hidden>동 모두 보기</button>
  <div id="lot-list" class="mt-2 space-y-6">
    {groups.map(([d, g]) => (
      <section class="lot-group scroll-mt-20" id={d}>
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="v-cap !m-0">{d === '기타' ? '기타 지역' : d} 공영주차장 <span class="g-count font-medium text-ink-3">{g.length}곳</span></h2>
          {dongPages.has(d) && <a href={dpath(d)} class="-my-2 flex min-h-11 shrink-0 items-center text-cap font-semibold text-ink-2 underline">{d}만 보기 ›</a>}
        </div>
        <div data-lots>{g.map((l) => <LotRow l={l} />)}</div>
      </section>
    ))}
  </div>
  <LotMore />
  {MAP_CFG.enabled && <MapView slot="map" kind="pins" points={withCoords.map(toPoint)} emptyNote="이 지역 주차장은 공공데이터에 좌표가 없어 지도에 핀을 찍지 못했어요. 목록의 주소로 확인하거나 '내 주변 보기'로 가까운 곳을 찾아보세요." title={`${r.name} 공영주차장 지도`} area={{ sido, slug: r.sigungu }} />}
</BaseLayout>

<script>
  import { initParkingList } from '../../../../scripts/parking-list.ts';
  initParkingList();
</script>
