---
// 주차장 동 페이지: 같은 동 5곳 이상·시·군·구의 85% 이하(scripts/lib/parking.ts parkingDongs)
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import MockBanner from '../../../../../components/parking/MockBanner.astro';
import LotMore from '../../../../../components/parking/LotMore.astro';
import LotRow from '../../../../../components/parking/LotRow.astro';
import LotFilters from '../../../../../components/parking/LotFilters.astro';
import FreeNote from '../../../../../components/parking/FreeNote.astro';
import MapPanel from '../../../../../components/MapPanel.astro';
import MapButton from '../../../../../components/MapButton.astro';
import { mapOn } from '../../../../../lib/map.ts';
import { lots, sidoShort, parkingPath, toPoint, IS_MOCK } from '../../../../../lib/parking.ts';
import { parkingDongs, type ParkingLot } from '../../../../../../scripts/lib/parking.ts';
import { calcFee } from '../../../../../../scripts/lib/parking-fee.ts';
import type { SidoSlug } from '../../../../../../scripts/lib/regions.ts';
export function getStaticPaths() {
  return parkingDongs(lots).map((d) => ({ params: { sido: d.sido, sigungu: d.sigungu, dong: d.dong }, props: { d } }));
}
const { d } = Astro.props as { d: { sido: SidoSlug; sigungu: string; sigunguName: string; dong: string; lots: ParkingLot[] } };
const ls = [...d.lots].sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const free = ls.filter((l) => l.fee.type === 'free').length;
const twoh = ls.map((l) => calcFee(l, 120)).filter((r) => r.status === 'ok').map((r) => (r as { amount: number }).amount);
const w = (n: number) => `${n.toLocaleString('ko-KR')}원`;
const pts = ls.filter((l) => l.lat !== null && l.lng !== null);
const base = parkingPath(d.sido, d.sigungu);
const self = `${base}${encodeURIComponent(d.dong)}/`;
const others = parkingDongs(lots).filter((x) => x.sido === d.sido && x.sigungu === d.sigungu && x.dong !== d.dong);
const crumbs = [{ name: '홈', href: '/' }, { name: '공영주차장', href: '/parking/' }, { name: sidoShort(d.sido), href: parkingPath(d.sido) }, { name: d.sigunguName, href: base }, { name: d.dong, href: self }];
---
<BaseLayout tool="parking" title={`${d.sigunguName} ${d.dong} 공영주차장 ${ls.length}곳 (무료 ${free}곳) | 요금·운영시간`} description={`${d.sigunguName} ${d.dong} 공영주차장 ${ls.length}곳(무료 ${free}곳)의 요금, 2시간 주차 요금 비교, 운영시간을 한눈에 보세요.`} crumbs={crumbs} noindex={IS_MOCK} canvas="white" sidebar={false}>
  <MockBanner />
  <h1 class="text-title font-bold text-ink">{d.sigunguName} {d.dong} 공영주차장 {ls.length}곳</h1>
  <p class="mt-1 text-cap text-ink-3">무료 {free}곳 · 2시간 요금 {twoh.length ? `${w(Math.min(...twoh))} ~ ${w(Math.max(...twoh))}` : '계산 가능한 요금 없음'} · 주소의 법정동 기준이에요</p>
  {free > 0 && <FreeNote class="mt-3" />}
  <MapButton points={pts} />
  <LotFilters total={ls.length} />
  <div id="lot-list" class="mt-1">{ls.map((l) => <LotRow l={l} level={2} />)}</div>
  <LotMore />
  <nav aria-labelledby="more-h" class="mt-8">
    <h2 id="more-h" class="text-h2 font-bold text-ink">더 찾아보기</h2>
    <a href={base} class="mt-3 flex min-h-11 items-center rounded-xl bg-bg px-4 text-body font-semibold text-ink-2 hover:text-brand">{d.sigunguName} 공영주차장 전체 보기</a>
    {others.length > 0 && <div class="mt-3 flex flex-wrap gap-2">{others.map((o) => <a href={`${base}${encodeURIComponent(o.dong)}/`} class="flex min-h-11 items-center gap-1 rounded-xl bg-bg px-3 text-[length:calc(16px*var(--fs,1))] font-medium text-ink-2 hover:text-brand">{o.dong}<span class="text-ink-3">{o.lots.length}</span></a>)}</div>}
  </nav>
  {mapOn(pts) && <MapPanel slot="map" points={pts.map(toPoint)} label={`${d.dong} 공영주차장`} missing={ls.length - pts.length} area={{ sido: d.sido, sigungu: d.sigungu, dong: d.dong }} />}
</BaseLayout>

<script>
  import { initParkingList } from '../../../../../scripts/parking-list.ts';
  initParkingList();
</script>
