---
import '../styles/global.css';
import { SITE_NAME, ADSENSE, DATA_SOURCES, TOOLS, NOINDEX_ALL, type ToolSlug } from '../config.ts';
import Breadcrumb from '../components/Breadcrumb.astro';
import { kiosks } from '../lib/data.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
  crumbs?: { name: string; href: string }[];
  wide?: boolean;
  /** 도구 페이지면 그 도구의 하위 메뉴·출처를 보여 준다. 허브 공통 페이지는 생략. */
  tool?: ToolSlug;
}
const { title, description, noindex = false, jsonld = [], crumbs = [], wide = false, tool } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title; // 템플릿이 이미 완결된 제목이라 사이트명을 붙이지 않음
const muinDate = kiosks.map((k) => k.baseDate).filter(Boolean).sort().at(-1) ?? '미상';
// 출처: 도구 페이지는 그 도구의 출처만, 허브 공통 페이지는 운영 중인 도구 전체의 출처를 표기
const sources = (tool ? [tool] : TOOLS.filter((t) => t.status === 'live').map((t) => t.slug))
  .map((s) => ({ ...DATA_SOURCES[s], date: s === 'muin' ? muinDate : '미상' }))
  .filter((s) => s.name);
const toolInfo = tool ? TOOLS.find((t) => t.slug === tool) : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || NOINDEX_ALL) && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {ADSENSE.client && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous" />
    )}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a href="/" class="font-bold text-brand">{SITE_NAME}</a>
        {tool === 'muin' ? (
          <nav class="flex items-center gap-3 text-sm text-slate-600">
            <a href="/muin/" class="font-medium text-slate-800 hover:text-brand">무인발급기</a>
            <a href="/muin/seoul/" class="hover:text-brand">서울</a>
            <a href="/muin/gyeonggi/" class="hover:text-brand">경기</a>
            <a href="/muin/incheon/" class="hover:text-brand">인천</a>
          </nav>
        ) : (
          <nav class="flex gap-3 text-sm text-slate-600">
            {TOOLS.filter((t) => t.status === 'live').map((t) => <a href={t.path} class="hover:text-brand">{t.name}</a>)}
          </nav>
        )}
      </div>
    </header>
    <main class={`mx-auto px-4 pb-16 pt-4 ${wide ? 'max-w-5xl' : 'max-w-3xl'}`}>
      {crumbs.length > 0 && <Breadcrumb items={crumbs} />}
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl space-y-2 px-4 py-8 text-xs leading-relaxed text-slate-500">
        <p class="font-medium text-slate-600">본 사이트는 정부·지자체 공식 사이트가 아닌 민간 정보 제공 서비스입니다.</p>
        {sources.map((s) => (
          <p>출처: <a href={s.url} class="underline" rel="noopener" target="_blank">{s.name}</a>(기준일 {s.date}). 공공데이터를 가공해 제공합니다.</p>
        ))}
        {toolInfo?.slug === 'muin' && <p>운영시간과 발급 서류는 현장 사정에 따라 다를 수 있습니다. 중요한 방문 전에는 관리기관에 확인하세요.</p>}
        <p class="flex gap-3"><a href="/about/" class="underline">소개</a><a href="/privacy/" class="underline">개인정보처리방침</a><a href="/contact/" class="underline">문의</a></p>
      </div>
    </footer>
  </body>
</html>
