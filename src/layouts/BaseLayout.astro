---
import Icon from '../components/Icon.astro';
import '../styles/fonts/pretendard/pretendard.css'; // Pretendard Variable 동적 서브셋(OFL), 자체 호스팅
import '../styles/global.css';
// 가장 자주 쓰는 글자(라틴 + 상위 한글) 서브셋 1개만 미리 받는다. 나머지는 unicode-range로 필요할 때만.
import fontPreload from '../styles/fonts/pretendard/PretendardVariable.subset.91.woff2?url';
import { SITE_NAME, ADSENSE, DATA_SOURCES, TOOLS, NOINDEX_ALL, SITE_VERIFICATION, type ToolSlug } from '../config.ts';
import Breadcrumb from '../components/Breadcrumb.astro';
import Logo from '../components/Logo.astro';
import FontSizeMenu from '../components/FontSizeMenu.astro';
import Sidebar from '../components/Sidebar.astro';
import { kiosks } from '../lib/data.ts';
import { PARKING_DATE } from '../lib/parking.ts';
import { RENT_SOURCES, HAS_PAGES as RENT_HAS_PAGES } from '../lib/rent.ts';
import { safeJsonLd } from '../lib/jsonld.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
  crumbs?: { name: string; href: string }[];
  wide?: boolean;
  /** 도구 페이지면 그 도구의 하위 메뉴·출처를 보여 준다. 허브 공통 페이지는 생략. */
  tool?: ToolSlug;
  /** PC(1024px+)에서 본문 740px + 사이드바 300px 2단. 기본: 도구 페이지에서 켬. */
  sidebar?: boolean;
  /** 'white': 순백 캔버스(3차 개편 페이지). 섹션은 .band 띠로 나누고, PC 사이드바는 옅은 회색 + 세로 구분선. */
  canvas?: 'gray' | 'white';
  /** 푸터 출처를 직접 지정(출처가 여러 개인 도구, 예: /rent/ 국토부 자료 2종) */
  sources?: { name: string; url: string; label: string; date: string }[];
}
const { title, description, noindex = false, jsonld = [], crumbs = [], wide = false, tool } = Astro.props;
const sidebar = Astro.props.sidebar ?? Boolean(tool);
const white = (Astro.props.canvas ?? 'white') === 'white'; // 3차 개편: 전 페이지 순백 캔버스
const frame = sidebar ? 'max-w-2xl lg:max-w-[1072px]' : wide ? 'max-w-5xl' : 'max-w-2xl';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title; // 템플릿이 이미 완결된 제목이라 사이트명을 붙이지 않음
const muinDate = kiosks.map((k) => k.baseDate).filter(Boolean).sort().at(-1) ?? '미상';
// 출처: 도구 페이지는 그 도구의 출처만, 허브 공통 페이지는 운영 중인 도구 전체의 출처를 표기
const sources = (tool ? [tool] : TOOLS.filter((t) => t.status === 'live').map((t) => t.slug))
  .flatMap((s) => s === 'rent' ? (RENT_HAS_PAGES ? RENT_SOURCES : []) : [{ ...DATA_SOURCES[s], label: s === 'parking' ? '수집일' : '기준일', date: s === 'muin' ? muinDate : s === 'parking' ? (PARKING_DATE ?? '미상') : '미상' }])
  .filter((s) => s.name);
if (Astro.props.sources) sources.splice(0, sources.length, ...Astro.props.sources);
const toolInfo = tool ? TOOLS.find((t) => t.slug === tool) : undefined;
const TOOL_SHORT: Record<string, string> = { muin: '무인발급기', parking: '주차장', rent: '전월세', waste: '대형폐기물', cert: '자격시험' };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <!-- 글자 크기 선택값을 첫 그리기 전에 적용(깜빡임 방지). 이 브라우저 localStorage에만 있음 -->
    <script is:inline>try{var f=localStorage.getItem('dnkk:fs:v1');if(f==='l'||f==='xl')document.documentElement.dataset.fs=f}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || NOINDEX_ALL) && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} 가이드`} href="/rss.xml" />
    {Astro.url.pathname === '/' && SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
    {Astro.url.pathname === '/' && SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}
    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content={white ? '#FFFFFF' : '#F3F5F8'} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={safeJsonLd(j)} />)}
    {ADSENSE.client && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous" />
    )}
  </head>
  <body class={`min-h-screen text-ink antialiased ${white ? 'bg-card' : 'bg-bg'}`}>
    <a href="#main" class="sr-only z-50 rounded-xl bg-ink px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:left-3 focus:top-3">본문 바로가기</a>
    <header class="sticky top-0 z-30 bg-card/95 backdrop-blur">
      <div class={`mx-auto flex h-14 items-center gap-2 px-4 ${frame}`}>
        <!-- 360px 미만(320px 확대 화면 포함)에서는 메뉴가 넘치지 않게 로고 글자를 화면에서만 숨긴다(링크 이름은 남음) -->
        <a href="/" class="flex min-h-11 items-center gap-1.5 text-[20px] font-extrabold tracking-tight text-ink"><Logo size={26} class="text-brand" /><span class="max-[359px]:sr-only">{SITE_NAME}</span></a>
        <!-- 헤더는 도구 카테고리만(2026-11-25 UI 검수 합의). 시·도 전환은 각 도구 본문의 칩 바에서 -->
        <nav aria-label="주요 메뉴" class="ml-auto flex items-center gap-3 text-[16px] font-medium text-ink-2">
          {TOOLS.filter((t) => t.status === 'live').map((t) => (
            <a href={t.path} class={`flex min-h-11 min-w-11 items-center justify-center ${tool === t.slug ? 'text-ink hover:text-brand' : 'hover:text-brand'}`} aria-current={tool === t.slug ? 'true' : undefined}>{TOOL_SHORT[t.slug] ?? t.name}</a>
          ))}
          <!-- 375px에서 도구 3개 + 검색 + 글자 크기가 넘쳐서(32px) 모바일에서는 검색 아이콘을 뺀다. 검색은 로고(홈) 첫 화면에 있음 -->
          <a href="/#search" class="hidden h-11 w-11 items-center justify-center rounded-xl text-ink hover:bg-bg sm:flex" aria-label="지역 검색"><Icon name="search" size={22} /></a>
        </nav>
        <FontSizeMenu />
      </div>
    </header>
    <div class={`mx-auto pb-16 pt-4 ${white ? 'px-5' : 'px-4'} ${frame} ${sidebar ? `lg:grid lg:grid-cols-[minmax(0,740px)_300px] lg:justify-between ${white ? 'lg:gap-0' : 'lg:gap-8'}` : ''}`}>
      <main id="main" tabindex="-1" class={`min-w-0 focus:outline-none ${white && sidebar ? 'lg:pr-8' : ''}`}>
        {crumbs.length > 0 && <Breadcrumb items={crumbs} />}
        <slot />
      </main>
      {sidebar && <Sidebar flat={white} />}
    </div>
    <footer class="bg-ink">
      <div class={`mx-auto space-y-2 px-4 py-8 text-cap text-white/70 ${frame}`}>
        <p class="font-semibold text-white">동네콕콕은 정부·지자체 공식 사이트가 아닌 민간 정보 서비스예요.</p>
        {sources.map((s) => (
          <p>출처: <a href={s.url} class="underline" rel="noopener noreferrer" target="_blank">{s.name}</a>({s.label} {s.date}). 공공데이터를 가공해 제공해요.</p>
        ))}
        {toolInfo?.slug === 'muin' && <p>운영시간과 발급 서류는 현장 사정에 따라 다를 수 있어요. 중요한 방문 전에는 기기 상세의 관리기관 안내 페이지 등에서 다시 확인하세요.</p>}
        <p class="flex flex-wrap gap-x-4 pt-1 text-white/85"><a href="/about/" class="inline-flex min-h-11 items-center hover:underline">소개</a><a href="/privacy/" class="inline-flex min-h-11 items-center font-semibold hover:underline">개인정보처리방침</a><a href="/contact/" class="inline-flex min-h-11 items-center hover:underline">문의</a><a href="/about/#licenses" class="inline-flex min-h-11 items-center hover:underline">오픈소스 라이선스</a></p>
      </div>
    </footer>
    <slot name="bottom" />
  </body>
</html>
