---
// 사이트 공통 틀 v2(2026-11-26 사용자·제미나이 합의 'UX 처음부터 다시').
// - 머리말 한 줄: 로고 · 도구 탭(전월세·주차장·발급기, 메인인 전월세가 먼저) · 검색(검색 시트 안에 글자 크기).
// - 'map' 슬롯을 채운 찾는 화면: PC(1024px+) 왼쪽 420px 패널(본문 전부, 패널만 스크롤) + 오른쪽 큰 지도. 상세 화면도 같은 틀.
//   모바일은 본문 한 줄 흐름 + 화면 아래 가운데 '지도' 알약(MapPill) → 전체 화면 지도.
// - 지도 없는 화면(가이드·소개 등)은 한 단(680px).
// - 위치 줄(PlaceBar)이 빵부스러기를 대신한다. crumbs는 검색엔진용 BreadcrumbList(JSON-LD)로만 쓴다.
import Icon from '../components/Icon.astro';
import '../styles/fonts/pretendard/pretendard.css'; // Pretendard Variable 동적 서브셋(OFL), 자체 호스팅
import '../styles/global.css';
import fontPreload from '../styles/fonts/pretendard/PretendardVariable.subset.91.woff2?url';
import { MAP, SITE_NAME, SITE_URL, ADSENSE, DATA_SOURCES, TOOLS, NOINDEX_ALL, SITE_VERIFICATION, type ToolSlug } from '../config.ts';
import Logo from '../components/Logo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchSheet from '../components/v2/SearchSheet.astro';
import { kiosks } from '../lib/data.ts';
import { PARKING_DATE } from '../lib/parking.ts';
import { RENT_SOURCES, HAS_PAGES as RENT_HAS_PAGES } from '../lib/rent.ts';
import { safeJsonLd } from '../lib/jsonld.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
  crumbs?: { name: string; href: string }[];
  /** 도구 페이지면 머리말에서 그 도구를 표시하고 바닥글 출처를 그 도구 것으로 */
  tool?: ToolSlug;
  /** 바닥글 출처를 직접 지정(출처가 여러 개인 도구) */
  sources?: { name: string; url: string; label: string; date: string }[];
  /** 지도 없는 화면에서 본문 폭을 넓게(표가 있는 소개 등) */
  wide?: boolean;
  /** 옛 페이지 호환(무시) */
  sidebar?: boolean; canvas?: 'gray' | 'white';
}
const { title, description, noindex = false, jsonld = [], crumbs = [], wide = false, tool } = Astro.props;
const split = Astro.slots.has('map');
const tileOrigin = split && MAP.enabled && MAP.url.startsWith('https://') ? new URL(MAP.url.replace(/\{[^}]+\}/g, '0')).origin : null;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const muinDate = kiosks.map((k) => k.baseDate).filter(Boolean).sort().at(-1) ?? '미상';
const sources = (tool ? [tool] : TOOLS.filter((t) => t.status === 'live').map((t) => t.slug).sort((a, b) => ['rent', 'parking', 'muin'].indexOf(a) - ['rent', 'parking', 'muin'].indexOf(b)))
  .flatMap((s) => s === 'rent' ? (RENT_HAS_PAGES ? RENT_SOURCES : []) : [{ ...DATA_SOURCES[s], label: s === 'parking' ? '수집일' : '기준일', date: s === 'muin' ? muinDate : s === 'parking' ? (PARKING_DATE ?? '미상') : '미상' }])
  .filter((s) => s.name);
if (Astro.props.sources) sources.splice(0, sources.length, ...Astro.props.sources);
// 도구 탭: 메인인 전월세가 먼저(2026-11-26 합의)
const ORDER = ['rent', 'parking', 'muin'];
const SHORT: Record<string, string> = { muin: '발급기', parking: '주차장', rent: '전월세' };
const liveTools = TOOLS.filter((t) => t.status === 'live').sort((a, b) => ORDER.indexOf(a.slug) - ORDER.indexOf(b.slug));
const crumbLd = crumbs.length > 1 ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE_URL).href })) }] : [];
---
<!doctype html>
<html lang="ko" class={split ? 'app-split' : undefined} data-tool={tool ?? ''}>
  <head>
    <meta charset="utf-8" />
    <!-- 첫 그리기 전에 이 브라우저에 저장된 선택(글자 크기, 전월세 유형·전세/월세)을 적용(깜빡임 방지). localStorage에만 있음 -->
    <script is:inline>try{var d=document.documentElement,f=localStorage.getItem('dnkk:fs:v1');if(f==='l'||f==='xl')d.dataset.fs=f;var r=localStorage.getItem('dnkk:rm:v1');if(r&&/^[vo][jw]$/.test(r)){d.dataset.rt=r[0];d.dataset.rk=r[1]}}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {tileOrigin && <link rel="preconnect" href={tileOrigin} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || NOINDEX_ALL) && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} 가이드`} href="/rss.xml" />
    {Astro.url.pathname === '/' && SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
    {Astro.url.pathname === '/' && SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}
    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FFFFFF" />
    {[...jsonld, ...crumbLd].map((j) => <script type="application/ld+json" set:html={safeJsonLd(j)} />)}
    {ADSENSE.client && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`} crossorigin="anonymous" />
    )}
  </head>
  <body class="min-h-screen bg-card text-ink antialiased">
    <a href="#main" class="sr-only z-[90] rounded-xl bg-ink px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:left-3 focus:top-3">본문 바로가기</a>
    <header class="v-hd">
      <a href="/" class="v-logo" aria-label={`${SITE_NAME} 처음으로`}><Logo size={28} /><span class="wm">동네<b>콕콕</b></span></a>
      <nav aria-label="도구" class="v-tools">
        {liveTools.map((t) => <a href={t.path} aria-current={tool === t.slug ? 'page' : undefined}>{SHORT[t.slug] ?? t.name}</a>)}
      </nav>
      <button type="button" class="v-hsearch" data-sheet-open aria-haspopup="dialog"><Icon name="search" size={18} />동네·지역 이름으로 찾기</button>
      <button type="button" class="v-hbtn s" data-sheet-open aria-haspopup="dialog" aria-label="검색·글자 크기"><Icon name="search" size={22} /></button>
    </header>
    {split ? (
    <div class="split-shell lg:grid lg:grid-cols-[420px_minmax(0,1fr)]">
      <main id="main" tabindex="-1" class="split-main min-w-0 px-5 pb-6 pt-4 tabular-nums focus:outline-none lg:border-r lg:border-line lg:px-6 lg:pt-5">
        <slot />
        <SiteFooter sources={sources} muin={tool === 'muin'} />
        <div class="v-pill-space" aria-hidden="true"></div>
      </main>
      <slot name="map" />
    </div>
    ) : (
    <div class={`mx-auto px-5 pb-10 pt-4 ${wide ? 'max-w-4xl' : 'max-w-[680px]'}`}>
      <main id="main" tabindex="-1" class="min-w-0 focus:outline-none">
        <slot />
      </main>
      <SiteFooter sources={sources} muin={tool === 'muin'} />
    </div>
    )}
    <slot name="bottom" />
    <SearchSheet tool={tool} />
  </body>
</html>
